{
  "name": "dealdoor",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "dev": "bunx astro dev",
    "dev:host": "bunx astro dev --host",
    "build": "bunx astro build",
    "build:pg": "node scripts/db-build-postgres-runtime.cjs",
    "start": "bun dist/server/entry.mjs",
    "preview": "bunx astro preview",
    "astro": "bunx astro",
    "db:generate": "bunx drizzle-kit generate",
    "db:generate:pg": "bunx drizzle-kit generate --config drizzle.pg.config.ts",
    "db:migrate": "bunx drizzle-kit migrate",
    "db:migrate:pg": "bunx drizzle-kit migrate --config drizzle.pg.config.ts",
    "db:push": "bunx drizzle-kit push",
    "db:check": "node scripts/db-check-schema.cjs",
    "db:check:boundary": "node scripts/db-check-runtime-schema-boundary.cjs",
    "db:check:portability": "node scripts/db-check-runtime-portability.cjs",
    "db:check:pg": "bun run db:migrate:pg && bun run db:verify:pg",
    "db:verify:pg": "node scripts/db-verify-postgres-schema.cjs",
    "db:pg:up": "docker compose -f docker-compose.pg.yml up -d",
    "db:pg:down": "docker compose -f docker-compose.pg.yml down",
    "db:pg:logs": "docker compose -f docker-compose.pg.yml logs -f postgres",
    "db:export:sqlite": "node scripts/db-export-sqlite.cjs",
    "db:import:pg": "node scripts/db-import-postgres.cjs",
    "db:import:pg:truncate": "node scripts/db-import-postgres.cjs --truncate",
    "db:smoke:pg": "bun run scripts/db-smoke-postgres-runtime.ts",
    "smoke:pg:app": "node scripts/smoke-postgres-app.cjs",
    "db:baseline": "node scripts/db-baseline-existing.cjs",
    "db:seed": "bun run db/seed.ts",
    "db:audit:identity": "node node_modules/tsx/dist/cli.mjs scripts/db-audit-identity.ts",
    "i18n:audit": "bun run scripts/i18n-audit.ts",
    "notifications:scan": "node node_modules/tsx/dist/cli.mjs scripts/notifications-scan.ts",
    "db:studio": "bunx drizzle-kit studio",
    "db:studio:pg": "bunx drizzle-kit studio --config drizzle.pg.config.ts",
    "db:reset": "if (Test-Path db/dev.db) { Remove-Item db/dev.db }; bun run db:push; bun run db:seed",
    "test": "bunx vitest run",
    "test:watch": "bunx vitest",
    "deploy": "bash scripts/deploy.sh",
    "backup": "bash scripts/backup.sh",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop dealdoor",
    "pm2:restart": "pm2 restart dealdoor",
    "pm2:status": "pm2 status",
    "pm2:logs": "pm2 logs dealdoor",
    "docker:build": "docker build -t dealdoor .",
    "docker:run": "docker run -p 4321:4321 -v ./db:/app/db dealdoor",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "dependencies": {
    "@astrojs/node": "^11.0.0",
    "@astrojs/react": "^6.0.0",
    "@aws-sdk/client-s3": "^3.1084.0",
    "@noble/hashes": "^2.2.0",
    "@node-rs/argon2": "^2.0.2",
    "@oslojs/crypto": "^1.0.1",
    "@oslojs/encoding": "^1.1.0",
    "@paralleldrive/cuid2": "^3.3.0",
    "@tailwindcss/vite": "^4.3.2",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "astro": "^7.0.4",
    "better-sqlite3": "^12.11.1",
    "chart.js": "^4.5.1",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.2",
    "tailwindcss": "^4.3.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/sharp": "^0.32.0",
    "drizzle-kit": "^0.31.10",
    "vitest": "^4.1.9"
  }
}

{
  "name": "dealdoor",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "dev": "bunx astro dev",
    "dev:host": "bunx astro dev --host",
    "build": "bunx astro build",
    "start": "bun dist/server/entry.mjs",
    "preview": "bunx astro preview",
    "astro": "bunx astro",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate": "bunx drizzle-kit migrate",
    "db:push": "bunx drizzle-kit push",
    "db:seed": "bun run db/seed.ts",
    "db:studio": "bunx drizzle-kit studio",
    "db:reset": "if (Test-Path db/dev.db) { Remove-Item db/dev.db }; bun run db:push; bun run db:seed",
    "test": "bunx vitest run",
    "test:watch": "bunx vitest",
    "deploy": "bash scripts/deploy.sh",
    "backup": "bash scripts/backup.sh",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop dealdoor",
    "pm2:restart": "pm2 restart dealdoor",
    "pm2:status": "pm2 status",
    "pm2:logs": "pm2 logs dealdoor",
    "docker:build": "docker build -t dealdoor .",
    "docker:run": "docker run -p 4321:4321 -v ./db:/app/db dealdoor",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "dependencies": {
    "@astrojs/node": "^11.0.0",
    "@astrojs/react": "^6.0.0",
    "@noble/hashes": "^2.2.0",
    "@node-rs/argon2": "^2.0.2",
    "@oslojs/crypto": "^1.0.1",
    "@oslojs/encoding": "^1.1.0",
    "@paralleldrive/cuid2": "^3.3.0",
    "@tailwindcss/vite": "^4.3.2",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "astro": "^7.0.4",
    "better-sqlite3": "^12.11.1",
    "chart.js": "^4.5.1",
    "drizzle-orm": "^0.45.2",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.2",
    "tailwindcss": "^4.3.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/qrcode": "^1.5.6",
    "@types/sharp": "^0.32.0",
    "drizzle-kit": "^0.31.10",
    "vitest": "^4.1.9"
  }
}

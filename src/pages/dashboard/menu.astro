---
// src/pages/dashboard/menu.astro

import DashboardLayout from '../../layouts/DashboardLayout.astro';
import MenuManager from '../../components/dashboard/MenuManager.tsx';
import Icon from '../../components/icons/index.astro';
import { getTierLimits, type Tier } from '../../lib/tiers';
import { listDashboardMenuItems, requireDashboardShop } from '../../lib/dashboard/server';

let context;
try {
  context = await requireDashboardShop(Astro.locals.user);
} catch {
  return Astro.redirect('/auth/login');
}

const { shop } = context;
const items = await listDashboardMenuItems(shop.id);
const tier = (shop.tier as Tier) || 'free';
const maxItems = getTierLimits(tier).maxMenuItems;
---

<DashboardLayout title="จัดการเมนูและแคตตาล็อก" activeTab="menu">
  <div class="space-y-6">
    <section class="rounded-3xl border border-border/40 bg-card-bg p-5 shadow-sm">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div class="flex items-start gap-3">
          <div class="flex h-11 w-11 items-center justify-center rounded-2xl bg-primary/10 text-primary">
            <Icon name="menu" class="h-5 w-5" />
          </div>
          <div>
            <p class="text-xs font-black uppercase tracking-wider text-primary">Menu & Catalog</p>
            <h1 class="text-2xl font-black text-secondary">เมนู & แคตตาล็อกสินค้า</h1>
            <p class="mt-1 text-sm font-bold text-text-secondary">
              รายการในหน้านี้จะ sync ไปแสดงบนหน้าร้าน {shop.name} ทันที
            </p>
          </div>
        </div>
        <a href={`/${shop.slug}`} class="inline-flex min-h-[46px] items-center justify-center rounded-2xl bg-primary px-5 text-sm font-black text-white shadow-lg shadow-primary/20">
          ดูหน้าร้าน
        </a>
      </div>
    </section>

    <MenuManager client:load initialItems={items} maxItems={maxItems} />
  </div>
</DashboardLayout>

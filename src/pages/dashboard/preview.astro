---
// src/pages/dashboard/preview.astro

import DashboardLayout from '../../layouts/DashboardLayout.astro';
import Icon from '../../components/icons/index.astro';
import { requireDashboardShop } from '../../lib/dashboard/server';

let context;
try {
  context = await requireDashboardShop(Astro.locals.user);
} catch {
  return Astro.redirect('/dashboard');
}

const { shop } = context;
---

<DashboardLayout title="พรีวิวหน้าร้าน" activeTab="preview">
  <div class="space-y-6">
    <section class="rounded-3xl border border-border/40 bg-card-bg p-5 shadow-sm">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div class="flex items-start gap-3">
          <div class="flex h-11 w-11 items-center justify-center rounded-2xl bg-primary/10 text-primary shrink-0">
            <Icon name="eye" class="h-5 w-5" />
          </div>
          <div>
            <p class="text-xs font-black uppercase tracking-wider text-primary">Preview</p>
            <h1 class="text-2xl font-black text-secondary">พรีวิวหน้าร้าน</h1>
            <p class="mt-1 text-sm font-bold text-text-secondary">ดูหน้าที่ลูกค้าจะเห็นก่อนนำลิงก์ไปแชร์</p>
          </div>
        </div>
        <a href={`/${shop.slug}`} target="_blank" class="inline-flex min-h-[46px] items-center justify-center rounded-2xl bg-primary px-5 text-sm font-black text-white">
          เปิดหน้าจริง
        </a>
      </div>
    </section>

    <section class="overflow-hidden rounded-3xl border border-border/50 bg-card-bg shadow-xl">
      <div class="flex items-center gap-2 border-b border-border/40 bg-bg-secondary px-4 py-3">
        <div class="flex gap-1.5">
          <span class="h-3 w-3 rounded-full bg-red-400"></span>
          <span class="h-3 w-3 rounded-full bg-yellow-400"></span>
          <span class="h-3 w-3 rounded-full bg-green-400"></span>
        </div>
        <div class="mx-auto max-w-md flex-1 truncate rounded-xl border border-border/30 bg-bg px-3 py-1 text-center text-xs font-bold text-text-tertiary">
          {new URL(`/${shop.slug}`, Astro.site || Astro.url).href}
        </div>
      </div>
      <iframe src={`/${shop.slug}`} class="h-[70vh] w-full" title={`Preview ${shop.name}`}></iframe>
    </section>
  </div>
</DashboardLayout>

---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import NotificationCenter from '../../components/dashboard/NotificationCenter.tsx';
import { getDashboardContext } from '../../lib/dashboard/server';

const context = await getDashboardContext(Astro.locals.user);
if (!context) return Astro.redirect('/auth/login');
---

<DashboardLayout title="การแจ้งเตือน" activeTab="notifications">
  <NotificationCenter client:load />
</DashboardLayout>

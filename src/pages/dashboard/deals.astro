---
// src/pages/dashboard/deals.astro

import DashboardLayout from '../../layouts/DashboardLayout.astro';
import DealList from '../../components/dashboard/DealList.tsx';
import Icon from '../../components/icons/index.astro';
import { listDashboardDeals, requireDashboardShop } from '../../lib/dashboard/server';

let context;
try {
  context = await requireDashboardShop(Astro.locals.user);
} catch {
  return Astro.redirect('/auth/login');
}

const { shop } = context;
const dealRows = await listDashboardDeals(shop.id);
const maxDeals = shop.maxActiveDeals ?? 6;
---

<DashboardLayout title="จัดการดีล" activeTab="deals">
  <div class="space-y-6">
    <section class="rounded-3xl border border-border/40 bg-card-bg p-5 shadow-sm">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div class="flex items-start gap-3">
          <div class="flex h-11 w-11 items-center justify-center rounded-2xl bg-primary/10 text-primary">
            <Icon name="tag" class="h-5 w-5" />
          </div>
          <div>
            <p class="text-xs font-black uppercase tracking-wider text-primary">Deals</p>
            <h1 class="text-2xl font-black text-secondary">จัดการดีลและคูปอง</h1>
            <p class="mt-1 text-sm font-bold text-text-secondary">ดีลทั้งหมดในหน้านี้เป็นของร้าน {shop.name} เท่านั้น</p>
          </div>
        </div>
        <a href="/dashboard/deals/new" class="inline-flex min-h-[46px] items-center justify-center rounded-2xl bg-primary px-5 text-sm font-black text-white shadow-lg shadow-primary/20">
          เพิ่มดีลใหม่
        </a>
      </div>
    </section>

    <DealList client:load initialDeals={dealRows} maxDeals={maxDeals} />
  </div>
</DashboardLayout>

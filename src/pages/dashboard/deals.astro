---
// src/pages/dashboard/deals.astro

import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { db } from '../../lib/db';
import { shops } from '../../../db/schema';
import DealList from '../../components/dashboard/DealList.tsx';
import Icon from '../../components/icons/index.astro';

// ─── BACKEND WORKFLOW: MERCHANT SHOP RETRIEVAL ───
// This fetches the first shop linked to the user.
// In a full implementation, it links via the merchant ID associated with the active session.
const shop = await db.select().from(shops).limit(1).get();

if (!shop) {
  return Astro.redirect('/dashboard');
}
// ─────────────────────────────────────────────────
---

<DashboardLayout title="จัดการดีล" activeTab="deals">
  <div class="space-y-6">
    {/* Page Header */}
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-border/30 pb-4">
      <div>
        <h2 class="text-base font-bold text-secondary flex items-center gap-2">
          <Icon name="tag" class="h-5 w-5 text-primary" />
          <span>จัดการโปรโมชัน / ดีลร้านค้า</span>
        </h2>
        <p class="text-xs text-text-secondary mt-0.5">เพิ่ม ลบ หรือแก้ไขข้อมูลคูปองเพื่อดึงดูดลูกค้า</p>
      </div>
      
      <a
        href="/dashboard/deals/new"
        class="btn btn-primary py-2 px-4 rounded-xl text-xs font-bold shadow-md self-start sm:self-center"
      >
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
        </svg>
        <span>เพิ่มดีลใหม่</span>
      </a>
    </div>

    {/* Deal List React Component inside Premium Glass Card */}
    <div class="rounded-3xl border border-border/40 bg-card-bg/60 backdrop-blur-sm p-6 shadow-md">
      <DealList
        client:load
        shopId={shop.id}
        maxDeals={shop.maxActiveDeals}
      />
    </div>
  </div>
</DashboardLayout>

---
// src/pages/dashboard/analytics.astro

import DashboardLayout from '../../layouts/DashboardLayout.astro';
import StatsOverview from '../../components/dashboard/analytics/StatsOverview.tsx';
import TopDeals from '../../components/dashboard/analytics/TopDeals.tsx';
import Icon from '../../components/icons/index.astro';
import { requireDashboardShop } from '../../lib/dashboard/server';

let context;
try {
  context = await requireDashboardShop(Astro.locals.user);
} catch {
  return Astro.redirect('/dashboard');
}
---

<DashboardLayout title="สถิติร้านค้า" activeTab="analytics">
  <div class="space-y-6">
    <section class="rounded-3xl border border-border/40 bg-card-bg p-5 shadow-sm">
      <div class="flex items-start gap-3">
        <div class="flex h-11 w-11 items-center justify-center rounded-2xl bg-primary/10 text-primary">
          <Icon name="chart" class="h-5 w-5" />
        </div>
        <div>
          <p class="text-xs font-black uppercase tracking-wider text-primary">Analytics</p>
          <h1 class="text-2xl font-black text-secondary">สถิติของ {context.shop.name}</h1>
          <p class="mt-1 text-sm font-bold text-text-secondary">วัดผลจากหน้าร้าน ดีล การแชร์ และการคลิกติดต่อ</p>
        </div>
      </div>
    </section>

    <StatsOverview client:load days={30} />
    <TopDeals client:load />

    <section class="rounded-3xl border border-border/40 bg-card-bg p-5 shadow-sm">
      <p class="text-sm font-black text-secondary">หมายเหตุข้อมูล</p>
      <p class="mt-1 text-sm font-bold leading-6 text-text-secondary">
        API analytics อ่านข้อมูลของร้านที่ผูกกับบัญชีปัจจุบันเท่านั้น จึงไม่สามารถส่ง shopId จาก browser เพื่อดูข้อมูลร้านอื่นได้
      </p>
    </section>
  </div>
</DashboardLayout>

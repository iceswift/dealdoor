---
// src/pages/dashboard/deals/edit.astro

import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import DealFormEditWrapper from '../../../components/dashboard/DealFormEditWrapper.tsx';
import { requireDashboardShop } from '../../../lib/dashboard/server';

let shop;
try {
  ({ shop } = await requireDashboardShop(Astro.locals.user));
} catch {
  return Astro.redirect('/dashboard');
}
---

<DashboardLayout title="แก้ไขดีล" activeTab="deals">
  <div class="space-y-6">
    <section class="rounded-3xl border border-border/40 bg-card-bg p-5 shadow-sm">
      <p class="text-xs font-black uppercase tracking-wider text-primary">Edit Deal</p>
      <h1 class="text-2xl font-black text-secondary">แก้ไขดีล</h1>
      <p class="mt-1 text-sm font-bold text-text-secondary">โหลดข้อมูลจาก id ใน URL และตรวจสิทธิ์ผ่าน API ของร้านคุณ</p>
    </section>

    <DealFormEditWrapper client:load shopName={shop.name} shopLogoUrl={shop.logoImage} shopAddress={shop.address} />
  </div>
</DashboardLayout>

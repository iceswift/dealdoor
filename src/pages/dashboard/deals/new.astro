---
// src/pages/dashboard/deals/new.astro

import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import DealForm from '../../../components/dashboard/DealForm.tsx';
import { requireDashboardShop } from '../../../lib/dashboard/server';

try {
  await requireDashboardShop(Astro.locals.user);
} catch {
  return Astro.redirect('/dashboard');
}
---

<DashboardLayout title="สร้างดีลใหม่" activeTab="deals">
  <div class="space-y-6">
    <section class="rounded-3xl border border-border/40 bg-card-bg p-5 shadow-sm">
      <p class="text-xs font-black uppercase tracking-wider text-primary">New Deal</p>
      <h1 class="text-2xl font-black text-secondary">สร้างดีลใหม่</h1>
      <p class="mt-1 text-sm font-bold text-text-secondary">ออกแบบดีลให้มีรูป ข้อเสนอ วิธีรับสิทธิ์ และวันหมดอายุครบถ้วน</p>
    </section>

    <DealForm client:load />
  </div>
</DashboardLayout>

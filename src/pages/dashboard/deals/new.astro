---
// src/pages/dashboard/deals/new.astro

import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import DealForm from '../../../components/dashboard/DealForm.tsx';
import { getDemoPolicy } from '../../../lib/demo';
import Icon from '../../../components/icons/index.astro';
import { requireDashboardShop } from '../../../lib/dashboard/server';

let shop;
try {
  ({ shop } = await requireDashboardShop(Astro.locals.user));
} catch {
  return Astro.redirect('/dashboard');
}
---

<DashboardLayout title="สร้างดีลใหม่" activeTab="deals">
  <div class="space-y-6">
    <section class="rounded-3xl border border-border/40 bg-card-bg p-5 shadow-sm">
      <div class="flex items-start gap-3">
        <div class="flex h-11 w-11 items-center justify-center rounded-2xl bg-primary/10 text-primary shrink-0">
          <Icon name="plus" class="h-5 w-5" />
        </div>
        <div>
          <p class="text-xs font-black uppercase tracking-wider text-primary">New Deal</p>
          <h1 class="text-2xl font-black text-secondary">สร้างดีลใหม่</h1>
          <p class="mt-1 text-sm font-bold text-text-secondary">ออกแบบดีลให้มีรูป ข้อเสนอ วิธีรับสิทธิ์ และวันหมดอายุครบถ้วน</p>
        </div>
      </div>
    </section>

    <DealForm client:load uploadsDisabled={!getDemoPolicy().uploadsAllowed} shopName={shop.name} shopLogoUrl={shop.logoImage} shopAddress={shop.address} />
  </div>
</DashboardLayout>

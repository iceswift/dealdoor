---
// src/pages/dashboard/index.astro

import DashboardLayout from '../../layouts/DashboardLayout.astro';
import SharePanel from '../../components/dashboard/SharePanel.tsx';
import UpgradeBanner from '../../components/dashboard/UpgradeBanner.tsx';
import Icon from '../../components/icons/index.astro';
import { getDashboardContext, getDashboardOverview } from '../../lib/dashboard/server';

const context = await getDashboardContext(Astro.locals.user);
if (!context) {
  return Astro.redirect('/auth/login');
}

const { user, shop } = context;
const overview = shop ? await getDashboardOverview(shop) : null;

const statCards = overview ? [
  { label: 'ยอดเข้าชม', value: overview.totals.pageViews, hint: '60 วันที่ผ่านมา' },
  { label: 'คลิกดีล', value: overview.totals.dealClicks, hint: 'จากทุกดีล' },
  { label: 'แชร์', value: overview.totals.shares, hint: 'ลิงก์และดีล' },
  { label: 'ดีลใช้งาน', value: `${overview.activeDealCount}/${overview.maxDeals}`, hint: overview.tier === 'pro' ? 'Pro' : 'Free' },
] : [];
---

<DashboardLayout title="ภาพรวมร้านค้า" activeTab="overview">
  {!shop || !overview ? (
    <section class="min-h-[70vh] rounded-3xl border border-border/40 bg-card-bg p-8 shadow-sm">
      <div class="mx-auto flex max-w-2xl flex-col items-center justify-center py-16 text-center">
        <div class="flex h-16 w-16 items-center justify-center rounded-3xl bg-primary text-white shadow-lg shadow-primary/20">
          <Icon name="store" class="h-8 w-8" />
        </div>
        <h1 class="mt-6 text-2xl font-black text-secondary">เริ่มสร้างร้านของคุณบน DealDoor</h1>
        <p class="mt-3 text-sm font-bold leading-7 text-text-secondary">
          กรอกข้อมูลร้าน รูปภาพ ช่องทางติดต่อ และพิกัด เพื่อให้ลูกค้าค้นพบดีลของคุณจากหน้า Explore และหน้าร้านที่แชร์ได้
        </p>
        <a href="/dashboard/edit" class="mt-6 inline-flex min-h-[48px] items-center rounded-2xl bg-primary px-6 text-sm font-black text-white shadow-lg shadow-primary/20">
          สร้างร้านค้า
        </a>
      </div>
    </section>
  ) : (
    <div class="space-y-6">
      <section class="rounded-3xl border border-border/40 bg-card-bg p-5 shadow-sm">
        <div class="grid gap-6 lg:grid-cols-[1fr_auto] lg:items-center">
          <div class="min-w-0">
            <div class="flex flex-wrap items-center gap-2">
              <span class="rounded-full bg-primary/10 px-3 py-1 text-xs font-black text-primary">
                {shop.isOpen ? 'เปิดรับลูกค้า' : 'ปิดชั่วคราว'}
              </span>
              <span class="rounded-full bg-bg-secondary px-3 py-1 text-xs font-black text-text-secondary">
                {shop.tier === 'pro' ? 'Pro' : 'Free'}
              </span>
            </div>
            <h1 class="mt-4 text-2xl font-black tracking-tight text-secondary">สวัสดี {user.name}, วันนี้ร้าน {shop.name} เป็นอย่างไรบ้าง</h1>
            <p class="mt-2 max-w-3xl text-sm font-bold leading-6 text-text-secondary">
              Dashboard ใหม่นี้แยกข้อมูลร้าน ดีล และสถิติออกเป็นระบบเดียวกันชัดเจน เพื่อให้แก้ต่อได้ง่ายและไม่ดึงข้อมูลผิดร้าน
            </p>
          </div>
          <div class="flex flex-wrap gap-2">
            <a href={`/${shop.slug}`} class="inline-flex min-h-[44px] items-center rounded-2xl border border-border/50 px-4 text-sm font-black text-secondary hover:bg-bg-secondary">
              ดูหน้าร้าน
            </a>
            <a href="/dashboard/deals/new" class="inline-flex min-h-[44px] items-center rounded-2xl bg-primary px-4 text-sm font-black text-white">
              สร้างดีล
            </a>
          </div>
        </div>
      </section>

      <section class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
        {statCards.map((card) => (
          <div class="rounded-3xl border border-border/40 bg-card-bg p-5 shadow-sm">
            <p class="text-xs font-black uppercase tracking-wider text-text-tertiary">{card.label}</p>
            <p class="mt-2 text-3xl font-black text-secondary">{card.value}</p>
            <p class="mt-1 text-xs font-bold text-text-tertiary">{card.hint}</p>
          </div>
        ))}
      </section>

      <section class="grid gap-6 xl:grid-cols-[1fr_380px]">
        <div class="rounded-3xl border border-border/40 bg-card-bg p-5 shadow-sm">
          <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
            <div>
              <p class="text-xs font-black uppercase tracking-wider text-primary">Readiness</p>
              <h2 class="text-xl font-black text-secondary">ความพร้อมสำหรับ Explore</h2>
            </div>
            <span class="text-3xl font-black text-secondary">{overview.readiness.score}%</span>
          </div>
          <div class="mt-4 h-3 overflow-hidden rounded-full bg-bg-tertiary">
            <div class="h-full rounded-full bg-primary" style={`width: ${overview.readiness.score}%`}></div>
          </div>
          <div class="mt-5 grid gap-3 sm:grid-cols-2">
            {overview.readiness.checks.map((item) => (
              <div class:list={[
                'rounded-2xl border p-4',
                item.done ? 'border-emerald-200 bg-emerald-50 text-emerald-800' : 'border-border/40 bg-bg-secondary text-text-secondary'
              ]}>
                <p class="text-sm font-black">{item.done ? 'พร้อม' : 'ยังขาด'}: {item.label}</p>
              </div>
            ))}
          </div>
        </div>

        <div class="space-y-6">
          <SharePanel client:load slug={shop.slug} shopName={shop.name} logoUrl={shop.logoImage} />
          <UpgradeBanner client:load currentTier={overview.tier} />
        </div>
      </section>

      <section class="rounded-3xl border border-border/40 bg-card-bg p-5 shadow-sm">
        <div class="flex items-center justify-between gap-3">
          <div>
            <p class="text-xs font-black uppercase tracking-wider text-primary">Deals</p>
            <h2 class="text-xl font-black text-secondary">ดีลที่ควรดูแลต่อ</h2>
          </div>
          <a href="/dashboard/deals" class="text-sm font-black text-primary hover:underline">จัดการทั้งหมด</a>
        </div>
        <div class="mt-5 grid gap-3">
          {overview.upcomingDeals.length === 0 ? (
            <div class="rounded-2xl border border-dashed border-border/50 bg-bg-secondary/50 p-6 text-center">
              <p class="text-sm font-black text-secondary">ยังไม่มีดีลที่กำลังใช้งาน</p>
              <a href="/dashboard/deals/new" class="mt-3 inline-flex min-h-[44px] items-center rounded-2xl bg-primary px-5 text-sm font-black text-white">สร้างดีลแรก</a>
            </div>
          ) : (
            overview.upcomingDeals.map((deal) => (
              <a href={`/dashboard/deals/edit?id=${deal.id}`} class="grid gap-3 rounded-2xl border border-border/40 bg-bg p-4 transition hover:border-primary/40 sm:grid-cols-[80px_1fr_auto] sm:items-center">
                <div class="aspect-square overflow-hidden rounded-xl bg-bg-secondary">
                  {deal.imageUrl ? <img src={deal.imageUrl} alt={deal.title} class="h-full w-full object-cover" /> : null}
                </div>
                <div>
                  <p class="text-sm font-black text-secondary">{deal.title}</p>
                  <p class="text-sm font-bold text-primary">{deal.discountText}</p>
                </div>
                <p class="text-xs font-black text-text-tertiary">
                  หมดอายุ {new Date(deal.endDate).toLocaleDateString('th-TH', { month: 'short', day: 'numeric' })}
                </p>
              </a>
            ))
          )}
        </div>
      </section>
    </div>
  )}
</DashboardLayout>

---
// src/pages/dashboard/index.astro

import DashboardLayout from '../../layouts/DashboardLayout.astro';
import SharePanel from '../../components/dashboard/SharePanel.tsx';
import UpgradeBanner from '../../components/dashboard/UpgradeBanner.tsx';
import Icon from '../../components/icons/index.astro';
import { getDashboardContext, getDashboardOverview } from '../../lib/dashboard/server';

const context = await getDashboardContext(Astro.locals.user);
if (!context) {
  return Astro.redirect('/auth/login');
}

const { user, shop } = context;
const overview = shop ? await getDashboardOverview(shop) : null;
const shopIsPaused = Boolean(shop?.vacationMode);

const statCards = overview ? [
  { label: 'ยอดเข้าชม', value: overview.totals.pageViews, hint: '60 วันที่ผ่านมา', icon: 'eye', color: 'primary' },
  { label: 'คลิกดีล', value: overview.totals.dealClicks, hint: 'จากทุกดีล', icon: 'tag', color: 'info' },
  { label: 'แชร์', value: overview.totals.shares, hint: 'ลิงก์และดีล', icon: 'share', color: 'accent' },
  { label: 'ดีลใช้งาน', value: `${overview.activeDealCount}/${overview.maxDeals}`, hint: overview.tier === 'pro' ? 'Pro' : 'Free', icon: 'chart', color: 'warning' },
] : [];

const colorClasses: Record<string, { text: string; bg: string; border: string }> = {
  primary: { text: 'text-primary', bg: 'bg-primary/10', border: 'border-l-primary' },
  info: { text: 'text-info', bg: 'bg-info/10', border: 'border-l-info' },
  accent: { text: 'text-accent', bg: 'bg-accent/10', border: 'border-l-accent' },
  warning: { text: 'text-warning', bg: 'bg-warning/10', border: 'border-l-warning' },
};

const readinessCircumference = 2 * Math.PI * 42;
const readinessOffset = overview ? readinessCircumference * (1 - overview.readiness.score / 100) : readinessCircumference;

function daysUntil(dateStr: string) {
  const diff = new Date(dateStr).getTime() - Date.now();
  return Math.ceil(diff / (1000 * 60 * 60 * 24));
}

function lifeRemainingPercent(startDate: string | Date | null, endDate: string | Date) {
  const start = startDate ? new Date(startDate).getTime() : null;
  const end = new Date(endDate).getTime();
  const now = Date.now();
  const from = start && start < now ? start : now - 1000 * 60 * 60 * 24 * 30;
  const total = end - from;
  if (total <= 0) return 0;
  const remaining = ((end - now) / total) * 100;
  return Math.max(0, Math.min(100, Math.round(remaining)));
}

const dealStatsById = overview
  ? new Map(overview.topDeals.map((d) => [d.dealId, d]))
  : new Map();
---

<DashboardLayout title="ภาพรวมร้านค้า" activeTab="overview">
  {!shop || !overview ? (
    <section class="min-h-[70vh] rounded-3xl border border-border/40 bg-card-bg p-8 shadow-sm">
      <div class="mx-auto flex max-w-2xl flex-col items-center justify-center py-16 text-center">
        <div class="flex h-16 w-16 items-center justify-center rounded-3xl bg-primary text-white shadow-lg shadow-primary/20">
          <Icon name="shop" class="h-8 w-8" />
        </div>
        <h1 class="mt-6 text-2xl font-black text-secondary">เริ่มสร้างร้านของคุณบน DealDoor</h1>
        <p class="mt-3 text-sm font-bold leading-7 text-text-secondary">
          กรอกข้อมูลร้าน รูปภาพ ช่องทางติดต่อ และพิกัด เพื่อให้ลูกค้าค้นพบดีลของคุณจากหน้า Explore และหน้าร้านที่แชร์ได้
        </p>
        <a href="/dashboard/edit" class="mt-6 inline-flex min-h-[48px] items-center rounded-2xl bg-primary px-6 text-sm font-black text-white shadow-lg shadow-primary/20">
          สร้างร้านค้า
        </a>
      </div>
    </section>
  ) : (
    <div class="space-y-6">
      <section class="relative overflow-hidden rounded-3xl border border-border/40 bg-card-bg p-5 shadow-sm sm:p-6">
        <div class="pointer-events-none absolute -right-16 -top-16 h-56 w-56 rounded-full bg-primary/10 blur-3xl"></div>
        <div class="pointer-events-none absolute -left-10 -bottom-10 h-40 w-40 rounded-full bg-accent/10 blur-2xl"></div>
        <div class="relative grid gap-6 lg:grid-cols-[auto_1fr_auto] lg:items-center">
          <div class="hidden h-16 w-16 shrink-0 overflow-hidden rounded-2xl border border-border/40 bg-bg-secondary shadow-sm sm:flex sm:items-center sm:justify-center">
            {shop.logoImage ? (
              <img src={shop.logoImage} alt={shop.name} class="h-full w-full object-cover" />
            ) : (
              <Icon name="shop-identity" class="h-7 w-7 text-primary" />
            )}
          </div>
          <div class="min-w-0">
            <div class="flex flex-wrap items-center gap-2">
              <span class:list={[
                'inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-black',
                shopIsPaused ? 'bg-warning-bg text-warning-text' : shop.isOpen ? 'bg-success-bg text-success-text' : 'bg-badge-bg text-badge-text'
              ]}>
                <span class:list={['h-1.5 w-1.5 rounded-full', shopIsPaused ? 'bg-warning' : shop.isOpen ? 'bg-success' : 'bg-text-tertiary']}></span>
                {shopIsPaused ? 'หยุดพักร้าน' : shop.isOpen ? 'เปิดรับลูกค้า' : 'ปิดชั่วคราว'}
              </span>
              <span class="rounded-full bg-primary/10 px-3 py-1 text-xs font-black text-primary">
                {shop.tier === 'pro' ? 'Pro' : 'Free'}
              </span>
            </div>
            <h1 class="mt-4 text-2xl font-black tracking-tight text-secondary">สวัสดี {user.name}, วันนี้ร้าน {shop.name} เป็นอย่างไรบ้าง</h1>
            <p class="mt-2 max-w-3xl text-sm font-bold leading-6 text-text-secondary">
              Dashboard ใหม่นี้แยกข้อมูลร้าน ดีล และสถิติออกเป็นระบบเดียวกันชัดเจน เพื่อให้แก้ต่อได้ง่ายและไม่ดึงข้อมูลผิดร้าน
            </p>
          </div>
          <div class="flex flex-wrap gap-2">
            <a href={`/${shop.slug}`} class="inline-flex min-h-[44px] items-center rounded-2xl border border-border/50 px-4 text-sm font-black text-secondary transition-colors hover:bg-bg-secondary">
              ดูหน้าร้าน
            </a>
            <a href="/dashboard/deals/new" class="inline-flex min-h-[44px] items-center rounded-2xl bg-primary px-4 text-sm font-black text-white shadow-lg shadow-primary/20 transition-transform hover:scale-[1.02]">
              สร้างดีล
            </a>
          </div>
        </div>
      </section>

      <section class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
        {statCards.map((card) => (
          <div class:list={[
            'rounded-3xl border border-l-4 border-border/40 bg-card-bg p-5 shadow-sm transition-shadow hover:shadow-md',
            colorClasses[card.color].border
          ]}>
            <div class="flex items-center justify-between gap-2">
              <p class="text-xs font-black uppercase tracking-wider text-text-tertiary">{card.label}</p>
              <div class:list={['flex h-9 w-9 shrink-0 items-center justify-center rounded-xl', colorClasses[card.color].bg]}>
                <Icon name={card.icon} class:list={['h-4 w-4', colorClasses[card.color].text]} />
              </div>
            </div>
            <p class="mt-3 text-3xl font-black text-secondary">{card.value}</p>
            <p class="mt-1 text-xs font-bold text-text-tertiary">{card.hint}</p>
          </div>
        ))}
      </section>

      <section class="grid gap-6 xl:grid-cols-[1fr_380px]">
        <div class="rounded-3xl border border-border/40 bg-card-bg p-5 shadow-sm">
          <div class="flex items-center gap-3">
            <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-primary/10">
              <Icon name="rocket" class="h-5 w-5 text-primary" />
            </div>
            <div>
              <p class="text-xs font-black uppercase tracking-wider text-primary">Readiness</p>
              <h2 class="text-xl font-black text-secondary">ความพร้อมสำหรับ Explore</h2>
            </div>
          </div>
          <div class="mt-5 flex flex-col gap-5 sm:flex-row sm:items-center">
            <div class="relative mx-auto h-28 w-28 shrink-0 sm:mx-0">
              <svg viewBox="0 0 96 96" class="h-28 w-28 -rotate-90">
                <circle cx="48" cy="48" r="42" fill="none" stroke="var(--color-bg-tertiary)" stroke-width="8" />
                <circle
                  cx="48" cy="48" r="42" fill="none" stroke="var(--color-primary)" stroke-width="8"
                  stroke-linecap="round"
                  stroke-dasharray={readinessCircumference}
                  stroke-dashoffset={readinessOffset}
                />
              </svg>
              <div class="absolute inset-0 flex items-center justify-center">
                <span class="text-2xl font-black text-secondary">{overview.readiness.score}%</span>
              </div>
            </div>
            <div class="grid flex-1 gap-3 sm:grid-cols-2">
              {overview.readiness.checks.map((item) => (
                item.done ? (
                  <div class="flex min-h-[64px] items-center gap-3 rounded-2xl border border-success/20 bg-success-bg p-4 text-success-text">
                    <div class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-success text-white">
                      <Icon name="check" class="h-4 w-4" />
                    </div>
                    <div class="min-w-0">
                      <p class="text-sm font-black">{item.label}</p>
                      <p class="mt-0.5 text-xs font-bold opacity-80">ครบแล้ว</p>
                    </div>
                  </div>
                ) : (
                  <a
                    href={item.targetHref}
                    class="group flex min-h-[64px] items-center gap-3 rounded-2xl border border-primary/20 bg-primary/5 p-4 text-secondary transition hover:-translate-y-0.5 hover:border-primary/40 hover:bg-primary/10 hover:shadow-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
                  >
                    <div class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-white text-primary shadow-sm ring-1 ring-primary/20">
                      <Icon name="x" class="h-4 w-4" />
                    </div>
                    <div class="min-w-0 flex-1">
                      <p class="text-sm font-black">{item.label}</p>
                      <p class="mt-0.5 text-xs font-black text-primary">{item.actionLabel}</p>
                    </div>
                    <Icon name="chevron-right" class="h-4 w-4 shrink-0 text-primary transition-transform group-hover:translate-x-0.5" />
                  </a>
                )
              ))}
            </div>
          </div>
        </div>

        <div class="space-y-6">
          <SharePanel client:load slug={shop.slug} shopName={shop.name} logoUrl={shop.logoImage} />
          <UpgradeBanner client:load currentTier={overview.tier} />
        </div>
      </section>

      <section class="rounded-3xl border border-border/40 bg-card-bg p-5 shadow-sm">
        <div class="flex items-center justify-between gap-3">
          <div class="flex items-center gap-3">
            <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-info/10">
              <Icon name="tag" class="h-5 w-5 text-info" />
            </div>
            <div>
              <p class="text-xs font-black uppercase tracking-wider text-primary">Deals</p>
              <h2 class="text-xl font-black text-secondary">ดีลที่ควรดูแลต่อ</h2>
            </div>
          </div>
          <a href="/dashboard/deals" class="text-sm font-black text-primary hover:underline">จัดการทั้งหมด</a>
        </div>
        <div class="mt-5 grid gap-4 sm:grid-cols-2">
          {overview.upcomingDeals.length === 0 ? (
            <div class="rounded-2xl border border-dashed border-border/50 bg-bg-secondary/50 p-6 text-center sm:col-span-2">
              <p class="text-sm font-black text-secondary">ยังไม่มีดีลที่กำลังใช้งาน</p>
              <a href="/dashboard/deals/new" class="mt-3 inline-flex min-h-[44px] items-center rounded-2xl bg-primary px-5 text-sm font-black text-white">สร้างดีลแรก</a>
            </div>
          ) : (
            overview.upcomingDeals.map((deal) => {
              const daysLeft = daysUntil(deal.endDate);
              const isExpiringSoon = daysLeft <= 3;
              const lifePercent = lifeRemainingPercent(deal.startDate, deal.endDate);
              const stats = dealStatsById.get(deal.id);
              return (
                <div class="group relative overflow-hidden rounded-2xl border border-border/40 bg-bg transition hover:border-primary/40 hover:shadow-sm">
                  <a href={`/dashboard/deals/edit?id=${deal.id}`} class="block">
                    <div class="relative aspect-[16/9] overflow-hidden bg-bg-secondary">
                      {deal.imageUrl ? (
                        <img src={deal.imageUrl} alt={deal.title} class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105" />
                      ) : (
                        <div class="flex h-full w-full items-center justify-center">
                          <Icon name="tag" class="h-6 w-6 text-text-tertiary" />
                        </div>
                      )}
                      <span class="absolute left-2.5 top-2.5 flex items-center gap-1.5 rounded-full bg-black/50 px-2.5 py-1 text-[10px] font-black text-white backdrop-blur-md">
                        <span class="h-1.5 w-1.5 rounded-full bg-success"></span>
                        ใช้งานอยู่
                      </span>
                      {isExpiringSoon && (
                        <span class="absolute right-2.5 top-2.5 rounded-full bg-warning-bg px-2.5 py-1 text-[10px] font-black text-warning-text backdrop-blur-md">
                          ใกล้หมดอายุ
                        </span>
                      )}
                    </div>
                    <div class="p-4 pb-3">
                      <p class="truncate text-sm font-black text-secondary">{deal.title}</p>
                      <div class="mt-1 flex items-center justify-between gap-2">
                        <p class="truncate text-sm font-bold text-primary">{deal.discountText}</p>
                        {stats && (
                          <div class="flex shrink-0 items-center gap-2 text-[10px] font-black text-text-tertiary">
                            <span class="flex items-center gap-0.5"><Icon name="eye" class="h-3 w-3" />{stats.views}</span>
                            <span class="flex items-center gap-0.5"><Icon name="tag" class="h-3 w-3" />{stats.clicks}</span>
                          </div>
                        )}
                      </div>
                    </div>
                  </a>
                  <div class="px-4 pb-4">
                    <div class="h-1.5 overflow-hidden rounded-full bg-bg-tertiary">
                      <div
                        class:list={['h-full rounded-full', isExpiringSoon ? 'bg-warning' : 'bg-primary']}
                        style={`width: ${lifePercent}%`}
                      ></div>
                    </div>
                    <p class="mt-1.5 text-xs font-black text-text-tertiary">
                      หมดอายุ {new Date(deal.endDate).toLocaleDateString('th-TH', { month: 'short', day: 'numeric' })}
                    </p>
                  </div>
                  <div class="absolute right-2 top-2 flex translate-y-[-8px] gap-1.5 opacity-0 transition-all duration-200 group-hover:translate-y-0 group-hover:opacity-100">
                    <a href={`/dashboard/deals/edit?id=${deal.id}`} title="แก้ไข" class="flex h-8 w-8 items-center justify-center rounded-full bg-white/90 text-secondary shadow-sm hover:bg-white dark:bg-black/60 dark:text-white">
                      <Icon name="pencil" class="h-3.5 w-3.5" />
                    </a>
                    <a href="/dashboard/analytics" title="ดูสถิติ" class="flex h-8 w-8 items-center justify-center rounded-full bg-white/90 text-secondary shadow-sm hover:bg-white dark:bg-black/60 dark:text-white">
                      <Icon name="chart" class="h-3.5 w-3.5" />
                    </a>
                  </div>
                </div>
              );
            })
          )}
        </div>
      </section>
    </div>
  )}
</DashboardLayout>

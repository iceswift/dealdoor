---
// src/pages/dashboard/edit.astro

import DashboardLayout from '../../layouts/DashboardLayout.astro';
import ShopFormWrapper from '../../components/dashboard/ShopFormWrapper.tsx';
import { getDashboardContext } from '../../lib/dashboard/server';

const context = await getDashboardContext(Astro.locals.user);
if (!context) {
  return Astro.redirect('/auth/login');
}
---

<DashboardLayout title="ข้อมูลร้านค้า" activeTab="edit">
  <ShopFormWrapper client:load shop={context.shop} />
</DashboardLayout>

                    </div>
                  </td>
                  <td class="py-4 px-6 text-center">
                    <span class="inline-flex items-center justify-center h-5 w-5 rounded-full bg-rose-500/10 text-rose-600 dark:text-rose-400">
                      <Icon name="x" class="h-3 w-3" />
                    </span>
                  </td>
                  <td class="py-4 px-6 text-center">
                    <span class="inline-flex items-center justify-center h-5 w-5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400">
                      <Icon name="check" class="h-3.5 w-3.5" />
                    </span>
                  </td>
                </tr>
                <tr class="hover:bg-bg-tertiary/20 transition-colors">
                  <td class="py-4 px-6 text-secondary font-black">
                    <div class="flex items-center gap-2">
                      <span class="text-primary"><Icon name="clock" class="h-4 w-4" /></span>
                      ตั้งเวลาโพสต์ดีลล่วงหน้า (Schedule)
                    </div>
                  </td>
                  <td class="py-4 px-6 text-center">
                    <span class="inline-flex items-center justify-center h-5 w-5 rounded-full bg-rose-500/10 text-rose-600 dark:text-rose-400">
                      <Icon name="x" class="h-3 w-3" />
                    </span>
                  </td>
                  <td class="py-4 px-6 text-center">
                    <span class="inline-flex items-center justify-center h-5 w-5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400">
                      <Icon name="check" class="h-3.5 w-3.5" />
                    </span>
                  </td>
                </tr>
                <tr class="hover:bg-bg-tertiary/20 transition-colors">
                  <td class="py-4 px-6 text-secondary font-black">
                    <div class="flex items-center gap-2">
                      <span class="text-primary"><Icon name="users" class="h-4 w-4" /></span>
                      ระดับการบริการหลังการขาย
                    </div>
                  </td>
                  <td class="py-4 px-6 text-center">แบบทั่วไป</td>
                  <td class="py-4 px-6 text-center text-primary font-black">ดูแลพิเศษ (Priority)</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      {/* Interactive FAQ Section (Accordion Stack) */}
      <div class="mt-28 max-w-3xl mx-auto z-10 relative">
        <div class="text-center animate-slide-up">
          <h2 class="text-3xl font-extrabold tracking-tight text-secondary">
            คำถามที่พบบ่อย (FAQ)
          </h2>
          <p class="mt-2 text-xs font-bold text-text-secondary">มีข้อสงสัยเกี่ยวกับแพลนของเราใช่ไหม? หาคำตอบได้ทันทีที่นี่</p>
        </div>
        
        <div class="mt-10 space-y-4">
          {/* FAQ 1 */}
          <div class="faq-item rounded-2xl border border-border/25 bg-card-bg/60 backdrop-blur-md shadow-sm overflow-hidden transition-all duration-300">
            <button class="faq-toggle-btn w-full flex items-center justify-between p-5 text-left font-black text-secondary hover:bg-bg-tertiary/30 transition-colors cursor-pointer">
              <span class="text-xs md:text-sm">ชำระเงินอย่างไร?</span>
              <Icon name="chevron-down" class="faq-chevron h-5 w-5 text-text-tertiary transition-transform duration-300" />
            </button>
            <div class="faq-answer-wrapper max-h-0 overflow-hidden transition-all duration-300 ease-in-out">
              <div class="p-5 pt-0 text-[11px] md:text-xs leading-relaxed text-text-secondary border-t border-border/10 mt-2 font-bold">
                ระบบรองรับการชำระเงินผ่านบัตรเครดิต/เดบิต และโอนเงินทางธนาคาร (PromptPay) อย่างสะดวกรวดเร็ว โดยระบบชำระเงินอัตโนมัติจะเปิดให้บริการอย่างเป็นทางการเร็วๆ นี้
              </div>
            </div>
          </div>
          
          {/* FAQ 2 */}
          <div class="faq-item rounded-2xl border border-border/25 bg-card-bg/60 backdrop-blur-md shadow-sm overflow-hidden transition-all duration-300">
            <button class="faq-toggle-btn w-full flex items-center justify-between p-5 text-left font-black text-secondary hover:bg-bg-tertiary/30 transition-colors cursor-pointer">
              <span class="text-xs md:text-sm">ยกเลิกเมื่อไรก็ได้?</span>
              <Icon name="chevron-down" class="faq-chevron h-5 w-5 text-text-tertiary transition-transform duration-300" />
            </button>
            <div class="faq-answer-wrapper max-h-0 overflow-hidden transition-all duration-300 ease-in-out">
              <div class="p-5 pt-0 text-[11px] md:text-xs leading-relaxed text-text-secondary border-t border-border/10 mt-2 font-bold">
                ใช่ครับ คุณสามารถเลือกยกเลิกการสมัครสมาชิกแพลน Pro ได้ตลอดเวลาตามที่คุณต้องการโดยไม่มีข้อผูกมัดหรือเงื่อนไขใดๆ เพิ่มเติม เมื่อยกเลิกแล้วระบบจะปรับบัญชีของคุณเป็นแพลนฟรีหลังครบกำหนดรอบบิลเดิม
              </div>
            </div>
          </div>

          {/* FAQ 3 */}
          <div class="faq-item rounded-2xl border border-border/25 bg-card-bg/60 backdrop-blur-md shadow-sm overflow-hidden transition-all duration-300">
            <button class="faq-toggle-btn w-full flex items-center justify-between p-5 text-left font-black text-secondary hover:bg-bg-tertiary/30 transition-colors cursor-pointer">
              <span class="text-xs md:text-sm">มีทดลองใช้ไหม?</span>
              <Icon name="chevron-down" class="faq-chevron h-5 w-5 text-text-tertiary transition-transform duration-300" />
            </button>
            <div class="faq-answer-wrapper max-h-0 overflow-hidden transition-all duration-300 ease-in-out">
              <div class="p-5 pt-0 text-[11px] md:text-xs leading-relaxed text-text-secondary border-t border-border/10 mt-2 font-bold">
                เราไม่มีระยะเวลาทดลองใช้เนื่องจากแพลน Free ของเราสามารถลงทะเบียนและใช้งานได้ฟรีตลอดไป โดยไม่มีวันหมดอายุ และไม่จำเป็นต้องกรอกรายละเอียดข้อมูลบัตรเครดิตล่วงหน้า
              </div>
            </div>
          </div>

          {/* FAQ 4 */}
          <div class="faq-item rounded-2xl border border-border/25 bg-card-bg/60 backdrop-blur-md shadow-sm overflow-hidden transition-all duration-300">
            <button class="faq-toggle-btn w-full flex items-center justify-between p-5 text-left font-black text-secondary hover:bg-bg-tertiary/30 transition-colors cursor-pointer">
              <span class="text-xs md:text-sm">ดีลเก่าหายไหม?</span>
              <Icon name="chevron-down" class="faq-chevron h-5 w-5 text-text-tertiary transition-transform duration-300" />
            </button>
            <div class="faq-answer-wrapper max-h-0 overflow-hidden transition-all duration-300 ease-in-out">
              <div class="p-5 pt-0 text-[11px] md:text-xs leading-relaxed text-text-secondary border-t border-border/10 mt-2 font-bold">
                ดีลเก่าของร้านคุณจะไม่หายไปไหนครับ ข้อมูลและสถิติทั้งหมดยังได้รับการเก็บบันทึกไว้อย่างปลอดภัย เพียงแต่ระบบจะจำกัดการแสดงผลดีลที่เปิดพร้อมกัน (Active) บนหน้าเว็บบนเบราว์เซอร์ให้สอดคล้องกับขีดจำกัดของแพลนที่คุณใช้งานปัจจุบันเท่านั้น (สูงสุด 6 ดีลสำหรับแพลน Free)
              </div>
            </div>
          </div>
        </div>
      </div>

      {/* Bottom CTA Banner (Vibrant Orange Gradient Banner) */}
      <section class="bg-gradient-to-r from-primary to-orange-500 text-white py-16 text-center shadow-lg relative overflow-hidden rounded-3xl mt-24">
        {/* Floating Aura Spheres */}
        <div class="absolute -right-12 -bottom-12 h-32 w-32 rounded-full bg-white/10 blur-xl"></div>
        <div class="absolute -left-12 -top-12 h-32 w-32 rounded-full bg-white/10 blur-xl"></div>
        
        <div class="max-w-2xl mx-auto px-4 space-y-6 relative z-10">
          <h2 class="text-2xl md:text-3xl font-extrabold tracking-tight">เริ่มขยายหน้าร้านของคุณวันนี้</h2>
          <p class="text-xs font-bold text-white/90">สมัครสิทธิ์เปิดใช้งานหน้ารวมคูปองโปรโมชันฟรีในเวลาไม่ถึง 2 นาที</p>
          <div class="pt-2">
            <a href="/auth/register" class="inline-flex items-center gap-1.5 px-8 py-3.5 bg-white text-primary hover:bg-white/95 rounded-full text-xs font-black shadow-lg hover:scale-105 active:scale-95 transition-transform cursor-pointer">
              <Icon name="rocket" class="h-4.5 w-4.5" />
              <span>เคลมสิทธิ์สมัครร้านค้าฟรี</span>
            </a>
          </div>
        </div>
      </section>

    </div>

    {/* Coming Soon Modal */}
    <div id="coming-soon-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 backdrop-blur-sm">
      <div class="w-full max-w-md rounded-2xl bg-bg border border-border dark:border-border/30 p-8 mx-4 shadow-2xl relative animate-scale-in">
        <div class="text-center">
          <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-primary/10 text-primary mb-4">
            <Icon name="rocket" class="h-7 w-7" />
          </div>
          <h3 class="text-2xl font-bold text-secondary">อัปเกรดเป็น Pro เร็วๆ นี้!</h3>
          <p class="mt-3 text-text-secondary text-sm leading-relaxed">
            ระบบชำระเงินอัตโนมัติกำลังอยู่ในระหว่างการพัฒนาและจะพร้อมให้บริการเร็วๆ นี้
          </p>
          <div class="mt-4 p-4 rounded-xl bg-bg-secondary dark:bg-bg-tertiary text-left text-sm space-y-2 border border-border/50">
            <p class="text-text-primary font-medium flex items-center gap-2">
              <span class="h-1.5 w-1.5 rounded-full bg-primary"></span>
              ต้องการอัปเกรดใช้งานทันทีก่อนใคร?
            </p>
            <p class="text-text-secondary pl-3.5">
              โปรดส่งอีเมลแจ้งความประสงค์มาที่ <a href="mailto:support@dealdoor.co" class="text-primary hover:underline font-semibold">support@dealdoor.co</a> หรือติดต่อทีมงานของเราได้เลยครับ
            </p>
          </div>
          <button 
            id="close-modal-btn"
            class="btn btn-primary mt-6 w-full min-h-[48px]"
          >
            รับทราบ
          </button>
        </div>
      </div>
    </div>

  </div>
</BaseLayout>

<script>
  // Elements
  const upgradeBtn = document.getElementById('upgrade-pro-btn');
  const modal = document.getElementById('coming-soon-modal');
  const closeBtn = document.getElementById('close-modal-btn');

  // Modal event listeners
  upgradeBtn?.addEventListener('click', () => {
    modal?.classList.remove('hidden');
    modal?.classList.add('flex');
  });

  closeBtn?.addEventListener('click', () => {
    modal?.classList.add('hidden');
    modal?.classList.remove('flex');
  });

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !modal?.classList.contains('hidden')) {
      modal?.classList.add('hidden');
      modal?.classList.remove('flex');
    }
  });

  // Billing Toggle Logic
  const billingToggleBtn = document.getElementById('billing-toggle-btn');
  const toggleIndicator = document.getElementById('toggle-indicator');
  const billingMonthlyLabel = document.getElementById('billing-monthly-label');
  const billingYearlyLabel = document.getElementById('billing-yearly-label');
  const priceDisplays = document.querySelectorAll('.price-display');
  const priceSubDisplays = document.querySelectorAll('.price-sub-display');
  
  let isYearly = false;
  
  const prices: Record<string, { monthly: string; yearly: string; subMonthly: string; subYearly: string }> = {
    free: { monthly: '0', yearly: '0', subMonthly: 'ฟรีตลอดไป ไม่มีเงื่อนไขแอบแฝง', subYearly: 'ฟรีตลอดไป ไม่มีเงื่อนไขแอบแฝง' },
    pro: { monthly: '299', yearly: '207', subMonthly: 'ชำระรายเดือนตามจริง', subYearly: 'ชำระเป็นรายปี ฿2,490/ปี (ประหยัด 30%)' }
  };
  
  function updatePrices() {
    priceDisplays.forEach(display => {
      const planId = display.getAttribute('data-plan-id');
      if (planId && prices[planId]) {
        display.textContent = isYearly ? prices[planId].yearly : prices[planId].monthly;
      }
    });
    
    priceSubDisplays.forEach(display => {
      const planId = display.getAttribute('data-plan-id');
      if (planId && prices[planId]) {
        display.textContent = isYearly ? prices[planId].subYearly : prices[planId].subMonthly;
      }
    });
  }
  
  billingToggleBtn?.addEventListener('click', () => {
    isYearly = !isYearly;
    billingToggleBtn.setAttribute('aria-checked', isYearly.toString());
    
    if (isYearly) {
      toggleIndicator?.classList.replace('translate-x-0', 'translate-x-7');
      billingToggleBtn?.classList.replace('bg-border', 'bg-primary');
      billingYearlyLabel?.classList.replace('text-text-secondary', 'text-secondary');
      billingYearlyLabel?.classList.add('font-semibold');
      billingMonthlyLabel?.classList.replace('text-secondary', 'text-text-secondary');
      billingMonthlyLabel?.classList.remove('font-semibold');
      billingMonthlyLabel?.classList.add('font-medium');
    } else {
      toggleIndicator?.classList.replace('translate-x-7', 'translate-x-0');
      billingToggleBtn?.classList.replace('bg-primary', 'bg-border');
      billingMonthlyLabel?.classList.replace('text-text-secondary', 'text-secondary');
      billingMonthlyLabel?.classList.add('font-semibold');
      billingYearlyLabel?.classList.replace('text-secondary', 'text-text-secondary');
      billingYearlyLabel?.classList.remove('font-semibold');
      billingYearlyLabel?.classList.add('font-medium');
    }
    
    updatePrices();
  });

  // Deal Slider Calculator Logic
  const dealSlider = document.getElementById('deal-slider') as HTMLInputElement | null;
  const sliderValueDisplay = document.getElementById('slider-value-display');
  const sliderTrackFill = document.getElementById('slider-track-fill');
  
  const recommendationCard = document.getElementById('calculator-recommendation-card');
  const recommendationBadge = document.getElementById('recommendation-badge');
  const recommendationTitle = document.getElementById('recommendation-title');
  const recommendationDesc = document.getElementById('recommendation-desc');
  const recommendationHighlights = document.getElementById('recommendation-highlights');
  const recommendationCta = document.getElementById('recommendation-cta');
  
  const cardFree = document.getElementById('plan-card-free');
  const cardPro = document.getElementById('plan-card-pro');
  const wrapperFree = document.getElementById('plan-card-wrapper-free');
  const wrapperPro = document.getElementById('plan-card-wrapper-pro');
  
  function updateSlider() {
    if (!dealSlider) return;
    const val = parseInt(dealSlider.value);
    if (sliderValueDisplay) sliderValueDisplay.textContent = val >= 100 ? '100+' : val.toString();
    
    // Exact track fill percentage alignment calculation
    const percent = ((val - 1) / 99) * 100;
    if (sliderTrackFill) sliderTrackFill.style.width = `${percent}%`;
    
    if (val <= 6) {
      // FREE Recommendation State
      if (recommendationCard) {
        recommendationCard.className = 'p-6 md:p-8 bg-accent/5 flex flex-col justify-between items-start text-left min-h-[260px] transition-all duration-300 relative overflow-hidden md:col-span-5';
      }
      if (recommendationBadge) {
        recommendationBadge.textContent = 'FREE TIER';
        recommendationBadge.className = 'inline-block px-2.5 py-0.5 rounded-md text-[10px] font-black text-white bg-accent select-none';
      }
      if (recommendationTitle) recommendationTitle.textContent = 'FREE PLAN';
      if (recommendationDesc) {
        recommendationDesc.textContent = 'เหมาะสำหรับร้านค้าเริ่มต้นทดลองระบบ หรือจัดโปรโมชันร้านแบบพื้นฐาน';
      }
      if (recommendationHighlights) {
        recommendationHighlights.innerHTML = `
          <li class="flex items-center gap-1.5 text-[10px] font-bold text-text-secondary">
            <span class="text-emerald-500">✓</span> <span>จัดดีลพร้อมกันสูงสุด 6 ดีล</span>
          </li>
          <li class="flex items-center gap-1.5 text-[10px] font-bold text-text-secondary">
            <span class="text-emerald-500">✓</span> <span>แชร์ QR Code หน้าร้าน</span>
          </li>
        `;
      }
      if (recommendationCta) {
        recommendationCta.innerHTML = '<span>สมัครร้านค้าแพลนฟรี</span> <span>→</span>';
        recommendationCta.setAttribute('data-target-tier', 'free');
        recommendationCta.className = 'mt-6 w-full py-3 px-4 rounded-xl text-[10px] font-black text-center text-white bg-accent hover:bg-accent/90 shadow-md shadow-accent/15 hover:scale-[1.02] active:scale-95 transition-all select-none z-10 flex items-center justify-center gap-1 cursor-pointer';
      }
      
      // Highlight Free Card, dim Pro slightly
      if (cardFree) cardFree.className = 'relative rounded-[24px] p-8 transition-all duration-300 flex flex-col justify-between h-full hover-shine animate-slide-up bg-card-bg/75 border-2 border-primary shadow-xl';
      if (cardPro) cardPro.className = 'relative rounded-[24px] p-8 transition-all duration-300 flex flex-col justify-between h-full hover-shine animate-slide-up bg-card-bg/65 border border-border/15 backdrop-blur-md shadow-sm opacity-85';
      
      // Scale Free wrapper, reset Pro wrapper
      if (wrapperFree) wrapperFree.className = 'relative z-20 scale-105 transition-all duration-300';
      if (wrapperPro) wrapperPro.className = 'relative z-10 scale-100 transition-all duration-300 opacity-80';
    } else {
      // PRO Recommendation State
      if (recommendationCard) {
        recommendationCard.className = 'p-6 md:p-8 bg-primary/5 flex flex-col justify-between items-start text-left min-h-[260px] transition-all duration-300 relative overflow-hidden md:col-span-5';
      }
      if (recommendationBadge) {
        recommendationBadge.textContent = 'RECOMMENDED';
        recommendationBadge.className = 'inline-block px-2.5 py-0.5 rounded-md text-[10px] font-black text-white bg-primary select-none';
      }
      if (recommendationTitle) recommendationTitle.textContent = 'PRO PLAN';
      if (recommendationDesc) {
        recommendationDesc.textContent = 'จัดเต็มด้วยเครื่องมือการตลาดและการวิเคราะห์ครบวงจร ดันยอดขายพุ่งทะยาน';
      }
      if (recommendationHighlights) {
        recommendationHighlights.innerHTML = `
          <li class="flex items-center gap-1.5 text-[10px] font-bold text-text-secondary">
            <span class="text-emerald-500">✓</span> <span>จัดดีลพร้อมกันสูงสุด 100 ดีล</span>
          </li>
          <li class="flex items-center gap-1.5 text-[10px] font-bold text-text-secondary">
            <span class="text-emerald-500">✓</span> <span>ระบบสถิติเชิงลึก & ตั้งเวลาดีล</span>
          </li>
        `;
      }
      if (recommendationCta) {
        recommendationCta.innerHTML = '<span>ติดต่อเพื่ออัปเกรด Pro</span> <span>💎</span>';
        recommendationCta.setAttribute('data-target-tier', 'pro');
        recommendationCta.className = 'mt-6 w-full py-3 px-4 rounded-xl text-[10px] font-black text-center text-white bg-primary hover:bg-primary-hover shadow-md shadow-primary/15 hover:scale-[1.02] active:scale-95 transition-all select-none z-10 flex items-center justify-center gap-1 cursor-pointer';
      }

      // Highlight Pro Card, dim Free
      if (cardPro) cardPro.className = 'relative rounded-[24px] p-8 transition-all duration-300 flex flex-col justify-between h-full hover-shine animate-slide-up bg-card-bg/75 border-2 border-primary shadow-xl';
      if (cardFree) cardFree.className = 'relative rounded-[24px] p-8 transition-all duration-300 flex flex-col justify-between h-full hover-shine animate-slide-up bg-card-bg/65 border border-border/15 backdrop-blur-md shadow-sm opacity-85';
      
      // Scale Pro wrapper, reset Free wrapper
      if (wrapperPro) wrapperPro.className = 'relative z-20 scale-105 transition-all duration-300';
      if (wrapperFree) wrapperFree.className = 'relative z-10 scale-100 transition-all duration-300 opacity-80';
    }
  }

  dealSlider?.addEventListener('input', updateSlider);
  // Run on initial load
  updateSlider();

  // Bind click event on Recommendation CTA
  recommendationCta?.addEventListener('click', () => {
    const tier = recommendationCta.getAttribute('data-target-tier');
    if (tier === 'free') {
      window.location.href = '/auth/register';
    } else if (tier === 'pro') {
      modal?.classList.remove('hidden');
      modal?.classList.add('flex');
    }
  });

  // Comparison Table Expand/Collapse Logic
  const toggleComparisonBtn = document.getElementById('toggle-comparison-btn');
  const comparisonTableWrapper = document.getElementById('comparison-table-wrapper');
  const comparisonChevron = document.getElementById('comparison-chevron');
  const comparisonBtnText = document.getElementById('comparison-btn-text');
  
  let isComparisonOpen = false;
  
  toggleComparisonBtn?.addEventListener('click', () => {
    isComparisonOpen = !isComparisonOpen;
    if (isComparisonOpen) {
      comparisonTableWrapper?.classList.remove('max-h-0', 'invisible', 'opacity-0');
      comparisonTableWrapper?.classList.add('max-h-[800px]', 'opacity-100');
      comparisonChevron?.classList.add('rotate-180');
      if (comparisonBtnText) comparisonBtnText.textContent = 'ซ่อนตารางเปรียบเทียบฟีเจอร์';
    } else {
      comparisonTableWrapper?.classList.add('max-h-0', 'invisible', 'opacity-0');
      comparisonTableWrapper?.classList.remove('max-h-[800px]', 'opacity-100');
      comparisonChevron?.classList.remove('rotate-180');
      if (comparisonBtnText) comparisonBtnText.textContent = 'ดูตารางเปรียบเทียบฟีเจอร์อย่างละเอียด';
    }
  });

  // FAQ Accordion Stack Logic
  const faqToggleBtns = document.querySelectorAll('.faq-toggle-btn');
  
  faqToggleBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const item = btn.closest('.faq-item');
      const answerWrapper = item?.querySelector('.faq-answer-wrapper');
      const chevron = btn.querySelector('.faq-chevron');
      const isOpen = answerWrapper?.classList.contains('max-h-[500px]');
      
      // Close all FAQs first
      document.querySelectorAll('.faq-item').forEach(otherItem => {
        if (otherItem !== item) {
          const wrapper = otherItem.querySelector('.faq-answer-wrapper');
          wrapper?.classList.remove('max-h-[500px]');
          wrapper?.classList.add('max-h-0');
          otherItem.querySelector('.faq-chevron')?.classList.remove('rotate-180');
          otherItem.classList.remove('border-primary/30', 'bg-primary/5', 'shadow-sm');
        }
      });
      
      // Toggle current
      if (isOpen) {
        answerWrapper?.classList.remove('max-h-[500px]');
        answerWrapper?.classList.add('max-h-0');
        chevron?.classList.remove('rotate-180');
        item?.classList.remove('border-primary/30', 'bg-primary/5', 'shadow-sm');
      } else {
        answerWrapper?.classList.remove('max-h-0');
        answerWrapper?.classList.add('max-h-[500px]');
        chevron?.classList.add('rotate-180');
        item?.classList.add('border-primary/30', 'bg-primary/5', 'shadow-sm');
      }
    });
  });
</script>

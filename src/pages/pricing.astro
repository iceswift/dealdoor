---
// src/pages/pricing.astro

import BaseLayout from '../layouts/BaseLayout.astro';
import { PRICING_PLANS } from '../lib/tiers';
import Icon from '../components/icons/index.astro';
---

<BaseLayout title="ราคา">
  {/* Outer Page Wrapper (Pulled up under Top Tabbar with brand gradient) */}
  <div class="relative w-full overflow-hidden mt-[-110px] pt-36 pb-20 bg-gradient-to-b from-primary-light/45 via-bg to-bg">
    {/* Global Background Mesh Effects (Full Screen Width, No Clipping) */}
    <div class="bg-mesh bg-mesh-coral absolute -top-40 left-1/4 opacity-15 dark:opacity-10 pointer-events-none"></div>
    <div class="bg-mesh bg-mesh-teal absolute bottom-10 right-1/4 opacity-15 dark:opacity-10 pointer-events-none"></div>

    <div class="mx-auto max-w-5xl px-4 relative z-10">
      
      {/* Header Section */}
      <div class="text-center animate-slide-up relative z-10 mt-6">
        <span class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full bg-primary/10 text-primary border border-primary/20 text-[10px] font-black uppercase tracking-wider shadow-sm mb-3">
          แผนราคาที่คุ้มค่า
        </span>
        <h1 class="text-4xl font-extrabold tracking-tight text-secondary md:text-5xl lg:text-6xl">
          เลือกแพลนที่เหมาะกับ <span class="text-gradient">ร้านค้าของคุณ</span>
        </h1>
        <p class="mt-4 text-sm font-semibold text-text-secondary max-w-2xl mx-auto">
          เริ่มต้นฟรี อัปเกรดเมื่อพร้อม พร้อมฟีเจอร์พรีเมียมที่จะช่วยดันยอดขายของร้านคุณให้พุ่งทะยาน
        </p>

        {/* Billing Toggle Component */}
        <div class="mt-10 flex items-center justify-center gap-4 relative z-10">
          <span id="billing-monthly-label" class="text-xs font-black text-secondary transition-colors duration-200">รายเดือน</span>
          <button id="billing-toggle-btn" class="relative inline-flex h-7 w-14 items-center rounded-full bg-border dark:bg-bg-tertiary transition-colors duration-200 focus:outline-none p-0.5 cursor-pointer" role="switch" aria-checked="false" aria-label="สลับประเภทการเรียกเก็บเงิน">
            <span id="toggle-indicator" class="pointer-events-none inline-block h-6 w-6 transform rounded-full bg-white shadow-md transition duration-200 ease-in-out translate-x-0"></span>
          </button>
          <span id="billing-yearly-label" class="text-xs font-bold text-text-secondary transition-colors duration-200 flex items-center gap-1.5">
            รายปี
            <span class="inline-flex items-center justify-center rounded-md bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 px-2 py-0.5 animate-pulse text-[9px] font-black">เซฟ 30%</span>
          </span>
        </div>
      </div>

      {/* Interactive Deal Calculator (Redesigned as SaaS Split-Pane Card) */}
      <div class="mt-12 max-w-3xl mx-auto rounded-[28px] bg-card-bg/60 border border-border/15 backdrop-blur-md overflow-hidden shadow-xl animate-slide-up stagger-1 relative z-10">
        <div class="grid grid-cols-1 md:grid-cols-12 divide-y md:divide-y-0 md:divide-x divide-border/15">
          
          {/* LEFT SIDE: Inputs / Slider Controls (md:col-span-7) */}
          <div class="p-6 md:p-8 space-y-6 flex flex-col justify-between md:col-span-7">
            <div class="space-y-2 text-left">
              <div class="flex items-center select-none">
                <span class="text-[9px] font-black uppercase tracking-wider text-text-tertiary">Smart Calculator</span>
              </div>
              <h3 class="text-lg font-extrabold text-secondary tracking-tight">คำนวณจำนวนดีลของร้านคุณ</h3>
              <p class="text-xs font-bold text-text-secondary leading-relaxed">เลื่อนแถบประเมินจำนวนดีลที่ทางร้านต้องการเปิดใช้งานพร้อมกันในช่วงเวลาปกติ เพื่อหาแผนบริการที่ประหยัดที่สุด</p>
            </div>

            {/* The Slider and Current Value display */}
            <div class="space-y-6 pt-4">
              <div class="flex items-baseline justify-between">
                <span class="text-xs font-black text-text-tertiary">จำนวนดีลที่ต้องการจัด</span>
                <div class="flex items-baseline gap-1">
                  <span id="slider-value-display" class="text-4xl font-black text-secondary tracking-tight">6</span>
                  <span class="text-xs font-black text-text-secondary">ดีลพร้อมกัน</span>
                </div>
              </div>

              <div class="relative w-full h-8 flex items-center">
                {/* Track */}
                <div class="absolute left-0 right-0 h-1.5 bg-bg-tertiary dark:bg-bg-tertiary/40 rounded-lg"></div>
                {/* Fill */}
                <div id="slider-track-fill" class="absolute left-0 h-1.5 bg-primary rounded-lg pointer-events-none" style="width: 5%;"></div>
                {/* Input */}
                <input 
                  type="range" 
                  id="deal-slider" 
                  min="1" 
                  max="100" 
                  value="6" 
                  class="absolute inset-x-0 w-full h-1.5 bg-transparent appearance-none cursor-pointer focus:outline-none 
                         [&::-webkit-slider-runnable-track]:bg-transparent 
                         [&::-webkit-slider-thumb]:appearance-none 
                         [&::-webkit-slider-thumb]:h-5 
                         [&::-webkit-slider-thumb]:w-5 
                         [&::-webkit-slider-thumb]:rounded-full 
                         [&::-webkit-slider-thumb]:bg-primary 
                         [&::-webkit-slider-thumb]:border-2 
                         [&::-webkit-slider-thumb]:border-white 
                         [&::-webkit-slider-thumb]:shadow-md 
                         [&::-webkit-slider-thumb]:transition-all 
                         [&::-webkit-slider-thumb]:duration-150 
                         [&::-webkit-slider-thumb]:hover:scale-110 
                         [&::-moz-range-track]:bg-transparent
                         [&::-moz-range-thumb]:h-5 
                         [&::-moz-range-thumb]:w-5 
                         [&::-moz-range-thumb]:rounded-full 
                         [&::-moz-range-thumb]:bg-primary 
                         [&::-moz-range-thumb]:border-2 
                         [&::-moz-range-thumb]:border-white 
                         [&::-moz-range-thumb]:shadow-md 
                         [&::-moz-range-thumb]:transition-all 
                         [&::-moz-range-thumb]:duration-150 
                         [&::-moz-range-thumb]:hover:scale-110" 
                />
              </div>

              <div class="flex justify-between text-[10px] font-black text-text-tertiary select-none uppercase tracking-wider">
                <span>1 ดีล</span>
                <span>100 ดีลขึ้นไป</span>
              </div>
            </div>
          </div>

          {/* RIGHT SIDE: Dynamic Recommendation Ticket (md:col-span-5) */}
          <div id="calculator-recommendation-card" class="p-6 md:p-8 bg-accent/5 flex flex-col justify-between items-start text-left min-h-[260px] transition-all duration-300 relative overflow-hidden md:col-span-5">
            {/* Decorative corner tag or pattern */}
            <div class="absolute -right-6 -top-6 h-16 w-16 rounded-full bg-primary/5 blur-md"></div>
            
            <div class="space-y-4 w-full relative z-10">
              <div class="flex flex-wrap items-center gap-2">
                <span class="text-[9px] font-black uppercase tracking-wider text-text-tertiary">แพลนที่ระบบแนะนำ</span>
                <div id="recommendation-badge" class="inline-block px-2.5 py-0.5 rounded-md text-[10px] font-black text-white bg-accent select-none">
                  FREE TIER
                </div>
              </div>
              
              <div class="space-y-1.5">
                <h4 id="recommendation-title" class="text-xl font-extrabold text-secondary tracking-tight">FREE PLAN</h4>
                <p id="recommendation-desc" class="text-[11px] font-bold text-text-secondary leading-relaxed">
                  เหมาะสำหรับร้านค้าเริ่มต้นทดลองระบบ หรือจัดโปรโมชันร้านแบบพื้นฐาน
                </p>
              </div>

              <ul id="recommendation-highlights" class="space-y-2 pt-3.5 border-t border-border/10">
                <li class="flex items-center gap-1.5 text-[10px] font-bold text-text-secondary">
                  <span class="text-emerald-500">✓</span> <span>จัดดีลพร้อมกันสูงสุด 6 ดีล</span>
                </li>
                <li class="flex items-center gap-1.5 text-[10px] font-bold text-text-secondary">
                  <span class="text-emerald-500">✓</span> <span>แชร์ QR Code หน้าร้าน</span>
                </li>
              </ul>
            </div>

            <button id="recommendation-cta" class="mt-6 w-full py-3 px-4 rounded-xl text-[10px] font-black text-center text-white bg-accent hover:bg-accent/90 shadow-md shadow-accent/15 hover:scale-[1.02] active:scale-95 transition-all select-none z-10 flex items-center justify-center gap-1 cursor-pointer">
              <span>สมัครร้านค้าแพลนฟรี</span>
              <span>→</span>
            </button>
          </div>

        </div>
      </div>

      {/* Pricing Cards Grid */}
      <div class="mt-16 py-8 grid gap-10 md:grid-cols-2 lg:max-w-4xl lg:mx-auto relative z-10">
        {PRICING_PLANS.map((plan, planIdx) => (
          <div
            id={`plan-card-wrapper-${plan.id}`}
            class:list={[
              'relative transition-all duration-300',
              plan.id === 'free' ? 'stagger-2 z-10' : 'stagger-3 scale-105 z-20',
            ]}
          >
            {/* Popular Badge (Placed on Outer Wrapper so it is never clipped by inner overflow-hidden) */}
            {plan.isPopular && (
              <div class="absolute -top-4 left-1/2 -translate-x-1/2 z-30">
                <span class="rounded-full bg-gradient-to-r from-primary to-orange-500 px-4.5 py-1 text-xs font-black text-white shadow-md select-none">
                  แนะนำ (Pro)
                </span>
              </div>
            )}

            <div
              id={`plan-card-${plan.id}`}
              class:list={[
                'relative rounded-[24px] p-8 transition-all duration-300 flex flex-col justify-between h-full hover-shine animate-slide-up',
                plan.isPopular
                  ? 'bg-card-bg/75 border-2 border-primary shadow-xl dark:shadow-primary/10'
                  : 'bg-card-bg/65 border border-border/15 backdrop-blur-md shadow-sm',
              ]}
            >
              <div>
                {/* Plan Header */}
                <div class="text-center">
                  <h2 class="text-xl font-extrabold text-secondary">{plan.nameTh}</h2>
                  <p class="mt-0.5 text-xs font-bold text-text-secondary">{plan.name} Plan</p>
                  <p class="mt-2 text-[11px] font-bold text-text-tertiary">
                    {plan.id === 'free' 
                      ? 'ลงโปรโมชันขั้นพื้นฐานเพื่อเปิดร้านค้าออนไลน์' 
                      : 'จัดเต็มด้วยเครื่องมือการตลาดและการวิเคราะห์ครบวงจร'}
                  </p>
                </div>

                {/* Price */}
                <div class="mt-6 text-center">
                  <div class="flex items-baseline justify-center gap-0.5">
                    <span class="text-2xl font-black text-secondary align-top mt-1">฿</span>
                    <span class="text-5xl font-black text-secondary tracking-tight price-display" data-plan-id={plan.id}>
                      {plan.priceMonthly}
                    </span>
                    <span class="text-text-secondary text-xs font-bold billing-period-display">/เดือน</span>
                  </div>
                  <p class="mt-2 text-[10px] text-text-tertiary font-bold h-5 price-sub-display" data-plan-id={plan.id}>
                    {plan.price === 0 ? 'ฟรีตลอดไป ไม่มีเงื่อนไขแอบแฝง' : 'ชำระรายเดือนตามจริง'}
                  </p>
                </div>

                {/* Features List Container */}
                <div class="mx-auto w-full max-w-[290px] mt-8 border-t border-border/15 pt-6 flex-grow">
                  <ul class="space-y-4">
                    {plan.featuresTh.map((feature) => (
                      <li class="flex items-start gap-3">
                        <span class="flex-shrink-0 inline-flex items-center justify-center h-5 w-5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 mt-0.5">
                          <Icon name="check" class="h-3 w-3" />
                        </span>
                        <span class="text-xs text-text-secondary leading-normal text-left font-bold">{feature}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>

              {/* CTA Button */}
              <div class="mt-8">
                {plan.id === 'free' ? (
                  <a
                    href="/auth/register"
                    class="btn btn-secondary w-full min-h-[44px] rounded-xl text-xs font-black shadow-sm flex items-center justify-center gap-1.5 cursor-pointer"
                  >
                    เริ่มต้นใช้งานฟรี
                    <Icon name="arrow-right" class="h-4 w-4" />
                  </a>
                ) : (
                  <button
                    id="upgrade-pro-btn"
                    class="btn btn-primary w-full min-h-[44px] rounded-xl text-xs font-black shadow-md flex items-center justify-center gap-1.5 cursor-pointer"
                    data-tier={plan.id}
                  >
                    <Icon name="diamond" class="h-4 w-4 animate-pulse" />
                    ติดต่อเพื่ออัปเกรด
                  </button>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>

      <section class="mt-14 border-y border-border/20 py-10 text-left">
        <div class="max-w-3xl">
          <span class="inline-flex items-center gap-1.5 text-[10px] font-black uppercase tracking-wider text-primary">
            <Icon name="rocket" class="h-3.5 w-3.5" /> Deal Boost
          </span>
          <h2 class="mt-2 text-2xl font-extrabold text-secondary">เพิ่มการมองเห็นดีลอย่างชัดเจนและโปร่งใส</h2>
          <p class="mt-2 max-w-2xl text-xs font-bold leading-relaxed text-text-secondary">
            Boost ช่วยเพิ่มโอกาสให้ดีลปรากฏในพื้นที่โปรโมตที่เกี่ยวข้อง โดยจะแสดงป้าย “โปรโมต” เสมอ และไม่ทำให้ผลค้นหาที่ไม่ตรงกับความสนใจของลูกค้าถูกแทรกขึ้นมา
          </p>
        </div>
        <div class="mt-8 grid gap-6 md:grid-cols-3 md:divide-x md:divide-border/20">
          <div class="pr-6">
            <p class="text-sm font-black text-secondary">1 เครดิต = 24 ชั่วโมง</p>
            <p class="mt-1 text-[11px] font-bold leading-relaxed text-text-secondary">ใช้เครดิตตามระยะเวลา Boost ที่เลือก โดยเปิดใช้งานได้สูงสุด 7 วันต่อครั้ง</p>
          </div>
          <div class="px-0 md:px-6">
            <p class="text-sm font-black text-secondary">สิทธิ์จากแผน</p>
            <p class="mt-1 text-[11px] font-bold leading-relaxed text-text-secondary">Free ไม่มีเครดิตรวมในแผน ส่วน Pro ได้ 4 เครดิตต่อรอบบิล และ Boost พร้อมกันได้สูงสุด 2 ดีล</p>
          </div>
          <div class="pl-0 md:pl-6">
            <p class="text-sm font-black text-secondary">เครดิตซื้อเพิ่ม</p>
            <p class="mt-1 text-[11px] font-bold leading-relaxed text-text-secondary">ทุกแผนจะซื้อเครดิตเพิ่มได้เมื่อเปิดระบบชำระเงิน เครดิตซื้อเพิ่มมีอายุ 180 วัน และไม่ทบรวมกับเครดิตจากแผน</p>
          </div>
        </div>
        <p class="mt-7 border-t border-border/15 pt-5 text-[11px] font-bold leading-relaxed text-text-tertiary">
          เครดิตจากแผนจะรีเซ็ตเมื่อเริ่มรอบบิลใหม่และไม่ทบยอด ดีลที่หมดอายุ ปิดใช้งาน สิทธิ์เต็ม หรืออยู่ระหว่างการตรวจสอบ จะไม่สามารถเริ่ม Boost ได้
        </p>
      </section>

      {/* Detailed Feature Comparison Section */}
      <div class="mt-16 text-center relative z-10">
        <button id="toggle-comparison-btn" class="py-2.5 px-6 rounded-xl border border-border/30 bg-card-bg text-xs font-black text-secondary hover:border-primary/25 hover:text-primary transition-all flex items-center gap-2 mx-auto cursor-pointer">
          <span id="comparison-btn-text">ดูตารางเปรียบเทียบฟีเจอร์อย่างละเอียด</span>
          <Icon name="chevron-down" id="comparison-chevron" class="h-4 w-4 transition-transform duration-300" />
        </button>
        
        <div id="comparison-table-wrapper" class="max-h-0 overflow-hidden invisible opacity-0 mt-8 text-left transition-all duration-500 ease-in-out">
          <div class="rounded-[24px] border border-border/15 bg-card-bg/60 backdrop-blur-md p-6 overflow-x-auto shadow-sm">
            <table class="w-full text-xs table-fixed min-w-[600px]">
              <thead>
                <tr class="border-b border-border/15 text-secondary text-sm">
                  <th class="py-4 px-6 text-left font-black w-1/2">ฟีเจอร์เด่น</th>
                  <th class="py-4 px-6 text-center font-black w-1/4">ฟรี (Free)</th>
                  <th class="py-4 px-6 text-center font-black w-1/4 text-primary">โปร (Pro)</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-border/10 font-bold text-text-secondary">
                <tr class="hover:bg-bg-tertiary/20 transition-colors">
                  <td class="py-4 px-6 text-secondary font-black">
                    <div class="flex items-center gap-2">
                      <span class="text-primary"><Icon name="store" class="h-4 w-4" /></span>
                      จำนวนหน้าร้านต่อบัญชี
                    </div>
                  </td>
                  <td class="py-4 px-6 text-center">1 หน้าร้าน</td>
                  <td class="py-4 px-6 text-center text-primary font-black">1 หน้าร้าน</td>
                </tr>
                <tr class="hover:bg-bg-tertiary/20 transition-colors">
                  <td class="py-4 px-6 text-secondary font-black">
                    <div class="flex items-center gap-2">
                      <span class="text-primary"><Icon name="rocket" class="h-4 w-4" /></span>
                      เครดิต Boost ต่อรอบบิล
                    </div>
                  </td>
                  <td class="py-4 px-6 text-center">0 เครดิต</td>
                  <td class="py-4 px-6 text-center text-primary font-black">4 เครดิต</td>
                </tr>
                <tr class="hover:bg-bg-tertiary/20 transition-colors">
                  <td class="py-4 px-6 text-secondary font-black">
                    <div class="flex items-center gap-2">
                      <span class="text-primary"><Icon name="rocket" class="h-4 w-4" /></span>
                      จำนวนดีลที่ Boost พร้อมกัน
                    </div>
                  </td>
                  <td class="py-4 px-6 text-center">1 ดีล</td>
                  <td class="py-4 px-6 text-center text-primary font-black">2 ดีล</td>
                </tr>
                <tr class="hover:bg-bg-tertiary/20 transition-colors">
                  <td class="py-4 px-6 text-secondary font-black">
                    <div class="flex items-center gap-2">
                      <span class="text-primary"><Icon name="fire" class="h-4 w-4" /></span>
                      จำนวนดีลโปรโมชันที่เปิดพร้อมกัน
                    </div>
                  </td>
                  <td class="py-4 px-6 text-center">สูงสุด 6 ดีล</td>
                  <td class="py-4 px-6 text-center text-primary font-black">สูงสุด 100 ดีล</td>
                </tr>
                <tr class="hover:bg-bg-tertiary/20 transition-colors">
                  <td class="py-4 px-6 text-secondary font-black">
                    <div class="flex items-center gap-2">
                      <span class="text-primary"><Icon name="menu" class="h-4 w-4" /></span>
                      รายการอาหาร/สินค้าในเมนูร้าน
                    </div>
                  </td>
                  <td class="py-4 px-6 text-center">สูงสุด 10 รายการ</td>
                  <td class="py-4 px-6 text-center text-primary font-black">สูงสุด 100 รายการ</td>
                </tr>
                <tr class="hover:bg-bg-tertiary/20 transition-colors">
                  <td class="py-4 px-6 text-secondary font-black">
                    <div class="flex items-center gap-2">
                      <span class="text-primary"><Icon name="qrcode" class="h-4 w-4" /></span>
                      QR Code คุณภาพสูงสำหรับแชร์ร้าน
                    </div>
                  </td>
                  <td class="py-4 px-6 text-center">
                    <span class="inline-flex items-center justify-center h-5 w-5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400">
                      <Icon name="check" class="h-3.5 w-3.5" />
                    </span>
                  </td>
                  <td class="py-4 px-6 text-center">
                    <span class="inline-flex items-center justify-center h-5 w-5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400">
                      <Icon name="check" class="h-3.5 w-3.5" />
                    </span>
                  </td>
                </tr>
                <tr class="hover:bg-bg-tertiary/20 transition-colors">
                  <td class="py-4 px-6 text-secondary font-black">
                    <div class="flex items-center gap-2">
                      <span class="text-primary"><Icon name="chart" class="h-4 w-4" /></span>
                      ระบบวิเคราะห์ข้อมูลสถิติ (Analytics)
                    </div>
                  </td>
                  <td class="py-4 px-6 text-center">
                    <span class="inline-flex items-center justify-center h-5 w-5 rounded-full bg-rose-500/10 text-rose-600 dark:text-rose-400">
                      <Icon name="x" class="h-3 w-3" />
                    </span>
                  </td>
                  <td class="py-4 px-6 text-center">
                    <span class="inline-flex items-center justify-center h-5 w-5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400">
                      <Icon name="check" class="h-3.5 w-3.5" />
                    </span>
                  </td>
                </tr>
                <tr class="hover:bg-bg-tertiary/20 transition-colors">
                  <td class="py-4 px-6 text-secondary font-black">
                    <div class="flex items-center gap-2">

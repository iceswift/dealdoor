---
// src/pages/admin/accessibility.astro

import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Accessibility Audit">
  <div class="mx-auto max-w-3xl px-4 py-8">
    <h1 class="text-2xl font-bold text-secondary">♿ Accessibility Audit</h1>
    <p class="mt-2 text-text-secondary">ตรวจสอบการเข้าถึงของแอปพลิเคชัน</p>

    <div class="mt-8 space-y-6">
      {/* Color Contrast */}
      <div class="rounded-xl border border-border bg-bg p-6">
        <h2 class="text-lg font-semibold text-secondary">🎨 Color Contrast</h2>
        <div class="mt-4 space-y-3">
          <div class="flex items-center justify-between">
            <span class="text-sm text-text-primary">Primary on White</span>
            <span class="badge bg-green-100 text-green-700">✓ AA (4.6:1)</span>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-sm text-text-secondary">Secondary on White</span>
            <span class="badge bg-green-100 text-green-700">✓ AA (5.7:1)</span>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-sm text-text-primary">White on Primary</span>
            <span class="badge bg-green-100 text-green-700">✓ AA (4.6:1)</span>
          </div>
        </div>
      </div>

      {/* Keyboard Navigation */}
      <div class="rounded-xl border border-border bg-bg p-6">
        <h2 class="text-lg font-semibold text-secondary">⌨️ Keyboard Navigation</h2>
        <div class="mt-4 space-y-3">
          <div class="flex items-center justify-between">
            <span class="text-sm text-text-primary">Skip link</span>
            <span class="badge bg-green-100 text-green-700">✓ Implemented</span>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-sm text-text-primary">Focus visible</span>
            <span class="badge bg-green-100 text-green-700">✓ Implemented</span>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-sm text-text-primary">Modal focus trap</span>
            <span class="badge bg-green-100 text-green-700">✓ Implemented</span>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-sm text-text-primary">Arrow key navigation</span>
            <span class="badge bg-green-100 text-green-700">✓ Implemented</span>
          </div>
        </div>
      </div>

      {/* ARIA */}
      <div class="rounded-xl border border-border bg-bg p-6">
        <h2 class="text-lg font-semibold text-secondary">🏷️ ARIA Attributes</h2>
        <div class="mt-4 space-y-3">
          <div class="flex items-center justify-between">
            <span class="text-sm text-text-primary">Dialog modals</span>
            <span class="badge bg-green-100 text-green-700">✓ role="dialog"</span>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-sm text-text-primary">Alerts</span>
            <span class="badge bg-green-100 text-green-700">✓ role="alert"</span>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-sm text-text-primary">Status updates</span>
            <span class="badge bg-green-100 text-green-700">✓ aria-live</span>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-sm text-text-primary">Form labels</span>
            <span class="badge bg-green-100 text-green-700">✓ Associated</span>
          </div>
        </div>
      </div>

      {/* Reduced Motion */}
      <div class="rounded-xl border border-border bg-bg p-6">
        <h2 class="text-lg font-semibold text-secondary">🎬 Reduced Motion</h2>
        <div class="mt-4 space-y-3">
          <div class="flex items-center justify-between">
            <span class="text-sm text-text-primary">prefers-reduced-motion</span>
            <span class="badge bg-green-100 text-green-700">✓ Supported</span>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-sm text-text-primary">Animation fallbacks</span>
            <span class="badge bg-green-100 text-green-700">✓ Implemented</span>
          </div>
        </div>
      </div>

      {/* Screen Reader */}
      <div class="rounded-xl border border-border bg-bg p-6">
        <h2 class="text-lg font-semibold text-secondary">🔊 Screen Reader Support</h2>
        <div class="mt-4 space-y-3">
          <div class="flex items-center justify-between">
            <span class="text-sm text-text-primary">Semantic HTML</span>
            <span class="badge bg-green-100 text-green-700">✓ Used</span>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-sm text-text-primary">Alt text</span>
            <span class="badge bg-green-100 text-green-700">✓ Provided</span>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-sm text-text-primary">Headings hierarchy</span>
            <span class="badge bg-green-100 text-green-700">✓ Correct</span>
          </div>
        </div>
      </div>

      {/* Test Buttons */}
      <div class="rounded-xl border border-border bg-bg p-6">
        <h2 class="text-lg font-semibold text-secondary">🧪 Test Features</h2>
        <div class="mt-4 flex flex-wrap gap-3">
          <button
            onclick="document.getElementById('test-modal').classList.remove('hidden')"
            class="btn btn-primary"
          >
            Test Modal
          </button>
          <button
            onclick="announce('Test announcement', 'polite')"
            class="btn btn-secondary"
          >
            Test Announcement
          </button>
          <button
            onclick="document.getElementById('test-toast').classList.remove('hidden')"
            class="btn btn-secondary"
          >
            Test Toast
          </button>
        </div>
      </div>
    </div>

    {/* Test Modal */}
    <div id="test-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50" role="dialog" aria-modal="true" aria-labelledby="test-modal-title">
      <div class="w-full max-w-sm rounded-2xl bg-bg p-6">
        <h2 id="test-modal-title" class="text-lg font-semibold">Test Modal</h2>
        <p class="mt-2 text-text-secondary">This modal traps focus. Press Escape to close.</p>
        <div class="mt-4 flex gap-2">
          <input type="text" placeholder="Test input" class="input flex-1" />
          <button onclick="document.getElementById('test-modal').classList.add('hidden')" class="btn btn-primary">Close</button>
        </div>
      </div>
    </div>

    {/* Test Toast */}
    <div id="test-toast" class="hidden fixed right-4 top-4 z-50" role="alert">
      <div class="flex items-center gap-3 rounded-lg bg-green-500 px-4 py-3 text-white shadow-lg">
        <span>✅</span>
        <span class="text-sm font-medium">Test toast notification</span>
        <button onclick="document.getElementById('test-toast').classList.add('hidden')" class="ml-2 rounded-full p-1 hover:bg-white/20">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  function announce(message: string, priority: 'polite' | 'assertive' = 'polite') {
    const announcer = document.createElement('div');
    announcer.setAttribute('role', 'status');
    announcer.setAttribute('aria-live', priority);
    announcer.setAttribute('aria-atomic', 'true');
    announcer.className = 'sr-only';
    announcer.textContent = message;
    document.body.appendChild(announcer);
    setTimeout(() => document.body.removeChild(announcer), 1000);
  }

  // Make announce available globally
  (window as any).announce = announce;
</script>

---
// src/pages/index.astro

import BaseLayout from '../layouts/BaseLayout.astro';
import { db } from '../lib/db';
import { shops, deals } from '../../db/schema';
import { eq, and, gte, desc } from 'drizzle-orm';
import { getLangFromUrl, t } from '../i18n';
import { SHOP_CATEGORIES, SHOP_CATEGORY_ICONS, SHOP_CATEGORY_LABELS } from '../lib/constants';
import type { ShopCategory } from '../lib/constants';
import ExploreDealCard from '../components/explore/ExploreDealCard.astro';
import Icon from '../components/icons/index.astro';

const lang = getLangFromUrl(Astro.url);
const common = (key: string) => t(lang, 'common', key);

// ─── BACKEND WORKFLOW: FETCH ALL ACTIVE DEALS FOR CONSUMER FEED ───
const now = new Date();
const activeDeals = await db
  .select({
    deal: deals,
    shop: shops,
  })
  .from(deals)
  .leftJoin(shops, eq(deals.shopId, shops.id))
  .where(and(eq(deals.isActive, true), gte(deals.endDate, now)))
  .orderBy(desc(deals.createdAt))
  .all();

const in7Days = new Date(now.getTime() + 7 * 24 * 60 * 60 * 1000);
const expiringSoon = activeDeals.filter(({ deal }) => {
  const endDate = new Date(deal.endDate);
  return endDate <= in7Days;
});

const dealsByShop = new Map<string, { shop: typeof shops.$inferSelect; deals: typeof deals.$inferSelect[] }>();
activeDeals.forEach(({ deal, shop }) => {
  if (!shop) return;
  if (!dealsByShop.has(shop.id)) {
    dealsByShop.set(shop.id, { shop, deals: [] });
  }
  dealsByShop.get(shop.id)!.deals.push(deal);
});

// Categories match the Explore page shop-category filter.
const categories = [
  { id: 'all', label: 'ทั้งหมด', emoji: '✨' },
  ...SHOP_CATEGORIES.map((cat) => ({
    id: cat,
    label: SHOP_CATEGORY_LABELS[cat],
    emoji: SHOP_CATEGORY_ICONS[cat],
  })),
];
// ──────────────────────────────────────────────────────────────────
---

<BaseLayout title={lang === 'th' ? 'ค้นหาโปรโมชันและดีลคูปองใกล้ตัวคุณ' : 'Explore Promo Coupons & Deals'}>
  <div class="relative min-h-screen pb-20">
    <div class="space-y-8 relative z-10">
      {/* Hero Header & Airbnb-Style Multi-Input Search Capsule */}
      <section class="text-center pt-16 max-w-3xl mx-auto space-y-5 px-4">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-primary/10 text-primary border border-primary/20 text-[10px] font-black uppercase tracking-wider animate-fade-in shadow-sm">
          <span>✨ พอร์ทัลรวมดีลโปรโมชันที่ใหญ่ที่สุด</span>
        </div>
        <h1 class="text-3xl font-extrabold text-secondary tracking-tight md:text-5xl leading-tight">
          ค้นหาดีลและคูปองสุดพิเศษ <span class="text-gradient">รอบตัวคุณ</span> <span class="animate-tag-swing">🏷️</span>
        </h1>
        <p class="text-xs sm:text-sm text-text-secondary font-bold max-w-xl mx-auto leading-relaxed">
          แจกโค้ดส่วนลด โปรโมชัน คาเฟ่ ร้านอาหาร บริการยอดฮิต รวบรวมหน้าร้านของคุณฟรี
        </p>

        {/* Floating Airbnb Search capsule */}
        <div class="pt-6 max-w-2xl mx-auto animate-slide-up stagger-1">
          <div class="glass rounded-3xl sm:rounded-full border border-border/40 shadow-lg flex flex-col sm:flex-row items-center bg-card-bg/75 backdrop-blur-md p-2 divide-y sm:divide-y-0 sm:divide-x divide-border/30">
            
            {/* Location field */}
            <div class="flex-1 w-full flex items-center px-4 py-2.5 gap-2.5 text-left min-w-0">
              <Icon name="map-pin" class="h-4.5 w-4.5 text-primary flex-shrink-0" />
              <div class="min-w-0">
                <p class="text-[9px] font-black text-text-tertiary uppercase tracking-wider leading-none">พิกัดร้าน</p>
                <p class="text-xs font-bold text-secondary truncate mt-0.5 select-none">กรุงเทพฯ และปริมณฑล</p>
              </div>
            </div>

            {/* Category indicator field */}
            <div class="flex-1 w-full flex items-center px-4 py-2.5 gap-2.5 text-left min-w-0">
              <Icon name="tag" class="h-4.5 w-4.5 text-primary flex-shrink-0" />
              <div class="min-w-0">
                <p class="text-[9px] font-black text-text-tertiary uppercase tracking-wider leading-none">ประเภทดีล</p>
                <p class="text-xs font-bold text-secondary truncate mt-0.5 select-none" id="search-cat-label">ทุกประเภท</p>
              </div>
            </div>

            {/* Search keyword input field */}
            <div class="flex-[1.5] w-full flex items-center pl-4 pr-2 py-2 gap-2.5 text-left min-w-0">
              <Icon name="search" class="h-4.5 w-4.5 text-text-tertiary flex-shrink-0" />
              <input 
                type="text" 
                id="search-input" 
                placeholder="พิมพ์ชื่อดีล หรือชื่อร้าน..." 
                class="w-full bg-transparent border-none text-xs focus:ring-0 focus:outline-none text-secondary font-bold placeholder:text-text-tertiary/70 pl-0 py-0 leading-none"
              />
              <button class="h-9 px-6 bg-gradient-to-r from-primary to-orange-500 hover:from-primary/95 hover:to-orange-500/95 text-white rounded-full text-xs font-black shadow-md shadow-primary/20 hover:shadow-lg hover:scale-[1.02] active:scale-95 transition-all cursor-pointer flex items-center justify-center gap-1.5 flex-shrink-0">
                <span>ค้นหา</span>
              </button>
            </div>

          </div>
        </div>
      </section>

      {/* Airbnb-Style Categories Slider */}
      <section class="max-w-4xl mx-auto px-4">
        <div class="flex items-center gap-3 overflow-x-auto no-scrollbar py-3 border-b border-border/30">
          {categories.map((cat) => (
            <button 
              data-cat-id={cat.id} 
              class={`category-chip flex items-center gap-2 px-4.5 py-2.5 rounded-2xl text-xs font-black border transition-all duration-300 whitespace-nowrap cursor-pointer hover:-translate-y-0.5 hover:shadow-sm ${
                cat.id === 'all' 
                  ? 'bg-gradient-to-r from-primary to-orange-500 text-white border-none shadow-md shadow-primary/10' 
                  : 'bg-card-bg/60 text-text-secondary border-border/30 hover:border-primary/20'
              }`}
            >
              <span class="text-sm">{cat.emoji}</span>
              <span>{cat.label}</span>
            </button>
          ))}
        </div>
      </section>

      {/* Merchant Linktree Promo Banner */}
      <section class="max-w-4xl mx-auto px-4">
        <div class="rounded-3xl border border-border/20 bg-card-bg/50 backdrop-blur-md p-6 shadow-sm relative overflow-hidden flex flex-col md:flex-row items-center justify-between gap-6 hover:border-primary/25 transition-colors duration-300">
          <div class="absolute -right-12 -bottom-12 h-32 w-32 rounded-full bg-primary/5 blur-xl"></div>
          <div class="space-y-1.5 z-10 text-center md:text-left">
            <h3 class="text-sm font-black text-secondary flex items-center justify-center md:justify-start gap-2">
              <span class="text-base select-none">👑</span>
              <span>คุณคือเจ้าของร้านค้าใช่ไหม?</span>
            </h3>
            <p class="text-[11px] text-text-secondary font-bold">
              สร้างหน้าโปรโมชันและดีลคูปองแบบรวมลิงก์เดียวเหมือน Linktree ฟรีใน 2 นาที แชร์ลงโซเชียลปังๆ ได้ทันที!
            </p>
          </div>
          <a href="/for-shops" class="btn btn-primary py-2.5 px-6 rounded-xl text-xs font-black shadow-md hover:scale-[1.02] active:scale-95 transition-all shrink-0 z-10">
            <Icon name="rocket" class="h-4.5 w-4.5" />
            <span>สร้างหน้าลิงก์ร้านฟรี</span>
          </a>
        </div>
      </section>

      {/* Expiring Soon Section */}
      {expiringSoon.length > 0 && (
        <section class="home-section max-w-4xl mx-auto px-4" data-section="expiring">
          <div class="flex items-center justify-between border-b border-border/30 pb-3 mb-6">
            <div class="flex items-center gap-2.5">
              <div class="h-8 w-8 rounded-xl bg-amber-500/10 flex items-center justify-center text-amber-500">
                <Icon name="clock" class="h-5 w-5" />
              </div>
              <h2 class="text-lg font-bold text-secondary">ดีลที่ใกล้หมดอายุ (ภายใน 7 วัน)</h2>
            </div>
            <span class="badge border-none bg-amber-500/10 text-amber-600 dark:text-amber-400 font-extrabold" id="expiring-count">
              {expiringSoon.length} คูปอง
            </span>
          </div>

          <div class="home-section-grid grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {expiringSoon.slice(0, 6).map(({ deal, shop }, index) => (
              <div
                class:list={['home-filter-item animate-fade-in', index === 0 && 'sm:col-span-2']}
                data-section="expiring"
                data-shop-category={shop?.category || ''}
                data-title={deal.title.toLowerCase()}
                data-shop-name={shop?.name.toLowerCase() || ''}
                style={`animation-delay: ${index * 0.08}s`}
              >
                {shop && <ExploreDealCard deal={deal} shop={shop} featured={index === 0} />}
              </div>
            ))}
          </div>

          <div class="home-empty-state hidden border border-dashed border-border/80 p-8 text-center rounded-2xl bg-bg-secondary/40">
            <p class="text-sm font-bold text-secondary">ไม่มีดีลใกล้หมดอายุในประเภทนี้</p>
          </div>
        </section>
      )}

      {/* Active Deals List Section */}
      <section class="home-section max-w-4xl mx-auto px-4" data-section="all">
        <div class="flex items-center justify-between border-b border-border/30 pb-3 mb-6">
          <div class="flex items-center gap-2.5">
            <div class="h-8 w-8 rounded-xl bg-primary/10 flex items-center justify-center text-primary">
              <Icon name="fire" class="h-5 w-5" />
            </div>
            <h2 class="text-lg font-bold text-secondary">ดีลและคูปองทั้งหมด</h2>
          </div>
          <span class="badge border-none bg-primary/10 text-primary font-extrabold" id="all-count">
            {activeDeals.length} ดีล
          </span>
        </div>

        {activeDeals.length > 0 ? (
          <div class="home-section-grid grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {activeDeals.map(({ deal, shop }, index) => (
              <div
                class="home-filter-item animate-fade-in"
                data-section="all"
                data-shop-category={shop?.category || ''}
                data-title={deal.title.toLowerCase()}
                data-shop-name={shop?.name.toLowerCase() || ''}
                style={`animation-delay: ${index * 0.04}s`}
              >
                {shop && <ExploreDealCard deal={deal} shop={shop} />}
              </div>
            ))}
          </div>
        ) : (
          <div class="border border-dashed border-border/80 p-12 text-center rounded-2xl bg-bg-secondary/40">
            <Icon name="search" class="h-10 w-10 mx-auto text-text-tertiary" />
            <h3 class="mt-4 text-base font-bold text-secondary">ไม่มีคูปองที่ใช้งานได้ในขณะนี้</h3>
            <p class="mt-1 text-xs text-text-secondary">ร้านค้ายังไม่ได้ปล่อยโปรโมชันในระบบ</p>
          </div>
        )}

        <div class="home-empty-state hidden border border-dashed border-border/80 p-8 text-center rounded-2xl bg-bg-secondary/40">
          <p class="text-sm font-bold text-secondary">ไม่พบดีลในประเภทนี้</p>
        </div>
      </section>

      {/* Active Shop Partners Section */}
      <section class="home-section max-w-4xl mx-auto px-4" data-section="partners">
        <div class="flex items-center justify-between border-b border-border/30 pb-3 mb-6">
          <div class="flex items-center gap-2.5">
            <div class="h-8 w-8 rounded-xl bg-accent/10 flex items-center justify-center text-accent">
              <Icon name="store" class="h-5 w-5" />
            </div>
            <h2 class="text-lg font-bold text-secondary">ร้านค้าพาร์ทเนอร์ยอดนิยม</h2>
          </div>
          <span class="badge border-none bg-accent/10 text-accent font-extrabold" id="partners-count">
            {dealsByShop.size} ร้านค้า
          </span>
        </div>

        <div class="home-section-grid grid gap-4.5 sm:grid-cols-2 md:grid-cols-3">
          {Array.from(dealsByShop.values()).map(({ shop, deals: shopDeals }, index) => (
            <a
              href={`/${shop.slug}`}
              class="home-filter-item card animate-fade-in group flex flex-col justify-between overflow-hidden bg-card-bg/60 backdrop-blur-sm border border-border/40 hover:border-primary/45 rounded-2xl p-5 hover:shadow-md transition-all duration-300"
              data-section="partners"
              data-shop-category={shop.category}
              data-title={shop.name.toLowerCase()}
              data-shop-name={shop.name.toLowerCase()}
              style={`animation-delay: ${index * 0.08}s`}
            >
              <div class="flex items-center gap-3">
                <div class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-primary/10 to-orange-100/50 text-base font-extrabold text-primary transition-transform group-hover:scale-105">
                  {shop.logoImage ? (
                    <img src={shop.logoImage} alt={shop.name} class="h-full w-full object-cover rounded-xl" />
                  ) : (
                    shop.name.charAt(0)
                  )}
                </div>
                <div class="min-w-0">
                  <h3 class="font-bold text-sm text-secondary truncate group-hover:text-primary transition-colors">
                    {shop.name}
                  </h3>
                  <p class="text-xs text-text-tertiary mt-0.5">
                    {SHOP_CATEGORY_LABELS[shop.category as ShopCategory] || shop.category}
                  </p>
                </div>
              </div>
              <div class="mt-4 pt-3.5 border-t border-border/30 flex items-center justify-between">
                <span class="badge border-none bg-primary/10 text-primary font-bold text-[10px]">
                  {shopDeals.length} ดีลที่ใช้ได้
                </span>
                <span class="text-xs font-bold text-text-tertiary group-hover:text-primary transition-colors flex items-center gap-1">
                  <span>เข้าชมร้าน</span>
                  <Icon name="chevron-right" class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" />
                </span>
              </div>
            </a>
          ))}
        </div>

        <div class="home-empty-state hidden border border-dashed border-border/80 p-8 text-center rounded-2xl bg-bg-secondary/40">
          <p class="text-sm font-bold text-secondary">ไม่พบร้านค้าพาร์ทเนอร์ในประเภทนี้</p>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  /* Custom styling to hide scrollbars */
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  /* Custom price tag swinging animation */
  .animate-tag-swing {
    display: inline-block;
    transform-origin: 50% 10%;
    animation: tagSwing 3.5s ease-in-out infinite;
  }

  @keyframes tagSwing {
    0% { transform: rotate(0deg); }
    15% { transform: rotate(12deg); }
    30% { transform: rotate(-10deg); }
    45% { transform: rotate(8deg); }
    60% { transform: rotate(-6deg); }
    75% { transform: rotate(3deg); }
    90% { transform: rotate(-1deg); }
    100% { transform: rotate(0deg); }
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('search-input');
    const categoryChips = document.querySelectorAll('.category-chip');
    const filterItems = document.querySelectorAll('.home-filter-item');
    const sections = document.querySelectorAll('.home-section');
    const countEls = {
      expiring: document.getElementById('expiring-count'),
      all: document.getElementById('all-count'),
      partners: document.getElementById('partners-count'),
    };
    const searchCatLabel = document.getElementById('search-cat-label');

    let activeCategory = 'all';
    let searchQuery = '';

    const categoryLabels = Object.fromEntries(
      Array.from(categoryChips).map((chip) => [
        chip.getAttribute('data-cat-id') || 'all',
        chip.textContent.trim(),
      ])
    );

    function filterDeals() {
      const counts = { expiring: 0, all: 0, partners: 0 };

      filterItems.forEach((item) => {
        const itemCategory = item.getAttribute('data-shop-category');
        const itemTitle = item.getAttribute('data-title') || '';
        const itemShop = item.getAttribute('data-shop-name') || '';
        const section = item.getAttribute('data-section');

        const categoryMatches = activeCategory === 'all' || itemCategory === activeCategory;
        const searchMatches = !searchQuery || itemTitle.includes(searchQuery) || itemShop.includes(searchQuery);
        const visible = categoryMatches && searchMatches;

        item.classList.toggle('hidden', !visible);

        if (visible && section && counts[section] !== undefined) {
          counts[section] += 1;
        }
      });

      sections.forEach((section) => {
        const sectionName = section.getAttribute('data-section');
        const count = counts[sectionName] || 0;
        const grid = section.querySelector('.home-section-grid');
        const empty = section.querySelector('.home-empty-state');

        if (grid) {
          grid.classList.toggle('hidden', count === 0);
        }

        if (empty) {
          empty.classList.toggle('hidden', count !== 0);
        }
      });

      if (countEls.expiring) {
        countEls.expiring.textContent = `${counts.expiring} คูปอง`;
      }

      if (countEls.all) {
        countEls.all.textContent = `${counts.all} ดีล`;
      }

      if (countEls.partners) {
        countEls.partners.textContent = `${counts.partners} ร้านค้า`;
      }

      if (searchCatLabel) {
        searchCatLabel.textContent = categoryLabels[activeCategory] || 'ทุกประเภท';
      }
    }

    function setActiveCategoryChip(activeChip) {
      categoryChips.forEach((chip) => {
        const isActive = chip === activeChip;
        chip.className = isActive
          ? 'category-chip flex items-center gap-2 px-4.5 py-2.5 rounded-2xl text-xs font-black border transition-all duration-300 whitespace-nowrap cursor-pointer hover:-translate-y-0.5 hover:shadow-sm bg-gradient-to-r from-primary to-orange-500 text-white border-none shadow-md shadow-primary/10'
          : 'category-chip flex items-center gap-2 px-4.5 py-2.5 rounded-2xl text-xs font-black border transition-all duration-300 whitespace-nowrap cursor-pointer hover:-translate-y-0.5 hover:shadow-sm bg-card-bg/60 text-text-secondary border-border/30 hover:border-primary/20';
      });
    }

    // Search bar filter listener
    searchInput?.addEventListener('input', (e) => {
      searchQuery = e.target.value.toLowerCase().trim();
      filterDeals();
    });

    // Category chips filter listeners
    categoryChips.forEach((chip) => {
      chip.addEventListener('click', () => {
        activeCategory = chip.getAttribute('data-cat-id') || 'all';
        setActiveCategoryChip(chip);
        filterDeals();
      });
    });

    filterDeals();
  });
</script>

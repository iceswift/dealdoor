---
// src/pages/index.astro

import BaseLayout from '../layouts/BaseLayout.astro';
import { db } from '../lib/db';
import { shops, deals } from '../lib/db-schema';
import { eq, and, gte, desc } from 'drizzle-orm';
import { getLangFromRequest, getLocalizedPath, t } from '../i18n';
import { SHOP_CATEGORIES, SHOP_CATEGORY_ICONS, SHOP_CATEGORY_LABELS } from '../lib/constants';
import type { ShopCategory } from '../lib/constants';
import ExploreDealCard from '../components/explore/ExploreDealCard.astro';
import Icon from '../components/icons/index.astro';
import { getActiveBoostedDealIds, prioritizePromotedDeals } from '../lib/boosts/public';

const lang = getLangFromRequest(Astro.request);
const common = (key: string) => t(lang, 'common', key);
const publicText = (key: string, params?: Record<string, string | number>) => t(lang, 'public', key, params);
const localizedPath = (path: string) => getLocalizedPath(path, lang);
const homeClientText = {
  expiringCount: publicText('home.expiringCount', { count: '{count}' }),
  recommendedCount: publicText('home.recommendedCount', { count: '{count}' }),
  nearbyTitle: publicText('home.nearbyTitle'),
  nearbyCount: publicText('home.nearbyCount', { count: '{count}' }),
  personalizedNearbyHint: publicText('home.personalizedNearbyHint'),
  personalizedSavedHint: publicText('home.personalizedSavedHint'),
  savedDealsDescription: publicText('home.savedDealsDescription', { count: '{count}' }),
  distanceAway: publicText('home.distanceAway', { distance: '{distance}' }),
  partnersCount: publicText('home.partnersCount', { count: '{count}' }),
  allCategories: publicText('home.allCategories'),
  exploreUrl: localizedPath('/deals'),
  mapUrl: localizedPath('/explore'),
  useMyLocation: publicText('home.useMyLocation'),
  locationRequesting: publicText('home.locationRequesting'),
  locationFallback: publicText('home.locationFallback'),
  locationReady: publicText('home.locationReady'),
  locationUnavailable: publicText('home.locationUnavailable'),
  locationPermissionDenied: publicText('home.locationPermissionDenied'),
  locationPositionUnavailable: publicText('home.locationPositionUnavailable'),
  locationTimeout: publicText('home.locationTimeout'),
  locationSecureContextRequired: publicText('home.locationSecureContextRequired'),
};

// ─── BACKEND WORKFLOW: FETCH ALL ACTIVE DEALS FOR CONSUMER FEED ───
const now = new Date();
const activeDeals = await db
  .select({
    deal: deals,
    shop: shops,
  })
  .from(deals)
  .leftJoin(shops, eq(deals.shopId, shops.id))
  .where(and(eq(deals.isActive, true), gte(deals.endDate, now)))
  .orderBy(desc(deals.createdAt));

const in7Days = new Date(now.getTime() + 7 * 24 * 60 * 60 * 1000);
const expiringSoon = activeDeals.filter(({ deal }) => {
  const endDate = new Date(deal.endDate);
  return endDate <= in7Days;
});
const expiringDealIds = new Set(expiringSoon.map(({ deal }) => deal.id));
const recommendedDeals = activeDeals
  .filter(({ deal }) => !expiringDealIds.has(deal.id))
  .slice(0, 6);
const boostedDealIds = await getActiveBoostedDealIds(now);
const rankedRecommendedDeals = prioritizePromotedDeals(recommendedDeals, boostedDealIds, 1);

const dealsByShop = new Map<string, { shop: typeof shops.$inferSelect; deals: typeof deals.$inferSelect[] }>();
activeDeals.forEach(({ deal, shop }) => {
  if (!shop) return;
  if (!dealsByShop.has(shop.id)) {
    dealsByShop.set(shop.id, { shop, deals: [] });
  }
  dealsByShop.get(shop.id)!.deals.push(deal);
});
const partnerShops = Array.from(dealsByShop.values())
  .sort((a, b) => b.deals.length - a.deals.length || a.shop.name.localeCompare(b.shop.name))
  .slice(0, 6);

// Categories match the Explore page shop-category filter.
const categories = [
  { id: 'all', label: publicText('home.allCategories'), emoji: '✨' },
  ...SHOP_CATEGORIES.map((cat) => ({
    id: cat,
    label: common(`category.${cat}`),
    emoji: SHOP_CATEGORY_ICONS[cat],
  })),
];
// ──────────────────────────────────────────────────────────────────
---

<BaseLayout title={lang === 'th' ? 'ค้นหาโปรโมชันและดีลคูปองใกล้ตัวคุณ' : 'Explore Promo Coupons & Deals'}>
  <div class="relative min-h-screen pb-20">
    <div id="home-results" class="space-y-8 relative z-10" aria-live="polite">
      {/* Hero Header & Airbnb-Style Multi-Input Search Capsule */}
      <section class="text-center pt-16 max-w-3xl mx-auto space-y-5 px-4">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-primary/10 text-primary border border-primary/20 text-[10px] font-black uppercase tracking-wider animate-fade-in shadow-sm">
          <span>✨ {publicText('home.eyebrow')}</span>
        </div>
        <h1 class="text-3xl font-extrabold text-secondary tracking-tight md:text-5xl leading-tight">
          {publicText('home.title')} <span class="text-gradient">{publicText('home.titleAccent')}</span> <span class="animate-tag-swing">🏷️</span>
        </h1>
        <p class="text-xs sm:text-sm text-text-secondary font-bold max-w-xl mx-auto leading-relaxed">
          {publicText('home.description')}
        </p>

        {/* Floating Airbnb Search capsule */}
        <div class="pt-6 max-w-2xl mx-auto animate-slide-up stagger-1">
          <div class="glass rounded-3xl sm:rounded-full border border-border/40 shadow-lg flex flex-col sm:flex-row items-center bg-card-bg/75 backdrop-blur-md p-2 divide-y sm:divide-y-0 sm:divide-x divide-border/30">
            
            {/* Location field */}
            <button
              id="home-use-location"
              type="button"
              aria-describedby="home-location-status"
              class="min-h-11 flex-1 w-full flex items-center px-4 py-2.5 gap-2.5 text-left min-w-0 transition-colors hover:bg-primary/5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40 rounded-2xl sm:rounded-l-full"
            >
              <Icon name="map-pin" class="h-4.5 w-4.5 text-primary flex-shrink-0" />
              <div class="min-w-0">
                <p class="text-[9px] font-black text-text-tertiary uppercase tracking-wider leading-none">{publicText('home.locationLabel')}</p>
                <p id="home-location-value" class="text-xs font-bold text-secondary truncate mt-0.5">{publicText('home.useMyLocation')}</p>
              </div>
            </button>

            {/* Category indicator field */}
            <div class="flex-1 w-full flex items-center px-4 py-2.5 gap-2.5 text-left min-w-0">
              <Icon name="tag" class="h-4.5 w-4.5 text-primary flex-shrink-0" />
              <div class="min-w-0">
                <p class="text-[9px] font-black text-text-tertiary uppercase tracking-wider leading-none">{publicText('home.categoryLabel')}</p>
                <p class="text-xs font-bold text-secondary truncate mt-0.5 select-none" id="search-cat-label">{publicText('home.allCategories')}</p>
              </div>
            </div>

            {/* Search keyword input field */}
            <div class="flex-[1.5] w-full flex items-center pl-4 pr-2 py-2 gap-2.5 text-left min-w-0">
              <Icon name="search" class="h-4.5 w-4.5 text-text-tertiary flex-shrink-0" />
              <input 
                type="text" 
                id="search-input" 
                placeholder={publicText('home.searchPlaceholder')} 
                aria-controls="home-results"
                class="w-full bg-transparent border-none text-xs focus:ring-0 focus:outline-none text-secondary font-bold placeholder:text-text-tertiary/70 pl-0 py-0 leading-none"
              />
              <button type="button" id="search-button" class="min-h-11 px-6 bg-gradient-to-r from-primary to-orange-500 hover:from-primary/95 hover:to-orange-500/95 text-white rounded-full text-xs font-black shadow-md shadow-primary/20 hover:shadow-lg hover:scale-[1.02] active:scale-95 transition-all cursor-pointer flex items-center justify-center gap-1.5 flex-shrink-0">
                <span>{publicText('home.search')}</span>
              </button>
            </div>

          </div>
        </div>
        <p id="home-location-status" class="sr-only" aria-live="polite"></p>
      </section>

      {/* Airbnb-Style Categories Slider */}
      <section class="max-w-4xl mx-auto px-4">
        <div class="flex items-center gap-3 overflow-x-auto no-scrollbar py-3 border-b border-border/30">
          {categories.map((cat) => (
            <button 
              data-cat-id={cat.id} 
              class={`category-chip min-h-11 flex items-center gap-2 px-4.5 py-2.5 rounded-2xl text-xs font-black border transition-all duration-300 whitespace-nowrap cursor-pointer hover:-translate-y-0.5 hover:shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40 ${
                cat.id === 'all' 
                  ? 'bg-gradient-to-r from-primary to-orange-500 text-white border-none shadow-md shadow-primary/10' 
                  : 'bg-card-bg/60 text-text-secondary border-border/30 hover:border-primary/20'
              }`}
            >
              <span class="text-sm">{cat.emoji}</span>
              <span>{cat.label}</span>
            </button>
          ))}
        </div>
      </section>

      <section id="home-saved-summary" class="hidden max-w-4xl mx-auto px-4">
        <div class="flex flex-col gap-4 rounded-2xl border border-primary/15 bg-primary/5 p-5 sm:flex-row sm:items-center sm:justify-between">
          <div class="flex min-w-0 items-center gap-3">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-card-bg text-primary shadow-sm">
              <Icon name="heart" class="h-5 w-5" />
            </div>
            <div class="min-w-0">
              <h2 class="text-sm font-black text-secondary">{publicText('home.savedDealsTitle')}</h2>
              <p id="home-saved-summary-description" class="mt-0.5 text-xs font-medium text-text-secondary"></p>
            </div>
          </div>
          <a href={localizedPath('/saved')} class="inline-flex min-h-11 shrink-0 items-center justify-center gap-2 rounded-xl border border-primary/20 bg-card-bg px-4 text-xs font-black text-primary transition hover:bg-primary hover:text-white">
            <span>{publicText('home.viewSavedDeals')}</span>
            <Icon name="arrow-right" class="h-4 w-4" />
          </a>
        </div>
      </section>

      {/* Expiring Soon Section */}
      {expiringSoon.length > 0 && (
        <section class="home-section max-w-4xl mx-auto px-4" data-section="expiring">
          <div class="flex items-center justify-between border-b border-border/30 pb-3 mb-6">
            <div class="flex items-center gap-2.5">
              <div class="h-8 w-8 rounded-xl bg-amber-500/10 flex items-center justify-center text-amber-500">
                <Icon name="clock" class="h-5 w-5" />
              </div>
              <h2 class="text-lg font-bold text-secondary">{publicText('home.expiringTitle')}</h2>
            </div>
            <span class="badge border-none bg-amber-500/10 text-amber-600 dark:text-amber-400 font-extrabold" id="expiring-count">
              {publicText('home.expiringCount', { count: expiringSoon.length })}
            </span>
          </div>

          <div class="home-section-grid grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {expiringSoon.slice(0, 6).map(({ deal, shop }, index) => (
              <div
                class:list={['home-filter-item animate-fade-in', index === 0 && 'sm:col-span-2']}
                data-section="expiring"
                data-deal-id={deal.id}
                data-shop-id={shop?.id ?? ''}
                data-latitude={shop?.latitude ?? ''}
                data-longitude={shop?.longitude ?? ''}
                data-shop-category={shop?.category || ''}
                data-title={deal.title.toLowerCase()}
                data-shop-name={shop?.name.toLowerCase() || ''}
                style={`animation-delay: ${index * 0.08}s`}
              >
                {shop && <ExploreDealCard deal={deal} shop={shop} featured={index === 0} isPromoted={boostedDealIds.has(deal.id)} />}
                <span class="home-distance mt-2 hidden text-[10px] font-black text-primary"></span>
              </div>
            ))}
          </div>

          <div class="home-empty-state hidden border border-dashed border-border/80 p-8 text-center rounded-2xl bg-bg-secondary/40">
            <p class="text-sm font-bold text-secondary">{publicText('home.noExpiringDeals')}</p>
          </div>
          <div class="mt-6 flex justify-center">
            <a href={localizedPath('/deals?sort=expiring')} class="inline-flex min-h-11 items-center gap-2 rounded-xl border border-primary/25 bg-card-bg px-4 text-xs font-black text-primary transition hover:bg-primary hover:text-white">
              <span>{publicText('home.viewExpiringDeals')}</span>
              <Icon name="arrow-right" class="h-4 w-4" />
            </a>
          </div>
        </section>
      )}

      {/* Recommended deals deliberately exclude expiring cards above. */}
      {rankedRecommendedDeals.length > 0 ? (
      <section class="home-section max-w-4xl mx-auto px-4" data-section="recommended">
        <div class="flex items-center justify-between border-b border-border/30 pb-3 mb-6">
          <div class="flex items-center gap-2.5">
            <div class="h-8 w-8 rounded-xl bg-primary/10 flex items-center justify-center text-primary">
              <Icon name="fire" class="h-5 w-5" />
            </div>
            <div>
              <h2 id="recommendation-title" class="text-lg font-bold text-secondary">{publicText('home.recommendedTitle')}</h2>
              <p id="recommendation-hint" class="mt-0.5 hidden text-[10px] font-bold text-text-tertiary"></p>
            </div>
          </div>
          <span class="badge border-none bg-primary/10 text-primary font-extrabold" id="recommended-count">
            {publicText('home.recommendedCount', { count: rankedRecommendedDeals.length })}
          </span>
        </div>

        <div class="home-section-grid grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {rankedRecommendedDeals.map(({ deal, shop }, index) => (
            <div
              class="home-filter-item animate-fade-in"
              data-section="recommended"
              data-deal-id={deal.id}
              data-shop-id={shop?.id ?? ''}
              data-latitude={shop?.latitude ?? ''}
              data-longitude={shop?.longitude ?? ''}
              data-shop-category={shop?.category || ''}
              data-title={deal.title.toLowerCase()}
              data-shop-name={shop?.name.toLowerCase() || ''}
              style={`animation-delay: ${index * 0.04}s`}
            >
              {shop && <ExploreDealCard deal={deal} shop={shop} isPromoted={boostedDealIds.has(deal.id)} />}
              <span class="home-distance mt-2 hidden text-[10px] font-black text-primary"></span>
            </div>
          ))}
        </div>

        <div class="home-empty-state hidden border border-dashed border-border/80 p-8 text-center rounded-2xl bg-bg-secondary/40">
          <p class="text-sm font-bold text-secondary">{publicText('home.noDealsInCategory')}</p>
        </div>
        <div class="mt-6 flex justify-center">
          <a href={localizedPath('/deals')} class="inline-flex min-h-11 items-center gap-2 rounded-xl border border-primary/25 bg-card-bg px-4 text-xs font-black text-primary transition hover:bg-primary hover:text-white">
            <span>{publicText('home.viewAllDeals')}</span>
            <Icon name="arrow-right" class="h-4 w-4" />
          </a>
        </div>
      </section>
      ) : activeDeals.length === 0 ? (
        <section class="max-w-4xl mx-auto px-4">
          <div class="border border-dashed border-border/80 p-12 text-center rounded-2xl bg-bg-secondary/40">
            <Icon name="search" class="h-10 w-10 mx-auto text-text-tertiary" />
            <h3 class="mt-4 text-base font-bold text-secondary">{publicText('home.noActiveDeals')}</h3>
            <p class="mt-1 text-xs text-text-secondary">{publicText('home.noActiveDealsDescription')}</p>
          </div>
        </section>
      ) : null}

      {/* Merchant CTA follows the shopper's first decision point. */}
      <section class="max-w-4xl mx-auto px-4">
        <div class="rounded-2xl border border-primary/15 bg-card-bg/70 p-5 shadow-sm relative overflow-hidden flex flex-col md:flex-row items-center justify-between gap-4 hover:border-primary/30 transition-colors duration-300">
          <div class="space-y-1.5 z-10 text-center md:text-left">
            <h3 class="text-sm font-black text-secondary flex items-center justify-center md:justify-start gap-2">
              <Icon name="store" class="h-4.5 w-4.5 text-primary" />
              <span>{publicText('home.merchantTitle')}</span>
            </h3>
            <p class="text-[11px] text-text-secondary font-bold">{publicText('home.merchantDescription')}</p>
          </div>
          <a href={localizedPath('/for-shops')} class="btn btn-primary min-h-11 py-2.5 px-6 rounded-xl text-xs font-black shadow-md hover:scale-[1.02] active:scale-95 transition-all shrink-0 z-10">
            <Icon name="rocket" class="h-4.5 w-4.5" />
            <span>{publicText('home.merchantAction')}</span>
          </a>
        </div>
      </section>

      {/* Active Shop Partners Section */}
      <section class="home-section max-w-4xl mx-auto px-4" data-section="partners">
        <div class="flex items-center justify-between border-b border-border/30 pb-3 mb-6">
          <div class="flex items-center gap-2.5">
            <div class="h-8 w-8 rounded-xl bg-accent/10 flex items-center justify-center text-accent">
              <Icon name="store" class="h-5 w-5" />
            </div>
            <h2 class="text-lg font-bold text-secondary">{publicText('home.partnersTitle')}</h2>
          </div>
          <span class="badge border-none bg-accent/10 text-accent font-extrabold" id="partners-count">
            {publicText('home.partnersCount', { count: partnerShops.length })}
          </span>
        </div>

        <div class="home-section-grid grid gap-4.5 sm:grid-cols-2 md:grid-cols-3">
          {partnerShops.map(({ shop, deals: shopDeals }, index) => (
            <a
              href={localizedPath(`/${shop.slug}`)}
              class="home-filter-item card animate-fade-in group flex flex-col justify-between overflow-hidden bg-card-bg/60 backdrop-blur-sm border border-border/40 hover:border-primary/45 rounded-2xl p-5 hover:shadow-md transition-all duration-300"
              data-section="partners"
              data-shop-id={shop.id}
              data-latitude={shop.latitude ?? ''}
              data-longitude={shop.longitude ?? ''}
              data-shop-category={shop.category}
              data-title={shop.name.toLowerCase()}
              data-shop-name={shop.name.toLowerCase()}
              style={`animation-delay: ${index * 0.08}s`}
            >
              <div class="flex items-center gap-3">
                <div class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-primary/10 to-orange-100/50 text-base font-extrabold text-primary transition-transform group-hover:scale-105">
                  {shop.logoImage ? (
                    <img src={shop.logoImage} alt={shop.name} class="h-full w-full object-cover rounded-xl" />
                  ) : (
                    shop.name.charAt(0)
                  )}
                </div>
                <div class="min-w-0">
                  <h3 class="font-bold text-sm text-secondary truncate group-hover:text-primary transition-colors">
                    {shop.name}
                  </h3>
                  <p class="text-xs text-text-tertiary mt-0.5">
                    {common(`category.${shop.category as ShopCategory}`) || shop.category}
                  </p>
                </div>
              </div>
              <div class="mt-4 pt-3.5 border-t border-border/30 flex items-center justify-between">
                <span class="badge border-none bg-primary/10 text-primary font-bold text-[10px]">
                  {publicText('home.activeDealCount', { count: shopDeals.length })}
                </span>
                <span class="text-xs font-bold text-text-tertiary group-hover:text-primary transition-colors flex items-center gap-1">
                  <span>{publicText('home.visitShop')}</span>
                  <Icon name="chevron-right" class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" />
                </span>
              </div>
            </a>
          ))}
        </div>

        <div class="home-empty-state hidden border border-dashed border-border/80 p-8 text-center rounded-2xl bg-bg-secondary/40">
          <p class="text-sm font-bold text-secondary">{publicText('home.noPartnersInCategory')}</p>
        </div>
        <div class="mt-6 flex justify-center">
          <a href={localizedPath('/deals')} class="inline-flex min-h-11 items-center gap-2 rounded-xl border border-accent/25 bg-card-bg px-4 text-xs font-black text-accent transition hover:bg-accent hover:text-white">
            <span>{publicText('home.viewAllDeals')}</span>
            <Icon name="arrow-right" class="h-4 w-4" />
          </a>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  /* Custom styling to hide scrollbars */
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  /* Custom price tag swinging animation */
  .animate-tag-swing {
    display: inline-block;
    transform-origin: 50% 10%;
    animation: tagSwing 3.5s ease-in-out infinite;
  }

  @keyframes tagSwing {
    0% { transform: rotate(0deg); }
    15% { transform: rotate(12deg); }
    30% { transform: rotate(-10deg); }
    45% { transform: rotate(8deg); }
    60% { transform: rotate(-6deg); }
    75% { transform: rotate(3deg); }
    90% { transform: rotate(-1deg); }
    100% { transform: rotate(0deg); }
  }
</style>

<script is:inline define:vars={{ homeClientText }}>
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('search-input');
    const searchButton = document.getElementById('search-button');
    const useLocationButton = document.getElementById('home-use-location');
    const locationValue = document.getElementById('home-location-value');
    const locationStatus = document.getElementById('home-location-status');
    const categoryChips = document.querySelectorAll('.category-chip');
    const filterItems = document.querySelectorAll('.home-filter-item');
    const sections = document.querySelectorAll('.home-section');
    const countEls = {
      expiring: document.getElementById('expiring-count'),
      recommended: document.getElementById('recommended-count'),
      partners: document.getElementById('partners-count'),
    };
    const searchCatLabel = document.getElementById('search-cat-label');
    const savedSummary = document.getElementById('home-saved-summary');
    const savedSummaryDescription = document.getElementById('home-saved-summary-description');

    let activeCategory = 'all';
    let searchQuery = '';
    let recommendationUsesNearby = false;
    const formatCount = (template, count) => template.replace('{count}', String(count));
    const USER_LOCATION_SESSION_KEY = 'dealdoor.explore.userLocation.v1';

    function getExploreUrl(extraParams = {}) {
      const url = new URL(homeClientText.exploreUrl, window.location.origin);
      const query = searchInput?.value.trim();
      if (query) url.searchParams.set('q', query);
      if (activeCategory !== 'all') url.searchParams.set('category', activeCategory);
      Object.entries(extraParams).forEach(([key, value]) => url.searchParams.set(key, value));
      return `${url.pathname}${url.search}`;
    }

    function openExplore(extraParams = {}) {
      window.location.assign(getExploreUrl(extraParams));
    }

    function openMap(extraParams = {}) {
      const url = new URL(homeClientText.mapUrl, window.location.origin);
      const query = searchInput?.value.trim();
      if (query) url.searchParams.set('q', query);
      if (activeCategory !== 'all') url.searchParams.set('category', activeCategory);
      Object.entries(extraParams).forEach(([key, value]) => url.searchParams.set(key, value));
      window.location.assign(`${url.pathname}${url.search}`);
    }

    function setLocationMessage(message, tone = 'default') {
      if (locationStatus) locationStatus.textContent = message;
      if (locationValue) {
        locationValue.textContent = message;
        locationValue.classList.toggle('text-primary', tone === 'primary');
        locationValue.classList.toggle('text-danger', tone === 'error');
      }
    }

    const categoryLabels = Object.fromEntries(
      Array.from(categoryChips).map((chip) => [
        chip.getAttribute('data-cat-id') || 'all',
        chip.textContent.trim(),
      ])
    );

    const readStoredArray = (key) => {
      try {
        const parsed = JSON.parse(window.localStorage.getItem(key) || '[]');
        return Array.isArray(parsed) ? new Set(parsed.map(String)) : new Set();
      } catch {
        return new Set();
      }
    };

    function updateSavedSummary() {
      const savedDeals = readStoredArray('dealdoor_saved_deals');
      if (!savedSummary || !savedSummaryDescription) return;
      savedSummary.classList.toggle('hidden', savedDeals.size === 0);
      savedSummaryDescription.textContent = homeClientText.savedDealsDescription.replace('{count}', String(savedDeals.size));
    }

    const readStoredLocation = () => {
      try {
        const saved = JSON.parse(window.sessionStorage.getItem(USER_LOCATION_SESSION_KEY) || 'null');
        const ageMs = Date.now() - Number(saved?.timestamp || 0);
        if (!Number.isFinite(Number(saved?.lat)) || !Number.isFinite(Number(saved?.lng)) || ageMs > 30 * 60 * 1000) return null;
        return { lat: Number(saved.lat), lng: Number(saved.lng) };
      } catch {
        return null;
      }
    };

    const distanceFromUser = (card, location) => {
      if (!location) return Number.POSITIVE_INFINITY;
      const latitude = Number(card.getAttribute('data-latitude'));
      const longitude = Number(card.getAttribute('data-longitude'));
      if (!Number.isFinite(latitude) || !Number.isFinite(longitude)) return Number.POSITIVE_INFINITY;
      const toRadians = (value) => (value * Math.PI) / 180;
      const dLat = toRadians(latitude - location.lat);
      const dLng = toRadians(longitude - location.lng);
      const a = Math.sin(dLat / 2) ** 2 + Math.cos(toRadians(location.lat)) * Math.cos(toRadians(latitude)) * Math.sin(dLng / 2) ** 2;
      return 6371 * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
    };

    const formatDistance = (distance) => (
      distance < 1 ? `${Math.round(distance * 1000)} m` : `${distance.toFixed(1)} km`
    );

    function updateDistanceLabels(location) {
      document.querySelectorAll('.home-distance').forEach((label) => {
        const card = label.closest('.home-filter-item');
        const distance = card ? distanceFromUser(card, location) : Number.POSITIVE_INFINITY;
        if (!Number.isFinite(distance)) {
          label.classList.add('hidden');
          return;
        }
        label.textContent = homeClientText.distanceAway.replace('{distance}', formatDistance(distance));
        label.classList.remove('hidden');
      });
    }

    function sortPersonalizedSection(sectionName, storageKey, dataKey, location) {
      const grid = document.querySelector(`[data-section="${sectionName}"] .home-section-grid`);
      if (!grid) return false;
      const savedIds = readStoredArray(storageKey);
      const cards = Array.from(grid.querySelectorAll('.home-filter-item'));
      const hasSaved = cards.some((card) => savedIds.has(card.getAttribute(dataKey) || ''));
      cards.sort((first, second) => {
        const firstSaved = savedIds.has(first.getAttribute(dataKey) || '');
        const secondSaved = savedIds.has(second.getAttribute(dataKey) || '');
        if (firstSaved !== secondSaved) return firstSaved ? -1 : 1;
        return distanceFromUser(first, location) - distanceFromUser(second, location);
      });
      grid.append(...cards);
      return hasSaved;
    }

    function applyPersonalization() {
      const location = readStoredLocation();
      const hasSavedDeals = sortPersonalizedSection('recommended', 'dealdoor_saved_deals', 'data-deal-id', location);
      sortPersonalizedSection('partners', 'dealdoor_favorite_shops', 'data-shop-id', location);
      updateSavedSummary();
      updateDistanceLabels(location);
      recommendationUsesNearby = Boolean(location);

      const recommendationTitle = document.getElementById('recommendation-title');
      const recommendationHint = document.getElementById('recommendation-hint');
      if (recommendationTitle && recommendationUsesNearby) recommendationTitle.textContent = homeClientText.nearbyTitle;
      if (recommendationHint && (recommendationUsesNearby || hasSavedDeals)) {
        recommendationHint.textContent = recommendationUsesNearby
          ? homeClientText.personalizedNearbyHint
          : homeClientText.personalizedSavedHint;
        recommendationHint.classList.remove('hidden');
      }
    }

    function filterDeals() {
      const counts = { expiring: 0, recommended: 0, partners: 0 };

      filterItems.forEach((item) => {
        const itemCategory = item.getAttribute('data-shop-category');
        const itemTitle = item.getAttribute('data-title') || '';
        const itemShop = item.getAttribute('data-shop-name') || '';
        const section = item.getAttribute('data-section');

        const categoryMatches = activeCategory === 'all' || itemCategory === activeCategory;
        const searchMatches = !searchQuery || itemTitle.includes(searchQuery) || itemShop.includes(searchQuery);
        const visible = categoryMatches && searchMatches;

        item.classList.toggle('hidden', !visible);

        if (visible && section && counts[section] !== undefined) {
          counts[section] += 1;
        }
      });

      sections.forEach((section) => {
        const sectionName = section.getAttribute('data-section');
        const count = counts[sectionName] || 0;
        const grid = section.querySelector('.home-section-grid');
        const empty = section.querySelector('.home-empty-state');

        if (grid) {
          grid.classList.toggle('hidden', count === 0);
        }

        if (empty) {
          empty.classList.toggle('hidden', count !== 0);
        }
      });

      if (countEls.expiring) {
        countEls.expiring.textContent = formatCount(homeClientText.expiringCount, counts.expiring);
      }

      if (countEls.recommended) {
        const countTemplate = recommendationUsesNearby ? homeClientText.nearbyCount : homeClientText.recommendedCount;
        countEls.recommended.textContent = formatCount(countTemplate, counts.recommended);
      }

      if (countEls.partners) {
        countEls.partners.textContent = formatCount(homeClientText.partnersCount, counts.partners);
      }

      if (searchCatLabel) {
        searchCatLabel.textContent = categoryLabels[activeCategory] || homeClientText.allCategories;
      }
    }

    function setActiveCategoryChip(activeChip) {
      categoryChips.forEach((chip) => {
        const isActive = chip === activeChip;
        chip.className = isActive
          ? 'category-chip min-h-11 flex items-center gap-2 px-4.5 py-2.5 rounded-2xl text-xs font-black border transition-all duration-300 whitespace-nowrap cursor-pointer hover:-translate-y-0.5 hover:shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40 bg-gradient-to-r from-primary to-orange-500 text-white border-none shadow-md shadow-primary/10'
          : 'category-chip min-h-11 flex items-center gap-2 px-4.5 py-2.5 rounded-2xl text-xs font-black border transition-all duration-300 whitespace-nowrap cursor-pointer hover:-translate-y-0.5 hover:shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40 bg-card-bg/60 text-text-secondary border-border/30 hover:border-primary/20';
      });
    }

    // Search bar filter listener
    searchInput?.addEventListener('input', (e) => {
      searchQuery = e.target.value.toLowerCase().trim();
      filterDeals();
    });

    searchInput?.addEventListener('keydown', (event) => {
      if (event.key !== 'Enter') return;
      event.preventDefault();
      openExplore();
    });

    searchButton?.addEventListener('click', () => openExplore());

    function trackHomeDealClick(item) {
      const shopId = item.getAttribute('data-shop-id');
      const dealId = item.getAttribute('data-deal-id');
      if (!shopId || !dealId) return;

      fetch('/api/analytics/track', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        keepalive: true,
        body: JSON.stringify({
          type: 'deal_click',
          shopId,
          dealId,
          metadata: { source: 'home', section: item.getAttribute('data-section') || 'unknown' },
        }),
      }).catch(() => {});
    }

    document.addEventListener('click', (event) => {
      const link = event.target.closest?.('.home-filter-item[data-deal-id] > a');
      if (!link) return;
      const item = link.closest('.home-filter-item');
      if (item) trackHomeDealClick(item);
    });

    function getLocationFailureMessage(error) {
      if (error?.code === 1) return homeClientText.locationPermissionDenied;
      if (error?.code === 2) return homeClientText.locationPositionUnavailable;
      if (error?.code === 3) return homeClientText.locationTimeout;
      return homeClientText.locationUnavailable;
    }

    useLocationButton?.addEventListener('click', () => {
      if (!navigator.geolocation || !window.isSecureContext) {
        setLocationMessage(homeClientText.locationSecureContextRequired, 'error');
        return;
      }

      useLocationButton.disabled = true;
      useLocationButton.setAttribute('aria-busy', 'true');
      setLocationMessage(homeClientText.locationRequesting, 'primary');

      const complete = (position) => {
          try {
            window.sessionStorage.setItem(USER_LOCATION_SESSION_KEY, JSON.stringify({
              lat: position.coords.latitude,
              lng: position.coords.longitude,
              accuracy: position.coords.accuracy,
              timestamp: Date.now(),
            }));
          } catch {}
          setLocationMessage(homeClientText.locationReady, 'primary');
          openMap({ sort: 'nearby' });
      };

      const fail = (error) => {
          useLocationButton.disabled = false;
          useLocationButton.removeAttribute('aria-busy');
          setLocationMessage(getLocationFailureMessage(error), 'error');
      };

      const requestFallbackLocation = () => {
        setLocationMessage(homeClientText.locationFallback, 'primary');
        navigator.geolocation.getCurrentPosition(
          complete,
          fail,
          { enableHighAccuracy: false, maximumAge: 300_000, timeout: 15_000 }
        );
      };

      navigator.geolocation.getCurrentPosition(
        complete,
        (error) => {
          if (error?.code === 1) {
            fail(error);
            return;
          }
          requestFallbackLocation();
        },
        { enableHighAccuracy: true, maximumAge: 60_000, timeout: 12_000 }
      );
    });

    // Category chips filter listeners
    categoryChips.forEach((chip) => {
      chip.addEventListener('click', () => {
        activeCategory = chip.getAttribute('data-cat-id') || 'all';
        setActiveCategoryChip(chip);
        filterDeals();
      });
    });

    applyPersonalization();
    window.addEventListener('dealdoor:saved-deals-change', () => {
      applyPersonalization();
      filterDeals();
    });
    filterDeals();
  });

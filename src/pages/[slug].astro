---
// src/pages/[slug].astro

import BaseLayout from '../layouts/BaseLayout.astro';
import { db } from '../lib/db';
import { shops, deals, menuItems, shopSpecialHours } from '../lib/db-schema';
import { firstRow } from '../lib/db-query';
import { eq, and, gte, lt, asc } from 'drizzle-orm';
import ShopHeader from '../components/shop/ShopHeader.astro';
import ExploreDealCard from '../components/explore/ExploreDealCard.astro';
import DealDetailModal from '../components/shop/DealDetailModal.tsx';
import MenuList from '../components/shop/MenuList.astro';
import ShopInfo from '../components/shop/ShopInfo.astro';
import PaymentMethods from '../components/shop/PaymentMethods.astro';
import AccessibilityInfo from '../components/shop/AccessibilityInfo.astro';
import ParkingInfo from '../components/shop/ParkingInfo.astro';
import PetPolicy from '../components/shop/PetPolicy.astro';
import FamilyFacilities from '../components/shop/FamilyFacilities.astro';
import { getLangFromUrl, t } from '../i18n';
import { generateLocalBusinessSchema, generateOfferSchema, generateBreadcrumbSchema } from '../lib/seo';
import Icon from '../components/icons/index.astro';

export async function getStaticPaths() {
  const allShops = await db.select({ slug: shops.slug }).from(shops);
  return allShops.map(shop => ({
    params: { slug: shop.slug },
  }));
}

const lang = getLangFromUrl(Astro.url);
const common = (key: string, params?: Record<string, string | number>) => 
  t(lang, 'common', key, params);

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/');
}

// ─── BACKEND WORKFLOW: FETCH INDIVIDUAL MERCHANT SHOP ───
const shop = await firstRow(db.select().from(shops).where(eq(shops.slug, slug)).limit(1));

if (!shop) {
  return Astro.redirect('/404');
}

const now = new Date();
const activeDeals = await db
  .select()
  .from(deals)
  .where(and(eq(deals.shopId, shop.id), eq(deals.isActive, true), gte(deals.endDate, now)))
  .orderBy(asc(deals.endDate));

const expiredDeals = await db
  .select()
  .from(deals)
  .where(and(eq(deals.shopId, shop.id), lt(deals.endDate, now)))
  .orderBy(asc(deals.endDate));

const menuItemsList = await db
  .select()
  .from(menuItems)
  .where(eq(menuItems.shopId, shop.id))
  .orderBy(asc(menuItems.sortOrder));

const specialHoursList = await db
  .select()
  .from(shopSpecialHours)
  .where(eq(shopSpecialHours.shopId, shop.id))
  .orderBy(asc(shopSpecialHours.date));

const dealId = Astro.url.searchParams.get('deal');
const highlightedDeal = dealId ? [...activeDeals, ...expiredDeals].find(d => d.id === dealId) : null;
const invalidDealId = Boolean(dealId && !highlightedDeal);
// ────────────────────────────────────────────────────────

const localBusinessSchema = generateLocalBusinessSchema(shop);
const offerSchemas = activeDeals.map(deal => generateOfferSchema(deal, shop));
const breadcrumbSchema = generateBreadcrumbSchema([
  { name: 'DealDoor', url: 'https://dealdoor.co' },
  { name: 'Explore', url: 'https://dealdoor.co/explore' },
  { name: shop.name, url: `https://dealdoor.co/${shop.slug}` },
]);
---

<BaseLayout title={shop.name} description={shop.description || undefined}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
    {offerSchemas.map(schema => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <div class="mx-auto max-w-3xl px-4 pt-8 pb-20 md:pb-8 relative">
    {/* Background meshes */}
    <div class="absolute top-0 right-0 bg-mesh bg-mesh-coral h-64 w-64 opacity-5"></div>
    <div class="absolute bottom-20 left-0 bg-mesh bg-mesh-teal h-64 w-64 opacity-5"></div>

    {/* Shop Profile Header */}
    <ShopHeader shop={shop} specialHours={specialHoursList} />

    {/* Sticky Navigation Tabs (Scrollspy Glass Tabs) */}
    <div class="sticky top-[76px] bg-card-bg/65 backdrop-blur-md border border-border/15 rounded-full shadow-md p-1 z-30 flex gap-1.5 max-w-max mx-auto my-6">
      <button class="scroll-tab-btn px-4 py-1.5 text-xs font-extrabold rounded-full bg-primary text-white shadow-sm transition-all duration-300" data-target="section-deals">
        {lang === 'th' ? 'ดีลพิเศษ' : 'Deals'}
      </button>
      <button class="scroll-tab-btn px-4 py-1.5 text-xs font-extrabold rounded-full bg-transparent text-text-secondary hover:text-secondary transition-all duration-300" data-target="section-menu">
        {lang === 'th' ? 'เมนูแนะนำ' : 'Menu'}
      </button>
      <button class="scroll-tab-btn px-4 py-1.5 text-xs font-extrabold rounded-full bg-transparent text-text-secondary hover:text-secondary transition-all duration-300" data-target="section-info">
        {lang === 'th' ? 'ข้อมูลร้าน' : 'Shop Info'}
      </button>
    </div>

    {/* Vertical Single-Column Sections */}
    <div class="space-y-12 mt-8">
      
      {/* 1. Deals Section */}
      <section id="section-deals" class="scroll-mt-32">
        {/* Active Coupons/Deals Listing */}
        <div>
          <div class="flex items-center gap-2.5 mb-5 border-b border-border/30 pb-3">
            <div class="h-8 w-8 rounded-xl bg-primary/10 flex items-center justify-center text-primary">
              <Icon name="fire" class="h-5 w-5" />
            </div>
            <h2 class="text-lg font-bold text-secondary">
              {common('shopPage.activeDeals')} ({activeDeals.length})
            </h2>
          </div>
          
          {activeDeals.length > 0 ? (
            <div class="grid gap-6 sm:grid-cols-2">
              {activeDeals.map((deal) => (
                <ExploreDealCard deal={deal} shop={shop} highlighted={deal.id === dealId} />
              ))}
            </div>
          ) : (
            <div class="border border-dashed border-border/80 p-10 text-center rounded-2xl bg-bg-secondary/40 max-w-sm mx-auto">
              <Icon name="clipboard" class="h-10 w-10 mx-auto text-text-tertiary" />
              <h3 class="mt-4 text-base font-bold text-secondary">{common('empty.noDeals')}</h3>
              <p class="mt-1 text-xs text-text-secondary">{common('empty.noDealsDesc')}</p>
            </div>
          )}
        </div>

        {/* Expired Coupons/Deals Listing */}
        {expiredDeals.length > 0 && (
          <div class="mt-10">
            <div class="flex items-center gap-2.5 mb-5 border-b border-border/30 pb-3">
              <div class="h-8 w-8 rounded-xl bg-border/20 flex items-center justify-center text-text-tertiary">
                <Icon name="clock" class="h-5 w-5" />
              </div>
              <h2 class="text-lg font-bold text-text-tertiary">
                ดีลที่หมดอายุ ({expiredDeals.length})
              </h2>
            </div>
            <div class="grid gap-6 sm:grid-cols-2 opacity-60">
              {expiredDeals.map((deal) => (
                <ExploreDealCard deal={deal} shop={shop} highlighted={deal.id === dealId} />
              ))}
            </div>
          </div>
        )}
      </section>

      {/* 2. Menu Section */}
      <section id="section-menu" class="scroll-mt-32">
        <MenuList items={menuItemsList} />
      </section>

      {/* 3. Shop Info Section */}
      <section id="section-info" class="scroll-mt-32 space-y-8">
        {/* Detailed Info Card */}
        <ShopInfo shop={shop} />

        {/* Amenities details stacked cleanly in a responsive grid */}
        <div class="grid gap-6 sm:grid-cols-2">
          <PaymentMethods shop={shop} />
          <AccessibilityInfo shop={shop} />
          <ParkingInfo shop={shop} />
          <PetPolicy shop={shop} />
          <FamilyFacilities shop={shop} />
        </div>
      </section>

    </div>

    {/* Premium Footer Glass CTA */}
    <div class="rounded-3xl border border-border/40 bg-bg-secondary/50 backdrop-blur-sm p-8 text-center shadow-sm relative overflow-hidden mt-12 w-full">
      <div class="absolute -right-16 -bottom-16 h-36 w-36 rounded-full bg-primary/10 blur-2xl"></div>
      
      <p class="text-xs text-text-tertiary tracking-wider uppercase font-semibold">{common('shopPage.createdBy')}</p>
      <h3 class="text-lg font-extrabold text-secondary mt-1.5">อยากจัดโปรโมชันแชร์ง่ายๆ แบบนี้บ้างไหม?</h3>
      <p class="text-xs text-text-secondary mt-1 max-w-sm mx-auto">สร้างหน้าคูปองร้านของคุณฟรี เสร็จภายใน 2 นาที แชร์ได้ทันที</p>
      
      <a
        href="/"
        class="btn btn-primary mt-5 py-2.5 px-6 rounded-xl text-xs font-bold"
      >
        <Icon name="rocket" class="h-4.5 w-4.5" />
        <span>{common('shopPage.createYourPage')}</span>
      </a>
    </div>
  </div>

  {/* Sticky Floating Dock bar on mobile screens */}
  <div class="fixed bottom-4 left-4 right-4 z-40 md:hidden">
    <div class="glass rounded-2xl p-2.5 flex gap-1.5 shadow-2xl border border-border/50">
      {shop.lineId && (
        <a
          href={shop.lineId.startsWith('@') ? `https://line.me/ti/p/${shop.lineId}` : shop.lineId}
          target="_blank"
          rel="noopener noreferrer"
          class="btn flex-1 py-3 px-2 bg-[#06C755] text-white hover:bg-[#05B34C] border-none shadow-md shadow-[#06C755]/10 rounded-xl text-xs font-bold flex items-center justify-center gap-1 min-h-[44px]"
        >
          <Icon name="line" class="h-4.5 w-4.5" />
          <span>LINE</span>
        </a>
      )}
      {shop.phone && (
        <a
          href={`tel:${shop.phone}`}
          class="btn btn-secondary flex-1 py-3 px-2 rounded-xl text-xs font-bold hover:bg-bg-tertiary flex items-center justify-center gap-1 min-h-[44px]"
        >
          <Icon name="phone" class="h-4.5 w-4.5 text-primary" />
          <span>โทรออก</span>
        </a>
      )}
      {shop.latitude && shop.longitude && (
        <a
          href={`https://www.google.com/maps/dir/?api=1&destination=${shop.latitude},${shop.longitude}`}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-secondary flex-1 py-3 px-2 rounded-xl text-xs font-bold hover:bg-bg-tertiary flex items-center justify-center gap-1 min-h-[44px]"
        >
          <Icon name="map-pin" class="h-4.5 w-4.5 text-primary" />
          <span>แผนที่</span>
        </a>
      )}
    </div>
  </div>

  {/* Deal Detail Modal (client-side interactive component) */}
  <DealDetailModal
    client:load
    deal={highlightedDeal}
    shop={shop}
    onClose={() => {
      const url = new URL(window.location.href);
      url.searchParams.delete('deal');
      window.history.replaceState({}, '', url.toString());
    }}
  />

  {invalidDealId && (
    <div class="fixed bottom-6 left-1/2 z-50 w-[calc(100%-2rem)] max-w-md -translate-x-1/2 rounded-2xl border border-warning/30 bg-warning-bg px-4 py-3 text-sm font-bold text-warning-text shadow-xl">
      ไม่พบดีลที่เปิดจากลิงก์นี้ อาจถูกลบหรือหมดอายุไปแล้ว
    </div>
  )}
</BaseLayout>

<script is:inline define:vars={{ shopId: shop.id }}>
  // ─── BACKEND WORKFLOW: TRACK ANALYTICS EVENT ───
  fetch('/api/analytics/track', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      type: 'page_view',
      shopId: shopId,
    }),
  }).catch(() => {});

  // Auto-open modal if deal parameter is highlighted
  document.addEventListener('DOMContentLoaded', () => {
    const params = new URLSearchParams(window.location.search);
    const dealId = params.get('deal');
    
    if (dealId) {
      fetch('/api/analytics/track', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          type: 'deal_view',
          shopId: shopId,
          dealId: dealId,
        }),
      }).catch(() => {});

      const dealCard = document.querySelector(`[data-deal-id="${dealId}"]`);
      if (dealCard) {
        dealCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    }
  });
  // ───────────────────────────────────────────────
</script>

<script>
  function setupScrollspyTabs() {
    const tabBtns = document.querySelectorAll('.scroll-tab-btn');
    const sections = {
      'section-deals': document.getElementById('section-deals'),
      'section-menu': document.getElementById('section-menu'),
      'section-info': document.getElementById('section-info'),
    };
    
    // Smooth scroll to sections on tab click
    tabBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const targetId = btn.getAttribute('data-target');
        if (!targetId) return;
        const targetEl = sections[targetId as keyof typeof sections];
        if (targetEl) {
          targetEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });
    
    // Scrollspy behavior using IntersectionObserver
    const observerOptions = {
      root: null,
      rootMargin: '-130px 0px -60% 0px',
      threshold: 0,
    };
    
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const activeId = entry.target.id;
          
          tabBtns.forEach(btn => {
            const btnTarget = btn.getAttribute('data-target');
            if (btnTarget === activeId) {
              btn.classList.remove('bg-transparent', 'text-text-secondary', 'hover:text-secondary');
              btn.classList.add('bg-primary', 'text-white', 'shadow-sm');
            } else {
              btn.classList.remove('bg-primary', 'text-white', 'shadow-sm');
              btn.classList.add('bg-transparent', 'text-text-secondary', 'hover:text-secondary');
            }
          });
        }
      });
    }, observerOptions);
    
    Object.values(sections).forEach(section => {
      if (section) observer.observe(section);
    });
  }
  
  document.addEventListener('DOMContentLoaded', setupScrollspyTabs);
  document.addEventListener('astro:page-load', setupScrollspyTabs);
</script>

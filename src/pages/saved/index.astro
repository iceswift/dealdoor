---
// src/pages/saved/index.astro

import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/icons/index.astro';
---

<BaseLayout title="ดีลที่บันทึกไว้">
  <div class="relative min-h-screen">
    {/* Decorative Background Glows */}
    <div class="absolute top-0 right-0 bg-mesh bg-mesh-coral h-72 w-72 opacity-10"></div>
    <div class="absolute bottom-20 left-0 bg-mesh bg-mesh-teal h-72 w-72 opacity-5"></div>

    <div class="mx-auto max-w-4xl px-4 py-12 relative z-10">
      {/* Header Info */}
      <div class="text-center max-w-md mx-auto mb-8">
        <h1 class="text-3xl font-extrabold tracking-tight text-secondary">
          รายการที่บันทึกไว้ ❤️
        </h1>
        <p class="mt-2.5 text-xs text-text-secondary leading-relaxed">
          เข้าถึงดีล คูปองส่วนลดพิเศษ และร้านค้าโปรดที่คุณติดตามไว้เพื่อนำไปแสดงที่หน้าร้านได้ทันที
        </p>
      </div>

      {/* Navigation Tabs (Glass Pills) */}
      <div class="flex justify-center mb-8">
        <div class="flex p-1.5 gap-1.5 rounded-2xl bg-bg-secondary/70 backdrop-blur-sm border border-border/30 shadow-sm">
          <button
            id="tab-deals"
            class="rounded-xl px-5 py-2.5 text-xs font-bold transition-all duration-200 min-h-[44px] bg-primary text-white shadow-sm border border-transparent"
            onclick="showTab('deals')"
          >
            ดีลที่บันทึกไว้
          </button>
          <button
            id="tab-shops"
            class="rounded-xl px-5 py-2.5 text-xs font-bold transition-all duration-200 min-h-[44px] bg-transparent text-text-secondary hover:text-text-primary hover:bg-bg/40 border border-transparent"
            onclick="showTab('shops')"
          >
            ร้านค้าที่ติดตาม
          </button>
        </div>
      </div>

      {/* Saved Deals List Grid Section */}
      <div id="deals-section" class="mt-4">
        <div id="deals-list" class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {/* Loaded via JavaScript client-side */}
        </div>
        <div id="deals-loading" class="mt-12 text-center">
          <div class="mx-auto h-9 w-9 animate-spin rounded-full border-4 border-primary border-t-transparent"></div>
        </div>
        <div id="deals-empty" class="mt-8 hidden border border-dashed border-border/80 p-12 text-center rounded-2xl bg-bg-secondary/40 max-w-md mx-auto animate-fade-in">
          <div class="h-14 w-14 rounded-full bg-primary/10 text-primary flex items-center justify-center mx-auto mb-4">
            <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
            </svg>
          </div>
          <h3 class="text-base font-bold text-secondary">ยังไม่มีคูปองที่บันทึกไว้</h3>
          <p class="mt-2 text-xs text-text-secondary leading-relaxed">กดบันทึกดีลที่คุณถูกใจจากหน้าค้นหาเพื่อจัดเก็บไว้ที่นี่</p>
          <a href="/explore" class="btn btn-primary mt-6 py-2.5 px-6 rounded-xl text-xs font-bold shadow-md">
            ค้นหาดีลยอดฮิต
          </a>
        </div>
      </div>

      {/* Favorite Shops List Grid Section */}
      <div id="shops-section" class="mt-4 hidden">
        <div id="shops-list" class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {/* Loaded via JavaScript client-side */}
        </div>
        <div id="shops-loading" class="mt-12 text-center">
          <div class="mx-auto h-9 w-9 animate-spin rounded-full border-4 border-primary border-t-transparent"></div>
        </div>
        <div id="shops-empty" class="mt-8 hidden border border-dashed border-border/80 p-12 text-center rounded-2xl bg-bg-secondary/40 max-w-md mx-auto animate-fade-in">
          <div class="h-14 w-14 rounded-full bg-amber-500/10 text-amber-500 flex items-center justify-center mx-auto mb-4">
            <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.907c.961 0 1.36 1.252.587 1.813l-3.974 2.856a1 1 0 00-.364 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.856a1 1 0 00-1.176 0l-3.976 2.856c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.364-1.118L2.98 10.104c-.773-.562-.373-1.813.587-1.813h4.907a1 1 0 00.95-.69l1.519-4.674z" />
            </svg>
          </div>
          <h3 class="text-base font-bold text-secondary">ยังไม่มีร้านค้าที่คุณติดตาม</h3>
          <p class="mt-2 text-xs text-text-secondary leading-relaxed">คุณสามารถกดปุ่มรูปหัวใจเพื่อติดตามร้านค้าโปรดเพื่อไม่ให้พลาดสิทธิพิเศษ</p>
          <a href="/explore" class="btn btn-primary mt-6 py-2.5 px-6 rounded-xl text-xs font-bold shadow-md">
            ค้นหาพาร์ทเนอร์ยอดนิยม
          </a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  // ─── CLIENT SIDE STORAGE & TAB LOGIC ───
  function getSavedDeals() {
    try {
      const saved = localStorage.getItem('dealdoor_saved_deals');
      return saved ? JSON.parse(saved) : [];
    } catch {
      return [];
    }
  }

  function getFavoriteShops() {
    try {
      const saved = localStorage.getItem('dealdoor_favorite_shops');
      return saved ? JSON.parse(saved) : [];
    } catch {
      return [];
    }
  }

  function removeSavedDeal(dealId) {
    const saved = getSavedDeals().filter(id => id !== dealId);
    localStorage.setItem('dealdoor_saved_deals', JSON.stringify(saved));
    showToast('ลบคูปองที่บันทึกแล้ว', 'success');
    loadSavedDeals();
  }

  function removeFavoriteShop(shopId) {
    const saved = getFavoriteShops().filter(id => id !== shopId);
    localStorage.setItem('dealdoor_favorite_shops', JSON.stringify(saved));
    showToast('ยกเลิกติดตามร้านค้าสำเร็จ', 'success');
    loadFavoriteShops();
  }

  // Tab switching (Expose globally for inline HTML onclick attributes)
  function showTab(tab) {
    document.getElementById('deals-section')?.classList.toggle('hidden', tab !== 'deals');
    document.getElementById('shops-section')?.classList.toggle('hidden', tab !== 'shops');
    
    const dealsTabBtn = document.getElementById('tab-deals');
    const shopsTabBtn = document.getElementById('tab-shops');

    if (dealsTabBtn && shopsTabBtn) {
      if (tab === 'deals') {
        dealsTabBtn.className = 'rounded-xl px-5 py-2.5 text-xs font-bold transition-all duration-200 min-h-[44px] bg-primary text-white shadow-sm border border-transparent';
        shopsTabBtn.className = 'rounded-xl px-5 py-2.5 text-xs font-bold transition-all duration-200 min-h-[44px] bg-transparent text-text-secondary hover:text-text-primary hover:bg-bg/40 border border-transparent';
      } else {
        dealsTabBtn.className = 'rounded-xl px-5 py-2.5 text-xs font-bold transition-all duration-200 min-h-[44px] bg-transparent text-text-secondary hover:text-text-primary hover:bg-bg/40 border border-transparent';
        shopsTabBtn.className = 'rounded-xl px-5 py-2.5 text-xs font-bold transition-all duration-200 min-h-[44px] bg-primary text-white shadow-sm border border-transparent';
      }
    }
  }

  // Hydrate saved deals grid
  async function loadSavedDeals() {
    const savedIds = getSavedDeals();
    const dealsList = document.getElementById('deals-list');
    const dealsEmpty = document.getElementById('deals-empty');
    const dealsLoading = document.getElementById('deals-loading');

    if (dealsLoading) dealsLoading.classList.add('hidden');

    if (savedIds.length === 0) {
      if (dealsEmpty) dealsEmpty.classList.remove('hidden');
      if (dealsList) dealsList.innerHTML = '';
      return;
    }

    try {
      const deals = await Promise.all(
        savedIds.map(async (id) => {
          try {
            const res = await fetch('/api/deals/' + id);
            const data = await res.json();
            return data.success ? data.data : null;
          } catch {
            return null;
          }
        })
      );

      const validDeals = deals.filter(Boolean);

      if (validDeals.length === 0) {
        if (dealsEmpty) dealsEmpty.classList.remove('hidden');
        if (dealsList) dealsList.innerHTML = '';
        return;
      }

      if (dealsEmpty) dealsEmpty.classList.add('hidden');
      if (dealsList) {
        dealsList.innerHTML = validDeals.map(deal => `
          <div class="card group flex flex-col justify-between overflow-hidden bg-card-bg/60 backdrop-blur-sm border border-border/40 hover:border-primary/45 rounded-2xl p-5 hover:shadow-md transition-all duration-300">
            <div>
              <div class="flex items-start justify-between gap-2.5">
                <span class="badge border-none bg-primary/10 text-primary font-bold text-[10px]">${deal.category}</span>
                <button 
                  onclick="removeSavedDeal('${deal.id}')" 
                  class="h-11 w-11 rounded-xl flex items-center justify-center text-text-tertiary hover:text-danger hover:bg-danger-bg/25 border border-transparent transition-all" 
                  aria-label="ลบดีล"
                >
                  <svg class="h-4.5 w-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                  </svg>
                </button>
              </div>
              <h3 class="mt-3 font-extrabold text-sm text-secondary leading-snug truncate">${deal.title}</h3>
              <p class="mt-1 text-xs text-text-secondary leading-relaxed line-clamp-2">${deal.discountText || 'ไม่มีรายละเอียดเพิ่มเติม'}</p>
            </div>
            
            <div class="mt-5 pt-3.5 border-t border-border/30">
              <a href="/${deal.shopId}" class="btn btn-primary w-full py-2.5 rounded-xl text-xs font-bold justify-center shadow-md">
                ดูคูปองสิทธิ์
              </a>
            </div>
          </div>
        `).join('');
      }
    } catch (e) {
      if (dealsEmpty) dealsEmpty.classList.remove('hidden');
    }
  }

  // Hydrate favorite shops grid
  async function loadFavoriteShops() {
    const favoriteIds = getFavoriteShops();
    const shopsList = document.getElementById('shops-list');
    const shopsEmpty = document.getElementById('shops-empty');
    const shopsLoading = document.getElementById('shops-loading');

    if (shopsLoading) shopsLoading.classList.add('hidden');

    if (favoriteIds.length === 0) {
      if (shopsEmpty) shopsEmpty.classList.remove('hidden');
      if (shopsList) shopsList.innerHTML = '';
      return;
    }

    try {
      const shops = await Promise.all(
        favoriteIds.map(async (id) => {
          try {
            const res = await fetch('/api/shops/' + id);
            const data = await res.json();
            return data.success ? data.data : null;
          } catch {
            return null;
          }
        })
      );

      const validShops = shops.filter(Boolean);

      if (validShops.length === 0) {
        if (shopsEmpty) shopsEmpty.classList.remove('hidden');
        if (shopsList) shopsList.innerHTML = '';
        return;
      }

      if (shopsEmpty) shopsEmpty.classList.add('hidden');
      if (shopsList) {
        shopsList.innerHTML = validShops.map(shop => `
          <div class="card group flex flex-col justify-between overflow-hidden bg-card-bg/60 backdrop-blur-sm border border-border/40 hover:border-primary/45 rounded-2xl p-5 hover:shadow-md transition-all duration-300">
            <div class="flex items-start justify-between gap-2.5">
              <div class="flex items-center gap-3">
                <div class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-primary/10 to-orange-100/50 text-sm font-extrabold text-primary">
                  ${shop.logoImage ? `<img src="${shop.logoImage}" alt="${shop.name}" class="h-full w-full object-cover rounded-xl" />` : shop.name.charAt(0)}
                </div>
                <div class="min-w-0">
                  <h3 class="font-bold text-sm text-secondary truncate">${shop.name}</h3>
                  <p class="text-[10px] text-text-tertiary mt-0.5 uppercase tracking-wider font-semibold">${shop.category}</p>
                </div>
              </div>
              <button 
                onclick="removeFavoriteShop('${shop.id}')" 
                class="h-11 w-11 rounded-xl flex items-center justify-center text-text-tertiary hover:text-danger hover:bg-danger-bg/25 border border-transparent transition-all" 
                aria-label="ยกเลิกติดตาม"
              >
                <svg class="h-4.5 w-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                </svg>
              </button>
            </div>

            <div class="mt-5 pt-3.5 border-t border-border/30">
              <a href="/${shop.slug}" class="btn btn-primary w-full py-2.5 rounded-xl text-xs font-bold justify-center shadow-md">
                เข้าชมหน้าร้าน
              </a>
            </div>
          </div>
        `).join('');
      }
    } catch (e) {
      if (shopsEmpty) shopsEmpty.classList.remove('hidden');
    }
  }

  // Toast notification popup helper
  function showToast(message: string, type: 'success' | 'error' = 'success') {
    const container = document.getElementById('toast-container');
    if (!container) return;

    const toast = document.createElement('div');
    toast.className = `flex items-center gap-3 rounded-2xl px-4 py-3 shadow-xl text-xs font-bold animate-slide-down border ${
      type === 'success' 
        ? 'bg-[#10B981] border-[#10B981]/15 text-white' 
        : 'bg-danger border-danger/15 text-white'
    }`;
    toast.innerHTML = `
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        ${type === 'success' 
          ? '<path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />'
          : '<path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />'
        }
      </svg>
      <span>${message}</span>
    `;
    container.appendChild(toast);

    setTimeout(() => {
      toast.remove();
    }, 3000);
  }

  // EXPOSE FUNCTIONS TO WINDOW FOR INLINE ONCLICK EVENT BINDINGS
  (window as any).showTab = showTab;
  (window as any).removeSavedDeal = removeSavedDeal;
  (window as any).removeFavoriteShop = removeFavoriteShop;

  // Initialize
  document.addEventListener('DOMContentLoaded', () => {
    loadSavedDeals();
    loadFavoriteShops();
  });
</script>

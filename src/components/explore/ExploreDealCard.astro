---
// src/components/explore/ExploreDealCard.astro

import type { Deal, Shop } from '../../lib/db-schema';
import { getDealViewModel } from '../../lib/deals/view-model';
import Icon from '../icons/index.astro';
import SaveButton from '../shared/SaveButton.tsx';
import { getLangFromRequest, t } from '../../i18n';

interface Props {
  deal: Deal;
  shop: Shop;
  featured?: boolean;
  highlighted?: boolean;
  isPromoted?: boolean;
}

const { deal, shop, featured = false, highlighted = false, isPromoted = false } = Astro.props;
const lang = getLangFromRequest(Astro.request);
const common = (key: string) => t(lang, 'common', key);
const publicText = (key: string, params?: Record<string, string | number>) => t(lang, 'public', key, params);
const view = getDealViewModel(deal, shop);
const isExpired = view.urgency === 'expired';
const isCriticalSoon = view.urgency === 'soon' && view.daysLeft <= 1;

const ringWindowDays = 7;
const ringPercent = view.urgency === 'soon'
  ? Math.max(0, Math.min(100, (view.daysLeft / ringWindowDays) * 100))
  : 0;
const ringCircumference = 2 * Math.PI * 15;
const ringOffset = ringCircumference * (1 - ringPercent / 100);

// Map categories to fallback gradient backgrounds
let fallbackBg = 'from-primary/10 to-orange-100/50';
let emoji = '🏷️';
if (deal.category === 'cafe') {
  fallbackBg = 'from-amber-100 to-amber-200/50';
  emoji = '☕';
} else if (deal.category === 'food') {
  fallbackBg = 'from-orange-100 to-red-100';
  emoji = '🍜';
} else if (deal.category === 'dessert') {
  fallbackBg = 'from-pink-100 to-rose-200/50';
  emoji = '🍰';
} else if (deal.category === 'beauty') {
  fallbackBg = 'from-purple-100 to-pink-200/50';
  emoji = '💇';
} else if (deal.category === 'service') {
  fallbackBg = 'from-blue-100 to-cyan-200/50';
  emoji = '🛠️';
} else if (deal.category === 'event') {
  fallbackBg = 'from-yellow-100 to-orange-200/50';
  emoji = '🎉';
}

// Parse original vs promo prices from discountText
const discountLabel = view.discountLabel || '';
const priceMatchResult = discountLabel.match(/฿([\d,]+)\s*\(ปกติ\s*฿([\d,]+)\)/);
let priceMatch = null;
if (priceMatchResult) {
  const promoStr = priceMatchResult[1];
  const originalStr = priceMatchResult[2];
  const promo = parseInt(promoStr.replace(/,/g, ''));
  const original = parseInt(originalStr.replace(/,/g, ''));
  const saving = original - promo;
  priceMatch = {
    promo: promoStr,
    original: originalStr,
    saving: saving.toLocaleString(),
    percent: original > 0 ? Math.round((saving / original) * 100) : 0,
  };
}
---

<a
  href={view.urls.deal || `/${shop.slug}?deal=${deal.id}`}
  data-boost-impression={isPromoted ? 'true' : undefined}
  data-deal-id={isPromoted ? deal.id : undefined}
  data-shop-id={isPromoted ? shop.id : undefined}
  class:list={[
    'group block overflow-hidden bg-card-bg/65 backdrop-blur-md border border-border/15 rounded-[24px] hover:shadow-xl hover:shadow-primary/5 hover:-translate-y-1.5 hover:border-primary/25 transition-all duration-300 relative cursor-pointer flex h-full flex-col justify-between shadow-sm',
    isExpired && 'opacity-65 grayscale-[20%]',
    isCriticalSoon && !isExpired && 'animate-pulse-danger border-danger/30',
    highlighted && 'ring-2 ring-primary/70 border-primary/60 shadow-lg shadow-primary/10',
  ]}
  aria-label={`${publicText('deal.viewDeal')}: ${view.title} · ${shop.name}`}
>
  {/* Visual Cover Photo (4:3 Ratio, or 16:9 for featured) */}
  <div class:list={['relative overflow-hidden bg-bg-secondary flex items-center justify-center shrink-0', featured ? 'aspect-[16/9]' : 'aspect-[4/3]']}>
    {view.imageUrl ? (
      <img
        src={view.imageUrl}
        alt={view.imageAlt}
        loading="lazy"
        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
      />
    ) : (
      <div class={`w-full h-full bg-gradient-to-tr ${fallbackBg} flex items-center justify-center text-4xl select-none group-hover:scale-[1.04] transition-transform duration-500`}>
        {emoji}
      </div>
    )}

    {/* Discount Sticker Ribbon - diagonal corner banner */}
    {priceMatch && priceMatch.percent > 0 && (
      <div class="absolute -left-10 top-4 w-36 rotate-[-45deg] bg-gradient-to-r from-danger to-primary py-1.5 text-center shadow-md z-10">
        <span class="text-sm font-black tracking-wider text-white">-{priceMatch.percent}%</span>
      </div>
    )}

    {isPromoted && (
      <span class:list={[
        'absolute left-3 z-10 inline-flex items-center gap-1 rounded-full bg-primary px-2 py-1 text-[9px] font-black text-white shadow-sm',
        priceMatch ? 'top-12' : 'top-3',
      ]}>
        <Icon name="rocket" class="h-3 w-3" />
        {publicText('deal.promoted')}
      </span>
    )}

    {/* Category Pill Tag Overlay - color-coded by deal category */}
    <span
      class="absolute bottom-3 left-3 text-[9px] font-black px-2.5 py-1 rounded-full shadow-sm tracking-wider uppercase text-white"
      style={`background-color:${view.categoryColor};`}
    >
      {view.categoryLabel}
    </span>

    {/* Urgency countdown ring (soon) or plain badge (expired / normal) */}
    {view.urgency === 'soon' ? (
      <div class="absolute bottom-3 right-3 flex items-center gap-1.5 rounded-full bg-black/50 py-1 pl-1 pr-2 backdrop-blur-md shadow-sm">
        <svg viewBox="0 0 36 36" class="h-6 w-6 -rotate-90">
          <circle cx="18" cy="18" r="15" fill="none" stroke="rgba(255,255,255,0.25)" stroke-width="3" />
          <circle
            cx="18" cy="18" r="15" fill="none" stroke="#EF4444" stroke-width="3"
            stroke-linecap="round"
            stroke-dasharray={ringCircumference}
            stroke-dashoffset={ringOffset}
          />
        </svg>
        <span class="text-[9px] font-black text-white">{view.expiryLabel}</span>
      </div>
    ) : view.expiryLabel && (
      <span class:list={[
        'absolute bottom-3 right-3 text-[9px] font-black px-2 py-0.5 rounded-md border border-white/10 backdrop-blur-md shadow-sm text-white',
        isExpired ? 'bg-rose-600/80' : 'bg-black/50'
      ]}>
        {view.expiryLabel}
      </span>
    )}

    {/* Save Button (Heart Badge) Overlay top-right */}
    <SaveButton
      client:visible
      dealId={deal.id}
      variant="icon"
      className="absolute right-3 top-3 z-20 flex h-9 w-9 items-center justify-center rounded-full border border-white/20 bg-white/90 p-0 text-secondary shadow-sm backdrop-blur-sm transition-all duration-300 hover:scale-110 hover:bg-white hover:text-rose-500 active:scale-95 dark:bg-black/60 dark:text-white"
    />
  </div>

  {/* Card Content body */}
  <div class="p-4 flex-1 flex flex-col justify-between space-y-3">
    
    {/* Deal Title & Description */}
    <div class="space-y-1">
      <h3 class="text-sm font-extrabold text-secondary leading-snug line-clamp-1 group-hover:text-primary transition-colors duration-200">
        {view.title}
      </h3>
      <p class="text-[11px] font-bold text-text-secondary line-clamp-2 leading-relaxed">
        {view.summary}
      </p>
    </div>

    {/* Price & Savings Stats Block */}
    <div class="pt-1.5 flex items-center flex-wrap gap-1.5 border-t border-border/15">
      {priceMatch ? (
        <>
          <span class="text-base font-black text-primary tracking-tight">
            ฿{priceMatch.promo}
          </span>
          <span class="text-[10px] line-through text-text-tertiary font-bold ml-0.5">
            {publicText('deal.regularPrice', { price: priceMatch.original })}
          </span>
          <span class="text-[9px] font-black text-emerald-600 dark:text-emerald-400 bg-emerald-500/10 px-1.5 py-0.5 rounded ml-auto">
            {publicText('deal.saveAmount', { amount: priceMatch.saving })}
          </span>
        </>
      ) : (
        <>
          <span class="text-xs font-black text-primary bg-primary/10 px-2 py-1 rounded-lg">
            {view.discountLabel}
          </span>
        </>
      )}
    </div>

    {/* Merchant/Shop Logo Profile Footer Section */}
    <div class="flex items-center justify-between pt-2 border-t border-border/15">
      <div class="flex items-center gap-2 min-w-0">
        <div class="h-6 w-6 rounded-full bg-gradient-to-br from-primary/10 to-orange-100/50 flex-shrink-0 flex items-center justify-center text-[10px] font-black text-primary overflow-hidden border border-border/20 shadow-sm">
          {shop.logoImage ? (
            <img src={shop.logoImage} alt={shop.name} class="h-full w-full object-cover" />
          ) : (
            shop.name.charAt(0).toUpperCase()
          )}
        </div>
        <div class="min-w-0">
          <p class="text-[9px] font-black text-secondary truncate flex items-center gap-0.5">
            <span>{shop.name}</span>
            <span class="text-primary text-[7px] select-none">✓</span>
          </p>
          <p class="text-[8px] text-text-tertiary truncate">
            {view.shop.addressShort || publicText('deal.shopLocation')}
          </p>
        </div>
      </div>

      {/* Sleek Minimal Arrow Link */}
      <div class="h-6 w-6 rounded-full bg-bg-secondary flex items-center justify-center text-text-secondary group-hover:bg-primary group-hover:text-white transition-all duration-300 shrink-0">
        <Icon name="arrow-right" class="h-3 w-3" />
      </div>
    </div>
  </div>
</a>

<script>
  const promotedCards = document.querySelectorAll('[data-boost-impression="true"]');
  if ('IntersectionObserver' in window && promotedCards.length) {
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting || entry.intersectionRatio < 0.6) continue;
        const card = entry.target as HTMLElement;
        observer.unobserve(card);
        fetch('/api/analytics/track', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          keepalive: true,
          body: JSON.stringify({
            type: 'deal_impression',
            shopId: card.dataset.shopId,
            dealId: card.dataset.dealId,
            metadata: { placement: 'boost', surface: window.location.pathname },
          }),
        }).catch(() => {});
      }
    }, { threshold: 0.6 });
    promotedCards.forEach((card) => observer.observe(card));
  }
</script>

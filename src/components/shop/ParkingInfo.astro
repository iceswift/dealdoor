---
// src/components/shop/ParkingInfo.astro

import type { Shop } from '../../db/schema';

interface Props {
  shop: Shop;
}

const { shop } = Astro.props;

const parkingFeatures = [
  { key: 'freeParking', label: 'ที่จอดรถฟรี', icon: '🅿️' },
  { key: 'paidParking', label: 'ที่จอดรถเสียเงิน', icon: '💰' },
  { key: 'motorcycleParking', label: 'ที่จอดมอเตอร์ไซค์', icon: '🏍️' },
  { key: 'evCharging', label: 'ชาร์จ EV', icon: '⚡' },
];

const activeParking = parkingFeatures.filter(f => shop[f.key as keyof Shop]);
const hasTransport = shop.nearbyBts || shop.nearbyMrt;
---

{(activeParking.length > 0 || hasTransport) && (
  <section class="mt-6">
    <h2 class="mb-3 text-lg font-semibold text-secondary">🅿️ ที่จอดรถ & การเดินทาง</h2>
    
    {/* Parking */}
    {activeParking.length > 0 && (
      <div class="flex flex-wrap gap-2">
        {activeParking.map(feature => (
          <div class="flex items-center gap-2 rounded-lg border border-border bg-bg-secondary px-3 py-2">
            <span class="text-lg">{feature.icon}</span>
            <span class="text-sm font-medium text-text-primary">{feature.label}</span>
          </div>
        ))}
      </div>
    )}

    {/* Nearby Transit */}
    {(shop.nearbyBts || shop.nearbyMrt) && (
      <div class="mt-3 space-y-1">
        {shop.nearbyBts && (
          <div class="flex items-center gap-2 text-sm text-text-secondary">
            <span>🚆</span>
            <span>BTS: {shop.nearbyBts}</span>
          </div>
        )}
        {shop.nearbyMrt && (
          <div class="flex items-center gap-2 text-sm text-text-secondary">
            <span>🚇</span>
            <span>MRT: {shop.nearbyMrt}</span>
          </div>
        )}
      </div>
    )}

    {shop.parkingNotes && (
      <p class="mt-2 text-sm text-text-secondary">{shop.parkingNotes}</p>
    )}
  </section>
)}

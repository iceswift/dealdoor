---
// src/components/shop/MenuList.astro

import type { MenuItem } from '../../lib/db-schema';
import { formatPrice } from '../../lib/utils';
import Icon from '../icons/index.astro';

interface Props {
  // ─── BACKEND DATABASE BINDINGS ───
  items: MenuItem[];
  // ─────────────────────────────────
}

const { items } = Astro.props;
---

{items.length > 0 && (
  <section class="mt-8 rounded-3xl border border-border/40 bg-card-bg/60 backdrop-blur-sm p-6 shadow-md">
    <h2 class="mb-5 text-xl font-bold text-secondary flex items-center gap-2.5">
      <Icon name="clipboard" class="h-5.5 w-5.5 text-primary" />
      เมนู & แคตตาล็อกสินค้า ({items.length})
    </h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {items.map((item) => (
        <div class="card group flex items-center gap-4 p-3 bg-bg/50 border border-border/30 hover:border-primary/30 rounded-2xl hover:shadow-md transition-all duration-300">
          {/* MenuItem Image Container */}
          <div class="h-16 w-16 flex-shrink-0 overflow-hidden rounded-xl bg-bg-secondary relative border border-border/20">
            {item.imageUrl ? (
              <img src={item.imageUrl} alt={item.name} class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-108" loading="lazy" />
            ) : (
              <div class="flex h-full items-center justify-center text-text-tertiary">
                <Icon name="store" class="h-6 w-6 text-primary/35" />
              </div>
            )}
          </div>
          
          {/* MenuItem Info */}
          <div class="flex-1 min-w-0">
            <h3 class="font-bold text-sm text-secondary truncate group-hover:text-primary transition-colors">
              {item.name}
            </h3>
            {item.description && (
              <p class="mt-1 text-xs text-text-secondary line-clamp-1 leading-relaxed">{item.description}</p>
            )}
          </div>
          
          {/* MenuItem Price */}
          {item.price && (
            <span class="text-sm font-extrabold text-primary flex-shrink-0 bg-primary/5 px-2.5 py-1.5 rounded-xl border border-primary/10">
              {formatPrice(item.price)}
            </span>
          )}
        </div>
      ))}
    </div>
  </section>
)}

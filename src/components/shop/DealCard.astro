---
// src/components/shop/DealCard.astro

import type { Deal, Shop } from '../../lib/db-schema';
import { getDealViewModel } from '../../lib/deals/view-model';
import SaveButton from '../shared/SaveButton.tsx';
import Icon from '../icons/index.astro';
import { getLangFromRequest, t } from '../../i18n';

interface Props {
  deal: Deal;
  shop: Shop;
  highlighted?: boolean;
}

const { deal, shop, highlighted = false } = Astro.props;
const lang = getLangFromRequest(Astro.request);
const publicText = (key: string, params?: Record<string, string | number>) => t(lang, 'public', key, params);
const view = getDealViewModel(deal, shop);
const isExpired = view.urgency === 'expired';
---

<article
  class:list={[
    'card relative overflow-hidden group transition-all duration-300 border border-border/50 bg-card-bg/60 backdrop-blur-sm rounded-2xl hover:border-primary/40 hover:-translate-y-1 hover:shadow-lg hover:shadow-primary/5',
    isExpired && 'opacity-65 grayscale-[30%]',
    highlighted && 'ring-2 ring-primary/70 border-primary/60 shadow-lg shadow-primary/10',
  ]}
  data-deal-id={deal.id}
  aria-label={`${publicText('deal.viewDeal')}: ${view.title}`}
>
  <div class="h-1.5 w-full" style={`background-color: ${view.categoryColor}`} />

  {view.imageUrl && (
    <div class="relative aspect-[16/9] overflow-hidden bg-bg-secondary">
      <img
        src={view.imageUrl}
        alt={view.imageAlt}
        loading="lazy"
        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
      />
      <div class="absolute left-4 top-4">
        <span
          class="badge border-none font-bold shadow-sm"
          style={`background-color: ${view.categoryColor}18; color: ${view.categoryColor}`}
        >
          {view.categoryLabel}
        </span>
      </div>
    </div>
  )}

  <div class="px-5 py-4">
    <div class="flex items-center justify-between gap-3">
      {!view.imageUrl && (
        <span
          class="badge border-none font-bold"
          style={`background-color: ${view.categoryColor}12; color: ${view.categoryColor}`}
        >
          {view.categoryLabel}
        </span>
      )}

      <span
        class:list={[
          'badge border-none font-bold',
          view.urgency === 'soon' && 'bg-amber-500/10 text-amber-600 dark:text-amber-400',
          view.urgency === 'normal' && 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400',
          view.urgency === 'expired' && 'bg-rose-500/10 text-rose-600 dark:text-rose-400',
        ]}
      >
        <Icon name="clock" class="h-3.5 w-3.5" />
        <span>{view.expiryLabel}</span>
      </span>
    </div>

    <h3 class="mt-4 text-lg font-bold tracking-tight text-secondary group-hover:text-primary transition-colors duration-200">
      {view.title}
    </h3>

    <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-text-secondary">{view.summary}</p>

    {view.discountLabel && (
      <div class="mt-4 rounded-2xl border border-border/20 p-4" style={`background-color: ${view.categoryColor}10`}>
        <div class="flex items-start gap-3">
          <Icon name="tag" class="mt-0.5 h-5 w-5 flex-shrink-0" style={`color: ${view.categoryColor}`} />
          <div>
            <p class="text-[11px] font-bold uppercase tracking-wide text-text-tertiary">{publicText('deal.specialOffer')}</p>
            <p class="text-base font-extrabold" style={`color: ${view.categoryColor}`}>{view.discountLabel}</p>
          </div>
        </div>
      </div>
    )}

    {isExpired && (
      <div class="mt-4 rounded-xl bg-bg-secondary p-3 text-sm font-bold text-text-tertiary">
        {publicText('deal.expiredNotice')}
      </div>
    )}
  </div>

  {!isExpired && (
    <div class="flex flex-col gap-3 border-t border-border/50 px-5 py-4 bg-bg-secondary/40 backdrop-blur-sm">
      <div class="flex items-center gap-3">
        {view.claimType === 'copy_code' && view.couponCode && (
          <button
            class="btn btn-primary min-h-[44px] flex-1 rounded-xl px-4 py-2.5 text-xs font-bold copy-code-btn"
            data-code={view.couponCode}
            aria-label={`คัดลอกโค้ด ${view.couponCode}`}
          >
            <Icon name="copy" class="h-4 w-4" />
            <span>{view.claimLabel}</span>
          </button>
        )}

        {view.claimType === 'show_at_shop' && (
          <button class="btn btn-primary min-h-[44px] flex-1 rounded-xl px-4 py-2.5 text-xs font-bold">
            <Icon name="store" class="h-4 w-4" />
            <span>{view.claimLabel}</span>
          </button>
        )}

        {view.claimType === 'contact_shop' && (
          <a href={view.shop.phoneUrl || view.urls.shop || '#'} class="btn btn-primary min-h-[44px] flex-1 rounded-xl px-4 py-2.5 text-xs font-bold">
            <Icon name="phone" class="h-4 w-4" />
            <span>{view.claimLabel}</span>
          </a>
        )}

        {view.claimType === 'open_line' && view.shop.lineUrl && (
          <a
            href={view.shop.lineUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn min-h-[44px] flex-1 rounded-xl border-none bg-[#06C755] px-4 py-2.5 text-xs font-bold text-white shadow-md shadow-[#06C755]/10 hover:bg-[#05B34C]"
          >
            <Icon name="line" class="h-4 w-4" />
            <span>{view.claimLabel}</span>
          </a>
        )}

        <button
          class="btn btn-secondary min-h-[44px] rounded-xl px-4 py-2.5 text-xs font-bold open-deal-detail-btn"
          data-deal-url={view.urls.deal}
        >
          {publicText('deal.viewDetails')}
        </button>
      </div>

      <div class="flex items-center justify-between">
        <p class="text-[11px] font-semibold text-text-tertiary">
          {view.claimLabel} · {view.expiryLabel}
        </p>
        <div class="flex items-center gap-2">
          <SaveButton client:visible dealId={deal.id} />
          <button
            class="btn btn-ghost min-h-[44px] min-w-[44px] rounded-xl p-2.5 share-deal-btn"
            data-deal-id={deal.id}
            data-deal-title={view.title}
            data-share-text={view.shareText}
            aria-label={`แชร์ดีล ${view.title}`}
          >
            <Icon name="share" class="h-4.5 w-4.5" />
          </button>
        </div>
      </div>
    </div>
  )}
</article>

<script>
  document.querySelectorAll('.copy-code-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const code = btn.getAttribute('data-code');
      if (!code) return;

      try {
        await navigator.clipboard.writeText(code);
        const originalHTML = btn.innerHTML;
        btn.innerHTML = '<span>คัดลอกแล้ว</span>';
        btn.classList.add('!bg-green-500', '!text-white', '!border-transparent');

        setTimeout(() => {
          btn.innerHTML = originalHTML;
          btn.classList.remove('!bg-green-500', '!text-white', '!border-transparent');
        }, 1800);
      } catch (err) {
        console.error('Failed to copy coupon code:', err);
      }
    });
  });

  document.querySelectorAll('.open-deal-detail-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const url = btn.getAttribute('data-deal-url');
      if (url) window.location.href = url;
    });
  });

  document.querySelectorAll('.share-deal-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const dealId = btn.getAttribute('data-deal-id');
      const dealTitle = btn.getAttribute('data-deal-title') || 'DealDoor deal';
      const text = btn.getAttribute('data-share-text') || dealTitle;
      const url = `${window.location.origin}${window.location.pathname}?deal=${dealId}`;

      if (navigator.share && /Mobi|Android/i.test(navigator.userAgent)) {
        try {
          await navigator.share({ title: dealTitle, text, url });
          return;
        } catch {
          // Fall back to clipboard when native share is cancelled or unavailable.
        }
      }

      try {
        await navigator.clipboard.writeText(url);
        const original = btn.innerHTML;
        btn.innerHTML = '<span class="text-xs font-bold">คัดลอกแล้ว</span>';
        setTimeout(() => {
          btn.innerHTML = original;
        }, 1600);
      } catch (err) {
        console.error('Failed to share deal:', err);
      }
    });
  });
</script>

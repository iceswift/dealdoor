  )}
  
  {/* Theme & Drawer Management Script */}
  <script is:inline>
    // Theme toggle
    const themeToggle = document.getElementById('theme-toggle');
    const iconLight = document.getElementById('theme-icon-light');
    const iconDark = document.getElementById('theme-icon-dark');
    
    function updateThemeIcon() {
      const isDark = document.documentElement.classList.contains('dark');
      iconLight?.classList.toggle('hidden', isDark);
      iconDark?.classList.toggle('hidden', !isDark);
    }
    
    function toggleTheme() {
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
      updateThemeIcon();
    }
    
    themeToggle?.addEventListener('click', toggleTheme);
    
    updateThemeIcon();
    
    // Mobile drawer toggles
    const mobileMenuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const menuIconOpen = document.getElementById('menu-icon-open');
    const menuIconClose = document.getElementById('menu-icon-close');
    
    mobileMenuBtn?.addEventListener('click', () => {
      if (!mobileMenu) return;
      const isClosed = mobileMenu.classList.toggle('hidden');
      mobileMenuBtn.setAttribute('aria-expanded', !isClosed ? 'true' : 'false');
      menuIconOpen?.classList.toggle('hidden', !isClosed);
      menuIconClose?.classList.toggle('hidden', isClosed);
      
      // Toggle body scrolling to prevent background scroll
      document.body.classList.toggle('overflow-hidden', !isClosed);
    });
    
    // Close mobile menu on clicking links, excluding theme switcher clicks
    mobileMenu?.addEventListener('click', (e) => {
      if (e.target.closest('a') || (e.target.closest('button') && !e.target.closest('.theme-toggle'))) {
        mobileMenu.classList.add('hidden');
        mobileMenuBtn.setAttribute('aria-expanded', 'false');
        menuIconOpen?.classList.remove('hidden');
        menuIconClose?.classList.add('hidden');
        document.body.classList.remove('overflow-hidden');
      }
    });

    // ─── BACKEND COMPONENT: SECURITY SIGN-OUT EVENT ───
    async function handleLogout() {
      try {
        await fetch('/api/auth/logout', { method: 'POST' });
        window.location.href = '/';
      } catch (err) {
        console.error('Logout failed:', err);
        window.location.href = '/';
      }
    }
    // ─── USER DROP-DOWN MENU CONTROLLER ───
    const dropdownAvatarBtn = document.getElementById('dropdown-avatar-btn');
    const userDropdownMenu = document.getElementById('user-dropdown-menu');

    function positionUserDropdownMenu() {
      if (!dropdownAvatarBtn || !userDropdownMenu) return;
      if (userDropdownMenu.parentElement !== document.body) {
        document.body.appendChild(userDropdownMenu);
      }

      const triggerRect = dropdownAvatarBtn.getBoundingClientRect();
      const menuWidth = userDropdownMenu.offsetWidth || 256;
      const left = Math.min(window.innerWidth - menuWidth - 16, Math.max(16, triggerRect.right - menuWidth));
      const top = triggerRect.bottom + 8;

      userDropdownMenu.style.position = 'fixed';
      userDropdownMenu.style.left = `${left}px`;
      userDropdownMenu.style.right = 'auto';
      userDropdownMenu.style.top = `${top}px`;
      userDropdownMenu.style.zIndex = '2147483647';
    }

    function openUserDropdownMenu() {
      closeSettingsDropdownMenu();
      positionUserDropdownMenu();
      dropdownAvatarBtn?.setAttribute('aria-expanded', 'true');
      userDropdownMenu?.classList.remove('scale-95', 'opacity-0', 'pointer-events-none');
      userDropdownMenu?.classList.add('scale-100', 'opacity-100', 'pointer-events-auto');
    }

    function closeUserDropdownMenu() {
      dropdownAvatarBtn?.setAttribute('aria-expanded', 'false');
      userDropdownMenu?.classList.remove('scale-100', 'opacity-100', 'pointer-events-auto');
      userDropdownMenu?.classList.add('scale-95', 'opacity-0', 'pointer-events-none');
    }
    
    dropdownAvatarBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      const isExpanded = dropdownAvatarBtn.getAttribute('aria-expanded') === 'true';
      if (!isExpanded) {
        openUserDropdownMenu();
      } else {
        closeUserDropdownMenu();
      }
    });

    // ─── SETTINGS DROP-DOWN MENU CONTROLLER ───
    const dropdownSettingsBtn = document.getElementById('dropdown-settings-btn');
    const settingsDropdownMenu = document.getElementById('settings-dropdown-menu');

    function positionSettingsDropdownMenu() {
      if (!dropdownSettingsBtn || !settingsDropdownMenu) return;
      if (settingsDropdownMenu.parentElement !== document.body) {
        document.body.appendChild(settingsDropdownMenu);
      }

      const triggerRect = dropdownSettingsBtn.getBoundingClientRect();
      const menuWidth = settingsDropdownMenu.offsetWidth || 224;
      const left = Math.min(window.innerWidth - menuWidth - 16, Math.max(16, triggerRect.right - menuWidth));
      const top = triggerRect.bottom + 8;

      settingsDropdownMenu.style.position = 'fixed';
      settingsDropdownMenu.style.left = `${left}px`;
      settingsDropdownMenu.style.right = 'auto';
      settingsDropdownMenu.style.top = `${top}px`;
      settingsDropdownMenu.style.zIndex = '2147483647';
    }

    function openSettingsDropdownMenu() {
      closeUserDropdownMenu();
      positionSettingsDropdownMenu();
      dropdownSettingsBtn?.setAttribute('aria-expanded', 'true');
      settingsDropdownMenu?.classList.remove('scale-95', 'opacity-0', 'pointer-events-none');
      settingsDropdownMenu?.classList.add('scale-100', 'opacity-100', 'pointer-events-auto');
    }

    function closeSettingsDropdownMenu() {
      dropdownSettingsBtn?.setAttribute('aria-expanded', 'false');
      settingsDropdownMenu?.classList.remove('scale-100', 'opacity-100', 'pointer-events-auto');
      settingsDropdownMenu?.classList.add('scale-95', 'opacity-0', 'pointer-events-none');
    }
    
    dropdownSettingsBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      const isExpanded = dropdownSettingsBtn.getAttribute('aria-expanded') === 'true';
      if (!isExpanded) {
        openSettingsDropdownMenu();
      } else {
        closeSettingsDropdownMenu();
      }
    });
    
    // Close dropdown on outside click
    document.addEventListener('click', (e) => {
      if (userDropdownMenu && !userDropdownMenu.classList.contains('opacity-0')) {
        if (!userDropdownMenu.contains(e.target) && !dropdownAvatarBtn?.contains(e.target)) {
          closeUserDropdownMenu();
        }
      }
      if (settingsDropdownMenu && !settingsDropdownMenu.classList.contains('opacity-0')) {
        if (!settingsDropdownMenu.contains(e.target) && !dropdownSettingsBtn?.contains(e.target)) {
          closeSettingsDropdownMenu();
        }
      }
    });
    
    // Close dropdown on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        if (userDropdownMenu && !userDropdownMenu.classList.contains('opacity-0')) {
          closeUserDropdownMenu();
        }
        if (settingsDropdownMenu && !settingsDropdownMenu.classList.contains('opacity-0')) {
          closeSettingsDropdownMenu();
        }
      }
    });

    window.addEventListener('resize', () => {
      if (userDropdownMenu && !userDropdownMenu.classList.contains('opacity-0')) {
        positionUserDropdownMenu();
      }
      if (settingsDropdownMenu && !settingsDropdownMenu.classList.contains('opacity-0')) {
        positionSettingsDropdownMenu();
      }
    });
    // ───────────────────────────────────────
    
    document.getElementById('logout-btn')?.addEventListener('click', handleLogout);
    document.getElementById('logout-btn-mobile')?.addEventListener('click', handleLogout);
  </script>
  
  <!-- Main Content Route Anchor -->
  <main id="main-content" class="transition-all duration-300">
    <slot />
  </main>
  
  <!-- Redesigned Footer -->
  {!hideFooter && (
  <footer class="border-t border-border bg-bg-secondary py-12 mt-20 relative overflow-hidden">
    <div class="absolute inset-0 pointer-events-none opacity-40">
      <div class="absolute right-0 bottom-0 h-72 w-72 rounded-full bg-primary/5 blur-3xl"></div>
    </div>
    
    <div class="mx-auto max-w-4xl px-4 relative z-10">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center text-center md:text-left">
        <div>
          <span class="text-lg font-bold text-primary">DealDoor</span>
          <p class="mt-2 text-sm text-text-secondary max-w-sm">
            {common('brand.description')}
          </p>
        </div>
        <div class="flex flex-col md:items-end gap-3 text-sm text-text-tertiary">
          <p class="font-medium text-text-secondary">{common('shopPage.createdBy')} Team</p>
          <div class="flex flex-wrap justify-center md:justify-end gap-x-6 gap-y-2">
            <a href={localizedPath('/terms')} class="hover:text-primary transition-colors">{common('footer.terms')}</a>
            <a href={localizedPath('/privacy')} class="hover:text-primary transition-colors">{common('footer.privacy')}</a>
            <a href={localizedPath('/cookies')} class="hover:text-primary transition-colors">{common('footer.cookies')}</a>
            <button type="button" id="cookie-settings-btn" class="hover:text-primary transition-colors">Cookie settings</button>
          </div>
        </div>
      </div>
      <div class="mt-8 pt-8 border-t border-border/40 text-center text-xs text-text-tertiary">
        &copy; {new Date().getFullYear()} DealDoor. {common('footer.copyright')}
      </div>
    </div>
  </footer>
  )}

  <!-- Cookie Banner -->
  <CookieBanner client:idle />
  <script>
    document.getElementById('cookie-settings-btn')?.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('dealdoor:open-cookie-settings'));
    });
  </script>
  
  <!-- PWA Install Prompt -->
  <InstallPrompt client:idle />
  
  <!-- Service Worker Registration -->
  <script is:inline define:vars={{ isProd }}>
    if (isProd) {
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js')
            .then((registration) => {
              console.log('SW registered:', registration.scope);
            })
            .catch((error) => {
              console.log('SW registration failed:', error);
            });
        });
      }
    } else {
      // Dev mode: unregister any service worker and clear caches left over
      // from earlier testing so local changes show up without a hard refresh.
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.getRegistrations().then((registrations) => {
          registrations.forEach((registration) => registration.unregister());
        });
      }
      if ('caches' in window) {
        caches.keys().then((keys) => keys.forEach((key) => caches.delete(key)));
      }
    }
  </script>
  
  <!-- Toast Container -->
  <div id="toast-container" class="fixed right-4 top-4 z-[1000] flex flex-col gap-2"></div>
</body>
</html>

---
// src/layouts/BaseLayout.astro

import '../styles/global.css';
import '../lib/toast';
import { getLangFromRequest, getLocalizedPath, LANGUAGES, t, type Language } from '../i18n';
import CookieBanner from '../components/shared/CookieBanner.tsx';
import InstallPrompt from '../components/shared/InstallPrompt.tsx';
import ThemeToggle from '../components/shared/ThemeToggle.astro';
import NotificationBell from '../components/shared/NotificationBell.tsx';
import { getDashboardContext } from '../lib/dashboard/server';

interface Props {
  title: string;
  description?: string;
  image?: string;
  url?: string;
  type?: string;
  hideHeader?: boolean;
  hideFooter?: boolean;
}

const {
  title,
  description,
  image = '/og-default.png',
  url = Astro.url.href,
  type = 'website',
  hideHeader = false,
  hideFooter = false,
} = Astro.props;

const isProd = import.meta.env.PROD;

const lang = (Astro.locals.language as Language | undefined) || getLangFromRequest(Astro.request);
const common = (key: string, params?: Record<string, string | number>) => 
  t(lang, 'common', key, params);
const localizedPath = (path: string) => getLocalizedPath(path, lang);
const alternateLanguage = lang === 'en' ? 'th' : 'en';

const fullTitle = `${title} | DealDoor`;
const defaultDescription = common('brand.description');
const metaDescription = description || defaultDescription;
const siteUrl = Astro.site?.href || 'https://dealdoor.co';

// ─── BACKEND WORKFLOW: AUTHENTICATED USER SESSION ───
// This locals variable is injected by src/middleware.ts.
// It detects and validates user session credentials from cookies.
const user = Astro.locals.user;
const dashboardContext = user ? await getDashboardContext(user) : null;
const profileShop = dashboardContext?.shop ?? null;
const profileName = profileShop?.name || user?.name || '';
const profileAvatar = profileShop?.logoImage || null;
const profileTier = user?.role === 'admin' ? 'Admin' : profileShop?.tier === 'pro' ? 'Pro' : 'Free';
// ────────────────────────────────────────────────────
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  
  <!-- Fonts: Plus Jakarta Sans & Noto Sans Thai -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Noto+Sans+Thai:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  
  <!-- Primary Meta Tags -->
  <title>{fullTitle}</title>
  <meta name="title" content={fullTitle} />
  <meta name="description" content={metaDescription} />
  
  <!-- Open Graph / Facebook -->
  <meta property="og:type" content={type} />
  <meta property="og:url" content={url} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={metaDescription} />
  <meta property="og:image" content={`${siteUrl}${image}`} />
  <meta property="og:site_name" content="DealDoor" />
  <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'th_TH'} />
  
  <!-- Twitter -->
  <meta property="twitter:card" content="summary_large_image" />
  <meta property="twitter:url" content={url} />
  <meta property="twitter:title" content={fullTitle} />
  <meta property="twitter:description" content={metaDescription} />
  <meta property="twitter:image" content={`${siteUrl}${image}`} />
  
  <!-- Canonical -->
  <link rel="canonical" href={url} />
  
  <!-- Alternate Languages -->
  <link rel="alternate" hreflang="th" href={`${siteUrl}${getLocalizedPath(Astro.url.pathname, 'th')}`} />
  <link rel="alternate" hreflang="en" href={`${siteUrl}${getLocalizedPath(Astro.url.pathname, 'en')}`} />
  <link rel="alternate" hreflang="x-default" href={`${siteUrl}${getLocalizedPath(Astro.url.pathname, 'th')}`} />
  
  <!-- Favicon -->
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/icons/icon-192x192.png" />
  
  <!-- PWA Manifest -->
  <link rel="manifest" href="/manifest.json" />
  <meta name="theme-color" content="#FF5A36" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="default" />
  <meta name="apple-mobile-web-app-title" content="DealDoor" />
  
  <!-- Performance: DNS Prefetch -->
  <link rel="dns-prefetch" href="//dealdoor.co" />
  
  <!-- Theme Script (prevent flash) - must be inline -->
  <script is:inline>
    (function() {
      const theme = localStorage.getItem('theme') || 'system';
      const root = document.documentElement;
      
      if (theme === 'system') {
        const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        root.classList.toggle('dark', systemDark);
      } else {
        root.classList.toggle('dark', theme === 'dark');
      }
    })();
  </script>
  
  <meta name="theme-color" content="#FF5A36" />
  <meta name="color-scheme" content="light dark" />
  <slot name="head" />
</head>
<body class="selection:bg-primary/20 selection:text-primary">
  <!-- Skip Link -->
  <a href="#main-content" class="skip-link">
    {lang === 'th' ? 'ข้ามไปยังเนื้อหา' : 'Skip to content'}
  </a>
  
  <!-- Floating Glass Navbar Header -->
  {!hideHeader && (
  <header class="sticky top-0 z-[1200] transition-all duration-300">
    <div class="mx-auto max-w-4xl px-4 py-3">
      <nav class="glass rounded-2xl px-6 py-3 flex items-center justify-between shadow-lg shadow-secondary/5 border border-border/40">
        <a href={localizedPath('/')} class="flex items-center gap-2 group">
          <div class="h-9 w-9 flex items-center justify-center transform group-hover:scale-105 transition-transform duration-200 overflow-hidden">
            <img src="/icons/DealDoor_icon.png" alt="DealDoor Logo" class="h-full w-full object-contain" />
          </div>
          <span class="text-gradient-gray text-xl font-bold tracking-tight">
            DealDoor
          </span>
        </a>
        
        {/* Desktop Navigation */}
        <div class="hidden md:flex items-center gap-1">
          <a href={localizedPath('/deals')} class="rounded-xl px-4 py-2 text-sm font-semibold text-text-secondary hover:text-primary hover:bg-bg-secondary transition-all">
            {common('nav.explore')}
          </a>
          <a href={localizedPath('/for-shops')} class="rounded-xl px-4 py-2 text-sm font-semibold text-text-secondary hover:text-primary hover:bg-bg-secondary transition-all">
            {common('nav.forShops')}
          </a>
          <a href={localizedPath('/pricing')} class="rounded-xl px-4 py-2 text-sm font-semibold text-text-secondary hover:text-primary hover:bg-bg-secondary transition-all">
            {common('nav.pricing')}
          </a>
          {/* Settings Dropdown Container */}
          <div class="relative inline-block text-left" id="settings-dropdown-container">
            <button
              id="dropdown-settings-btn"
              class="h-11 w-11 rounded-xl flex items-center justify-center text-text-secondary hover:bg-bg-secondary transition-all cursor-pointer h-11"
              aria-expanded="false"
              aria-haspopup="true"
              aria-label={lang === 'en' ? 'Settings' : 'การตั้งค่า'}
            >
              <svg class="h-4.5 w-4.5 text-text-secondary flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </button>

            {/* Settings Dropdown Menu */}
            <div
              id="settings-dropdown-menu"
              class="fixed w-56 origin-top-right rounded-2xl border border-border/50 bg-card-bg/95 backdrop-blur-md shadow-xl ring-1 ring-black/5 focus:outline-none transition-all duration-200 transform scale-95 opacity-0 pointer-events-none z-[2147483647] p-2"
              role="menu"
              aria-orientation="vertical"
              aria-labelledby="dropdown-settings-btn"
            >
              {/* Header Section inside Settings Dropdown */}
              <div class="px-3 py-1.5 border-b border-border/30 mb-1.5">
                <p class="text-[10px] text-text-tertiary font-bold uppercase tracking-wider">{lang === 'th' ? 'การตั้งค่า' : 'Settings'}</p>
              </div>

              {/* Language Selector Option */}
              <a
                href={getLocalizedPath(Astro.url.pathname, alternateLanguage)}
                class="flex items-center justify-between rounded-xl px-3 py-2.5 text-xs font-semibold text-text-secondary hover:text-primary hover:bg-primary/5 transition-all duration-200"
                role="menuitem"
              >
                <div class="flex items-center gap-3">
                  <svg class="h-4 w-4 text-text-tertiary flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
                  </svg>
                  <span>{lang === 'th' ? 'เปลี่ยนภาษา' : 'Change Language'}</span>
                </div>
                <span class="rounded-md bg-bg-secondary px-1.5 py-0.5 text-[9px] font-black text-text-secondary border border-border/40">
                  {alternateLanguage.toUpperCase()}
                </span>
              </a>

              <div class="border-t border-border/30 my-1"></div>

              {/* Theme Toggle Option */}
              <div class="px-3 py-2" role="menuitem">
                <div class="flex items-center gap-3 mb-2">
                  <svg class="h-4 w-4 text-text-tertiary flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
                  </svg>
                  <span class="text-xs font-semibold text-text-secondary">{lang === 'th' ? 'เปลี่ยนธีม' : 'Theme'}</span>
                </div>
                <div class="flex justify-center">
                  <ThemeToggle />
                </div>
              </div>
            </div>
          </div>
          
          {user && <NotificationBell client:load />}
          
          <div class="h-5 w-[1px] bg-border mx-2"></div>
          
          {user ? (
            <div class="relative inline-block text-left" id="user-dropdown-container">
              <button
                id="dropdown-avatar-btn"
                class="flex items-center gap-3 rounded-2xl bg-bg-secondary border border-border/40 pl-2 pr-3 py-1.5 hover:bg-bg-tertiary transition-all duration-200 cursor-pointer h-11"
                aria-expanded="false"
                aria-haspopup="true"
              >
                <div class="h-7.5 w-7.5 overflow-hidden rounded-full bg-gradient-to-br from-primary to-orange-400 text-xs font-extrabold text-white shadow-sm flex-shrink-0">
                  {profileAvatar ? <img src={profileAvatar} alt={profileName} class="h-full w-full bg-white object-contain" /> : <span class="flex h-full w-full items-center justify-center">{profileName.charAt(0).toUpperCase()}</span>}
                </div>
                <div class="text-left hidden lg:flex flex-col justify-center leading-none">
                  <span class="text-xs font-bold text-secondary truncate max-w-[100px] leading-tight">{profileName}</span>
                  <span class:list={["mt-0.5 w-fit rounded-full px-1.5 py-0.5 text-[8px] font-black uppercase tracking-wide", profileTier === 'Pro' ? 'bg-primary/10 text-primary' : profileTier === 'Admin' ? 'bg-secondary text-white' : 'bg-bg-tertiary text-text-secondary']}>{profileTier}</span>
                </div>
                <svg class="h-3.5 w-3.5 text-text-secondary flex-shrink-0 ml-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              
              {/* Dropdown Menu */}
              <div
                id="user-dropdown-menu"
                class="fixed right-[max(1rem,calc((100vw-56rem)/2+1rem))] top-[76px] w-64 origin-top-right rounded-2xl border border-border/50 bg-card-bg/95 backdrop-blur-md shadow-xl ring-1 ring-black/5 focus:outline-none transition-all duration-200 transform scale-95 opacity-0 pointer-events-none z-[2147483647] p-2"
                role="menu"
                aria-orientation="vertical"
                aria-labelledby="dropdown-avatar-btn"
              >
                {/* Header Section inside Dropdown */}
                <div class="px-3.5 py-2.5 border-b border-border/30 mb-1.5">
                  <p class="text-[10px] text-text-tertiary leading-none">{common('account.signedInAs')}</p>
                  <p class="text-xs font-bold text-secondary truncate mt-1.5 leading-none">{profileName}</p>
                  <p class="mt-1 text-[10px] text-text-tertiary truncate">{user.email}</p>
                </div>
                
                <a
                  href="/dashboard"
                  class="flex items-center gap-3 rounded-xl px-3.5 py-2.5 text-xs font-semibold text-text-secondary hover:text-primary hover:bg-primary/5 transition-all duration-200 whitespace-nowrap"
                  role="menuitem"
                >
                  <svg class="h-4 w-4 text-text-tertiary flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                  </svg>
                  <span>{common('account.merchantDashboard')}</span>
                </a>
                
                <a
                  href="/saved"
                  class="flex items-center gap-3 rounded-xl px-3.5 py-2.5 text-xs font-semibold text-text-secondary hover:text-primary hover:bg-primary/5 transition-all duration-200 whitespace-nowrap"
                  role="menuitem"
                >
                  <svg class="h-4 w-4 text-text-tertiary flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                  </svg>
                  <span>{common('nav.saved')}</span>
                </a>
                
                <div class="border-t border-border/30 my-1"></div>
                
                <button
                  id="logout-btn"
                  class="w-full flex items-center gap-3 rounded-xl px-3.5 py-2.5 text-xs font-bold text-danger hover:bg-danger-bg/15 transition-all duration-200 text-left cursor-pointer whitespace-nowrap"
                  role="menuitem"
                >
                  <svg class="h-4 w-4 text-danger/80 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                  </svg>
                  <span>{common('action.logout')}</span>
                </button>
              </div>
            </div>
          ) : (
            <a href="/auth/login" class="btn btn-primary py-2 px-4 rounded-xl text-xs shadow-md min-h-[44px]">
              {common('action.login')}
            </a>
          )}
        </div>
  
        {/* Mobile Actions (Visible only on mobile: < md) */}
        <div class="flex md:hidden items-center gap-1.5">
          {user && <NotificationBell client:load />}
          
          <button
            id="mobile-menu-btn"
            class="h-11 w-11 rounded-xl flex items-center justify-center text-text-secondary hover:bg-bg-secondary transition-all cursor-pointer"
            aria-label={common('action.openMenu')}
            aria-expanded="false"
          >
            {/* Bento Icon for open menu trigger */}
            <svg id="menu-icon-open" class="h-5.5 w-5.5 text-text-secondary flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
            </svg>
            {/* Close Icon */}
            <svg id="menu-icon-close" class="h-5.5 w-5.5 hidden text-text-secondary flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </nav>
    </div>
  
    {/* Mobile Slide Drawer Menu */}
    <div id="mobile-menu" class="hidden md:hidden fixed inset-0 z-[999] bg-bg/80 backdrop-blur-xl animate-fade-in flex flex-col pt-6 px-6 pb-8 overflow-y-auto">
      <!-- 1. Top Header Bar inside Menu (Go back to Home / Close Option) -->
      <div class="flex items-center justify-between pb-4 border-b border-border/30">
        <!-- Logo (Go back to Home) -->
        <a href={localizedPath('/')} class="flex items-center gap-2 group">
          <div class="flex h-9 w-9 items-center justify-center">
            <img src="/icons/DealDoor_icon.png" alt="DealDoor" class="h-full w-full object-contain" />
          </div>
          <span class="text-xl font-bold tracking-tight bg-gradient-to-r from-text-primary to-text-secondary bg-clip-text text-transparent">
            DealDoor
          </span>
        </a>
        
        <!-- Close Button (X) -->
        <button
          id="mobile-menu-close-btn"
          class="h-11 w-11 rounded-xl flex items-center justify-center text-text-secondary hover:bg-bg-secondary transition-all cursor-pointer"
          aria-label={common('action.closeMenu')}
        >
          <svg class="h-5.5 w-5.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <div class="space-y-6 mt-6">
        {/* 1. Merchant Profile Card / Onboarding CTA */}
        {user ? (
          <div class="rounded-3xl border border-border/40 bg-card-bg/60 p-5 shadow-md flex items-center justify-between gap-4">
            <div class="flex items-center gap-3 min-w-0">
              <div class="h-11 w-11 overflow-hidden rounded-2xl bg-gradient-to-br from-primary to-orange-400 text-sm font-extrabold text-white shadow-sm flex-shrink-0">
                {profileAvatar ? <img src={profileAvatar} alt={profileName} class="h-full w-full bg-white object-contain" /> : <span class="flex h-full w-full items-center justify-center">{profileName.charAt(0).toUpperCase()}</span>}
              </div>
              <div class="min-w-0 leading-tight">
                <h4 class="text-xs font-bold text-secondary truncate">{profileName}</h4>
                <span class:list={["mt-1 inline-block rounded-md px-2 py-0.5 text-[9px] font-black tracking-wide", profileTier === 'Pro' ? 'bg-primary/10 text-primary' : profileTier === 'Admin' ? 'bg-secondary text-white' : 'bg-bg-tertiary text-text-secondary']}>{profileTier}</span>
              </div>
            </div>
            <a href="/dashboard" class="btn btn-primary py-2 px-3.5 rounded-xl text-xs font-bold shadow-sm whitespace-nowrap min-h-[40px] flex items-center justify-center">
              แดชบอร์ด
            </a>
          </div>
        ) : (
          <div class="rounded-3xl border border-border/40 bg-card-bg/60 p-5 shadow-md text-center space-y-3.5">
            <div>
              <h4 class="text-xs font-bold text-secondary">คุณเป็นเจ้าของร้านค้าใช่ไหม?</h4>
              <p class="text-[10px] text-text-secondary mt-1">สร้างหน้าโปรโมชันและจัดการดีลของร้านได้ฟรี</p>
            </div>
            <a href="/auth/login" class="btn btn-primary w-full py-2.5 rounded-xl text-xs font-bold shadow-sm min-h-[44px] flex items-center justify-center">
              เข้าสู่ระบบร้านค้า
            </a>
          </div>
        )}
        
        {/* 2. Navigation Grid Links */}
        <div class="grid grid-cols-2 gap-3.5">
          {/* Explore Card */}
          <a href={localizedPath('/deals')} class="rounded-2xl border border-border/30 bg-card-bg/30 p-4.5 flex flex-col justify-between min-h-[100px] hover:border-primary/30 transition-colors">
            <div class="h-9 w-9 rounded-xl bg-primary/10 text-primary flex items-center justify-center">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </div>
            <div>
              <p class="text-xs font-bold text-secondary">ค้นหาดีล</p>
              <p class="text-[9px] text-text-tertiary mt-0.5">ดีลรอบตัวคุณ</p>
            </div>
          </a>
          
           {/* For Shops Card */}
          <a href="/for-shops" class="rounded-2xl border border-border/30 bg-card-bg/30 p-4.5 flex flex-col justify-between min-h-[100px] hover:border-primary/30 transition-colors">
            <div class="h-9 w-9 rounded-xl bg-primary/10 text-primary flex items-center justify-center">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
              </svg>
            </div>
            <div>
              <p class="text-xs font-bold text-secondary">สำหรับร้านค้า</p>
              <p class="text-[9px] text-text-tertiary mt-0.5">เปิดร้านสร้างคูปองฟรี</p>
            </div>
          </a>

          {/* Pricing Card */}
          <a href="/pricing" class="rounded-2xl border border-border/30 bg-card-bg/30 p-4.5 flex flex-col justify-between min-h-[100px] hover:border-primary/30 transition-colors">
            <div class="h-9 w-9 rounded-xl bg-primary/10 text-primary flex items-center justify-center">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
              </svg>
            </div>
            <div>
              <p class="text-xs font-bold text-secondary">แพ็กเกจราคา</p>
              <p class="text-[9px] text-text-tertiary mt-0.5">ราคาประหยัด</p>
            </div>
          </a>
          
          {/* Saved Card */}
          <a href="/saved" class="rounded-2xl border border-border/30 bg-card-bg/30 p-4.5 flex flex-col justify-between min-h-[100px] hover:border-primary/30 transition-colors">
            <div class="h-9 w-9 rounded-xl bg-primary/10 text-primary flex items-center justify-center">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
              </svg>
            </div>
            <div>
              <p class="text-xs font-bold text-secondary">บันทึกไว้</p>
              <p class="text-[9px] text-text-tertiary mt-0.5">ดีลที่เซฟไว้</p>
            </div>
          </a>
        </div>

        {/* Theme Toggle Card */}
        <div class="rounded-2xl border border-border/30 bg-card-bg/30 p-4.5 flex items-center justify-between hover:border-primary/30 transition-colors">
          <div class="flex items-center gap-3">
            <div class="h-9 w-9 rounded-xl bg-primary/10 text-primary flex items-center justify-center flex-shrink-0">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
              </svg>
            </div>
            <div>
              <p class="text-xs font-bold text-secondary">เปลี่ยนธีม</p>
              <p class="text-[9px] text-text-tertiary mt-0.5">เลือกโหมดสีที่ต้องการ</p>
            </div>
          </div>
          <ThemeToggle />
        </div>

        {/* Language Switcher Card */}
        <a 
          href={getLocalizedPath(Astro.url.pathname, alternateLanguage)} 
          class="rounded-2xl border border-border/30 bg-card-bg/30 p-4.5 flex items-center justify-between hover:border-primary/30 transition-colors"
          aria-label={`${common('action.language')}: ${LANGUAGES[alternateLanguage].name}`}
        >
          <div class="flex items-center gap-3">
            <div class="h-9 w-9 rounded-xl bg-primary/10 text-primary flex items-center justify-center flex-shrink-0">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
              </svg>
            </div>
            <div>
              <p class="text-xs font-bold text-secondary">
                {lang === 'th' ? 'เปลี่ยนภาษา' : 'Change Language'}
              </p>
              <p class="text-[9px] text-text-tertiary mt-0.5">
                {lang === 'th' ? 'เลือกภาษาที่ต้องการ' : 'Choose your preferred language'}
              </p>
            </div>
          </div>
          <span class="flex h-8 min-w-8 items-center justify-center rounded-lg bg-bg-secondary px-2 text-xs font-black text-text-secondary border border-border/40">
            {alternateLanguage.toUpperCase()}

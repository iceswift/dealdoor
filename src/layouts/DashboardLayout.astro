---
// src/layouts/DashboardLayout.astro

import BaseLayout from './BaseLayout.astro';
import { getLangFromUrl, t } from '../i18n';
import NotificationBell from '../components/shared/NotificationBell.tsx';
import ThemeToggle from '../components/shared/ThemeToggle.astro';
import Icon from '../components/icons/index.astro';
import { getMerchantFromUser, getMerchantShop } from '../lib/auth';

interface Props {
  title: string;
  activeTab?: string;
  hideMobileNav?: boolean;
}

const { title, activeTab = 'shop', hideMobileNav = false } = Astro.props;
const lang = getLangFromUrl(Astro.url);

// ─── BACKEND WORKFLOW: SESSION CHECK ───
const user = Astro.locals.user;
// ───────────────────────────────────────

// ─── Resolve the merchant's tier for the sidebar badge ───
const merchant = user ? await getMerchantFromUser(user.id) : null;
const shop = merchant ? await getMerchantShop(merchant.id) : null;
const isPro = shop?.tier === 'pro';

const tabs = [
  { id: 'shop', label: 'ข้อมูลร้าน', href: '/dashboard', icon: 'shop' },
  { id: 'edit', label: 'แก้ไขร้าน', href: '/dashboard/edit', icon: 'pencil' },
  { id: 'deals', label: 'ดีล', href: '/dashboard/deals', icon: 'tag' },
  { id: 'analytics', label: 'วิเคราะห์', href: '/dashboard/analytics', icon: 'chart' },
  { id: 'preview', label: 'ดูตัวอย่าง', href: '/dashboard/preview', icon: 'eye' },
];
---

<BaseLayout title={`${title} | Dashboard`} hideHeader={true} hideFooter={true}>
  <div class="h-screen w-full flex flex-col lg:flex-row bg-bg overflow-hidden relative">
    
    {/* 1. Left Sidebar Navigation (Desktop only: lg) */}
    <aside class="hidden lg:flex flex-col justify-between w-64 xl:w-72 h-full bg-bg/40 backdrop-blur-xl border-r border-border/20 p-6 flex-shrink-0 z-20 shadow-2xl relative overflow-hidden">
      {/* Dynamic decorative backdrop blur blob for sidebar */}
      <div class="absolute -left-16 -top-16 h-36 w-36 rounded-full bg-primary/3 blur-2xl pointer-events-none"></div>
      
      <div class="space-y-8 relative z-10">
        <a href="/" class="flex items-center gap-3 group px-2 py-1">
          <div class="h-10 w-10 flex items-center justify-center transform group-hover:scale-105 transition-all duration-300 overflow-hidden">
            <img src="/icons/DealDoor_icon.png" alt="DealDoor Logo" class="h-full w-full object-contain" />
          </div>
          <div class="flex flex-col">
            <span class="text-lg font-black tracking-tight bg-gradient-to-r from-text-primary to-text-secondary bg-clip-text text-transparent group-hover:text-primary transition-colors duration-200">
              DealDoor
            </span>
            <span class="text-[9px] font-bold text-text-tertiary tracking-widest uppercase -mt-0.5">
              Merchant Panel
            </span>
          </div>
        </a>

        {/* Merchant Summary Card */}
        {user && (
          <div class="rounded-2xl border border-border/30 bg-bg/80 backdrop-blur-md p-4 shadow-md flex items-center gap-3.5 relative overflow-hidden group/card hover:border-primary/20 transition-all duration-300">
            {/* Soft decorative background glow inside the card */}
            <div class="absolute -right-6 -bottom-6 h-16 w-16 rounded-full bg-primary/5 blur-xl group-hover/card:bg-primary/10 transition-colors duration-300"></div>
            
            {/* Avatar Circle with Ring */}
            <div class="h-11 w-11 rounded-full bg-gradient-to-br from-primary to-orange-400 p-0.5 shadow-md shadow-primary/10 flex-shrink-0">
              <div class="h-full w-full rounded-full bg-bg flex items-center justify-center font-black text-sm text-primary">
                {user.name.charAt(0).toUpperCase()}
              </div>
            </div>
            
            <div class="min-w-0 leading-tight">
              <p class="text-xs font-black text-secondary truncate">{user.name}</p>
              {isPro ? (
                <span class="inline-block mt-1.5 rounded-lg bg-gradient-to-r from-primary to-orange-500 px-2 py-0.5 text-[8px] font-extrabold text-white shadow-sm shadow-primary/15 tracking-wide">
                  PRO MERCHANT
                </span>
              ) : (
                <span class="inline-block mt-1.5 rounded-lg bg-bg-secondary border border-border/40 px-2 py-0.5 text-[8px] font-extrabold text-text-secondary tracking-wide">
                  FREE MERCHANT
                </span>
              )}
            </div>
          </div>
        )}

        {/* Sidebar Nav Links */}
        <nav class="space-y-2">
          {tabs.map(tab => (
            <a
              href={tab.href}
              class:list={[
                'flex items-center gap-3.5 rounded-2xl px-4 py-3 text-xs font-bold transition-all duration-200 border transform',
                activeTab === tab.id
                  ? 'bg-gradient-to-r from-primary to-orange-500 text-white shadow-lg shadow-primary/25 border-primary/20 translate-x-1'
                  : 'text-text-secondary hover:text-primary hover:bg-primary/5 hover:translate-x-1.5 border-transparent',
              ]}
            >
              <Icon name={tab.icon} class="h-5 w-5 flex-shrink-0" />
              <span>{tab.label}</span>
            </a>
          ))}
        </nav>
      </div>

      {/* Sidebar Footer Controls */}
      <div class="pt-5 border-t border-border/30 space-y-5 relative z-10">
        <div class="rounded-2xl bg-bg/40 border border-border/20 p-3 flex items-center justify-between shadow-sm">
          <span class="text-[10px] font-black text-text-tertiary uppercase tracking-wider pl-1">โหมดใช้งาน</span>
          <div class="flex items-center gap-2">
            <ThemeToggle />
            <NotificationBell client:load userId={user?.id} />
          </div>
        </div>
        <button
          id="logout-btn-sidebar"
          class="w-full flex items-center justify-center gap-3.5 rounded-2xl py-3 px-4 text-xs font-black text-danger bg-danger-bg/10 border border-danger/10 hover:bg-danger-bg/20 transition-all duration-200 cursor-pointer"
        >
          <Icon name="logout" class="h-5 w-5 flex-shrink-0" />
          <span>ออกจากระบบร้านค้า</span>
        </button>
      </div>
    </aside>

    {/* 2. Top Header Navigation (Mobile only: < lg) */}
    <header class="lg:hidden sticky top-0 z-50 transition-all duration-300">
      <div class="mx-auto max-w-4xl px-4 py-3">
        <nav class="glass rounded-2xl px-5 py-2.5 flex items-center justify-between shadow-lg shadow-secondary/5 border border-border/40">
          <!-- Logo (Go back to Home) -->
          <a href="/" class="flex items-center gap-2 group">
            <div class="h-8 w-8 rounded-lg bg-gradient-to-br from-primary to-orange-400 flex items-center justify-center shadow-sm">
              <svg class="h-4.5 w-4.5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
              </svg>
            </div>
            <span class="text-base font-bold tracking-tight bg-gradient-to-r from-text-primary to-text-secondary bg-clip-text text-transparent">
              DealDoor
            </span>
          </a>
          
          <!-- Mobile Actions -->
          <div class="flex items-center gap-1.5">
            <ThemeToggle />
            <NotificationBell client:load userId={user?.id} />
            
            <button
              id="mobile-menu-btn"
              class="h-11 w-11 rounded-xl flex items-center justify-center text-text-secondary hover:bg-bg-secondary transition-all cursor-pointer"
              aria-label="เปิดเมนู"
              aria-expanded="false"
            >
              {/* Bento Icon for open menu trigger */}
              <svg id="menu-icon-open" class="h-5.5 w-5.5 text-text-secondary flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
              </svg>
              {/* Close Icon */}
              <svg id="menu-icon-close" class="h-5.5 w-5.5 hidden text-text-secondary flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </button>
          </div>
        </nav>
      </div>
    </header>

    {/* 3. Main Workspace Area */}
    <main class:list={[
      "flex-1 min-w-0 h-full bg-bg p-4 sm:p-6 lg:p-10 relative overflow-y-auto",
      hideMobileNav ? "pb-6" : "pb-24 lg:pb-10"
    ]}>
      {/* Dynamic Content slot */}
      <slot />
    </main>

    {/* 4. Bottom Tab Navigation (Mobile only: < lg) */}
    {!hideMobileNav && (
      <nav class="lg:hidden fixed bottom-4 inset-x-4 h-16 bg-bg/85 backdrop-blur-lg border border-border/40 z-30 flex items-center justify-around px-4 shadow-xl rounded-2xl">
        {tabs.map(tab => (
          <a
            href={tab.href}
            class:list={[
              'flex flex-col items-center justify-center gap-0.5 flex-1 py-1.5 transition-all duration-200 min-h-[44px] rounded-xl',
              activeTab === tab.id 
                ? 'text-primary scale-105' 
                : 'text-text-secondary hover:text-text-primary'
            ]}
          >
            <Icon name={tab.icon} class="h-5.5 w-5.5" />
            <span class="text-[9px] font-extrabold tracking-wide mt-0.5">{tab.label}</span>
            {activeTab === tab.id && (
              <span class="h-1 w-1 rounded-full bg-primary animate-pulse mt-0.5 flex-shrink-0"></span>
            )}
          </a>
        ))}
      </nav>
    )}
  </div>
</BaseLayout>

<script>
  // ─── BACKEND WORKFLOW: SIGN-OUT API TRIGGER ───
  const logoutBtnSidebar = document.getElementById('logout-btn-sidebar');
  const logoutBtnMobile = document.getElementById('logout-btn-mobile');
  
  async function performLogout() {
    if (!confirm('ยืนยันว่าต้องการออกจากระบบบัญชีผู้ค้า?')) return;
    
    try {
      await fetch('/api/auth/logout', { method: 'POST' });
      window.location.href = '/auth/login';
    } catch (err) {
      window.location.href = '/auth/login';
    }
  }

  logoutBtnSidebar?.addEventListener('click', performLogout);
  logoutBtnMobile?.addEventListener('click', performLogout);
  // ──────────────────────────────────────────────
</script>

---
// src/layouts/DashboardLayout.astro

import BaseLayout from './BaseLayout.astro';
import NotificationBell from '../components/shared/NotificationBell.tsx';
import ThemeToggle from '../components/shared/ThemeToggle.astro';
import Icon from '../components/icons/index.astro';
import { getDashboardContext } from '../lib/dashboard/server';

interface Props {
  title: string;
  activeTab?: string;
  hideMobileNav?: boolean;
}

const { title, activeTab = 'overview', hideMobileNav = false } = Astro.props;
const user = Astro.locals.user;
const context = await getDashboardContext(user);
const shop = context?.shop ?? null;
const isPro = shop?.tier === 'pro';

const tabs = [
  { id: 'overview', label: 'ภาพรวม', href: '/dashboard', icon: 'shop' },
  { id: 'edit', label: 'ร้านค้า', href: '/dashboard/edit', icon: 'pencil' },
  { id: 'deals', label: 'ดีล', href: '/dashboard/deals', icon: 'tag' },
  { id: 'menu', label: 'เมนู', href: '/dashboard/menu', icon: 'menu' },
  { id: 'analytics', label: 'สถิติ', href: '/dashboard/analytics', icon: 'chart' },
  { id: 'preview', label: 'พรีวิว', href: '/dashboard/preview', icon: 'eye' },
];
---

<BaseLayout title={`${title} | DealDoor Dashboard`} hideHeader={true} hideFooter={true}>
  <div class="h-screen w-full flex flex-col lg:flex-row bg-bg overflow-hidden">
    <aside class="hidden lg:flex w-72 shrink-0 flex-col justify-between border-r border-border/30 bg-bg/85 px-5 py-6 shadow-xl backdrop-blur-xl">
      <div class="space-y-6">
        <a href="/" class="flex items-center gap-3 rounded-2xl px-2 py-1.5 transition-colors hover:bg-bg-secondary/60">
          <img src="/icons/DealDoor_icon.png" alt="DealDoor" class="h-10 w-10 object-contain" />
          <div class="leading-tight">
            <p class="text-base font-black text-secondary">DealDoor</p>
            <p class="text-[10px] font-bold uppercase tracking-widest text-text-tertiary">Merchant Workspace</p>
          </div>
        </a>

        {user && (
          <section class="rounded-2xl border border-border/40 bg-card-bg/75 p-4 shadow-sm">
            <div class="flex items-center gap-3">
              <div class="flex h-11 w-11 items-center justify-center rounded-2xl bg-primary text-sm font-black text-white">
                {user.name.charAt(0).toUpperCase()}
              </div>
              <div class="min-w-0">
                <p class="truncate text-sm font-black text-secondary">{shop?.name || user.name}</p>
                <p class="truncate text-xs font-bold text-text-tertiary">{user.email}</p>
              </div>
            </div>
            <div class="mt-3 flex items-center justify-between gap-2">
              <span class:list={[
                'rounded-full px-2.5 py-1 text-[10px] font-black uppercase',
                isPro ? 'bg-primary text-white' : 'bg-bg-secondary text-text-secondary'
              ]}>
                {isPro ? 'Pro' : 'Free'}
              </span>
              {shop && (
                <a href={`/${shop.slug}`} class="text-xs font-black text-primary hover:underline">
                  ดูหน้าร้าน
                </a>
              )}
            </div>
          </section>
        )}

        <nav class="space-y-1.5">
          {tabs.map((tab) => (
            <a
              href={tab.href}
              class:list={[
                'flex min-h-[46px] items-center gap-3 rounded-2xl px-4 text-sm font-black transition-all',
                activeTab === tab.id
                  ? 'bg-primary text-white shadow-lg shadow-primary/20'
                  : 'text-text-secondary hover:bg-bg-secondary hover:text-secondary'
              ]}
            >
              <Icon name={tab.icon} class="h-5 w-5 shrink-0" />
              <span>{tab.label}</span>
            </a>
          ))}
        </nav>
      </div>

      <div class="space-y-3 border-t border-border/30 pt-4">
        <div class="flex items-center justify-between rounded-2xl border border-border/30 bg-bg-secondary/50 p-3">
          <span class="text-xs font-black text-text-tertiary">เครื่องมือ</span>
          <div class="flex items-center gap-2">
            <ThemeToggle />
            <NotificationBell client:load userId={user?.id} />
          </div>
        </div>
        <button
          id="logout-btn-sidebar"
          class="flex min-h-[44px] w-full items-center justify-center gap-2 rounded-2xl border border-danger/15 bg-danger-bg/15 px-4 text-sm font-black text-danger transition-colors hover:bg-danger-bg/25"
        >
          <Icon name="logout" class="h-5 w-5" />
          ออกจากระบบ
        </button>
      </div>
    </aside>

    <header class="lg:hidden sticky top-0 z-50 border-b border-border/30 bg-bg/85 px-4 py-3 backdrop-blur-xl">
      <div class="flex items-center justify-between">
        <a href="/dashboard" class="flex items-center gap-2">
          <img src="/icons/DealDoor_icon.png" alt="DealDoor" class="h-9 w-9 object-contain" />
          <div class="leading-tight">
            <p class="text-sm font-black text-secondary">DealDoor</p>
            <p class="text-[10px] font-bold text-text-tertiary">Dashboard</p>
          </div>
        </a>
        <div class="flex items-center gap-2">
          <ThemeToggle />
          <NotificationBell client:load userId={user?.id} />
          <button
            id="logout-btn-mobile"
            class="flex h-11 w-11 items-center justify-center rounded-xl text-text-secondary transition-colors hover:bg-bg-secondary"
            aria-label="ออกจากระบบ"
          >
            <Icon name="logout" class="h-5 w-5" />
          </button>
        </div>
      </div>
    </header>

    <main class:list={[
      'min-w-0 flex-1 overflow-y-auto bg-bg p-4 sm:p-6 lg:p-8',
      hideMobileNav ? 'pb-6' : 'pb-24 lg:pb-8'
    ]}>
      <div class="mx-auto w-full max-w-7xl">
        <slot />
      </div>
    </main>

    {!hideMobileNav && (
      <nav class="fixed bottom-4 inset-x-4 z-40 flex h-16 items-center justify-around rounded-2xl border border-border/40 bg-bg/90 px-3 shadow-xl backdrop-blur-xl lg:hidden">
        {tabs.map((tab) => (
          <a
            href={tab.href}
            class:list={[
              'flex min-h-[44px] flex-1 flex-col items-center justify-center gap-0.5 rounded-xl text-[10px] font-black transition-all',
              activeTab === tab.id ? 'text-primary' : 'text-text-tertiary hover:text-secondary'
            ]}
          >
            <Icon name={tab.icon} class="h-5 w-5" />
            <span>{tab.label}</span>
          </a>
        ))}
      </nav>
    )}
  </div>
</BaseLayout>

<script>
  const logoutButtons = [
    document.getElementById('logout-btn-sidebar'),
    document.getElementById('logout-btn-mobile'),
  ].filter(Boolean);

  async function performLogout() {
    const confirmed = window.confirm('ต้องการออกจากระบบร้านค้าใช่ไหม?');
    if (!confirmed) return;

    try {
      await fetch('/api/auth/logout', { method: 'POST' });
    } finally {
      window.location.href = '/auth/login';
    }
  }

  logoutButtons.forEach((button) => button?.addEventListener('click', performLogout));
</script>

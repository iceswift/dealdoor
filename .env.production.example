# DealDoor production env template for VPS + Docker + Caddy + Postgres + R2.
# Copy to `.env.production` on the VPS. Do not commit real secrets.

NODE_ENV=production
HOST=0.0.0.0
PORT=4321

SITE_DOMAIN=dealdoor.co
SITE_URL=https://dealdoor.co
PUBLIC_SITE_URL=https://dealdoor.co
CADDY_EMAIL=admin@dealdoor.co

POSTGRES_DB=dealdoor
POSTGRES_USER=dealdoor
POSTGRES_PASSWORD=replace-with-a-long-random-secret
DATABASE_URL=postgres://dealdoor:replace-with-a-long-random-secret@postgres:5432/dealdoor

STORAGE_DRIVER=r2
R2_ACCOUNT_ID=replace-with-r2-account-id
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_BUCKET_NAME=dealdoor-prod
R2_PUBLIC_BASE_URL=https://media.dealdoor.co

BACKUP_BUCKET_NAME=dealdoor-db-backups
BACKUP_RETENTION_DAYS=14
BACKUP_ENCRYPTION_KEY=replace-before-implementing-encrypted-backups

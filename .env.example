# DealDoor - Environment Variables

# ─── Server ──────────────────────────────────────────────
NODE_ENV=production
HOST=0.0.0.0
PORT=4321

# ─── Site ────────────────────────────────────────────────
SITE_URL=https://dealdoor.co
PUBLIC_SITE_URL=https://dealdoor.co

# ─── Database ────────────────────────────────────────────
DATABASE_URL=./db/prod.db

# ─── Authentication ──────────────────────────────────────
# Generate a random secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=your-secret-here

# ─── Image Upload ────────────────────────────────────────
UPLOAD_DIR=./public/uploads
MAX_FILE_SIZE=2097152

# ─── External Services (Future) ─────────────────────────
# PLAUSIBLE_DOMAIN=dealdoor.co
# SENTRY_DSN=
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_DOMAIN=
# LINE_CHANNEL_ACCESS_TOKEN=
# LINE_WEBHOOK_URL=

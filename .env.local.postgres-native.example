# DealDoor local development with native Postgres installed on the laptop.
# Copy values into your PowerShell session or local env manager.

NODE_ENV=development
DB_DRIVER=postgres
DATABASE_URL=postgres://dealdoor:dealdoor@localhost:5432/dealdoor

# Run:
# bun run db:migrate:pg
# bun run db:export:sqlite
# bun run db:import:pg:truncate
# bun run dev
